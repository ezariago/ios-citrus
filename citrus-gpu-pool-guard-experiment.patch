+/* Caller holds gpu_pool_lock. Return gpu_pool_count on a miss. */
+static unsigned
+gpu_pool_choose(uint64_t rounded)
+{
+    if (!gpu_pool_guard) {
+        for (unsigned i = 0; i < gpu_pool_count; i++) {
+            if (!gpu_pool_blocks[i].used && gpu_pool_blocks[i].size >= rounded) { return i; }
+        }
+        return gpu_pool_count;
+    }
+    const uint64_t big = 10ull << 20, small = 8ull << 20;
+    unsigned available_big = 0, best = gpu_pool_count;
+    for (unsigned i = 0; i < gpu_pool_count; i++) {
+        if (!gpu_pool_blocks[i].used && gpu_pool_blocks[i].size >= big) { available_big++; }
+    }
+    for (unsigned i = 0; i < gpu_pool_count; i++) {
+        const struct gpu_pool_block *b = &gpu_pool_blocks[i];
+        if (b->used || b->size < rounded) { continue; }
+        /* At a full block table allocation consumes the whole block. */
+        uint64_t remain = gpu_pool_count < GPU_POOL_MAX_BLOCKS ? b->size - rounded : 0;
+        if (rounded < small && available_big == 1 && b->size >= big && remain < big) { continue; }
+        if (best == gpu_pool_count || b->size < gpu_pool_blocks[best].size) { best = i; }
+    }
+    return best;
+}
