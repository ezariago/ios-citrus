+/* Only the allocating client's completed pool-backed cache is eligible. Never
+ * reclaim fLeft (which may still be busy), active handles, other clients, or
+ * low-memory allocations. Holding gGPULock serializes cache reuse/destruction;
+ * dropKept already uses the same lock order (gGPULock -> pool lock). */
+uint64_t
+RedwoodGPUUserClient::reclaimPool(uint64_t size, void **va)
+{
+	uint64_t pa = 0, released = 0;
+	uint32_t n = 0;
+	IOLockLock(gGPULock);
+	for (;;) {
+		struct gpu_kept *oldest = NULL;
+		for (uint32_t i = 0; i < GPU_KEPT; i++) {
+			struct gpu_kept *k = &fKept[i];
+			if (k->memory != NULL && topaz_gpu_pool_owns(k->address) &&
+			    (oldest == NULL || k->since < oldest->since)) { oldest = k; }
+		}
+		if (oldest == NULL) { break; }
+		released += oldest->size;
+		dropKept(oldest);
+		n++;
+		pa = topaz_gpu_pool_alloc(size, va);
+		if (pa != 0) { break; }
+	}
+	IOLockUnlock(gGPULock);
+	/* Sparse diagnostic: do not print on every allocation failure. */
+	static uint32_t calls;
+	uint32_t count = __atomic_add_fetch(&calls, 1, __ATOMIC_RELAXED);
+	if (count == 1 || (count & 63) == 0) {
+		IOLog("CitrusGPU reclaim: attempts=%u dropped=%u bytes=%llu result=%s\n",
+		    count, n, released, pa ? "pool" : "miss");
+	}
+	return pa;
 }
 
