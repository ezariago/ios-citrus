 		fb->flipBack();
 	}
 	if (rec != NULL) {
+		if (sweet_fb_serial_lock != NULL) {
+			IOLockLock(sweet_fb_serial_lock);
+		}
 		if (__atomic_fetch_add(&fb_present_active, 1, __ATOMIC_RELAXED) != 0) {
 			__atomic_fetch_add(&fb_present_overlap, 1, __ATOMIC_RELAXED);
 		}
@@ -826,6 +836,9 @@
