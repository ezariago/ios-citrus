@@ -52,6 +52,8 @@
  * reads the u64 at +0x18 of the shared state page; held from SwapEnd until
  * one vsync after the next frame replaced it on the panel.
  */
+/* Opt-in experiment: serializes present + hold transitions, not FIFO ordering. */
+static IOLock *sweet_fb_serial_lock;
 static uint32_t sweet_touch_lat;
 static int sweet_fb_scaler_log;
 static int sweet_fb_noscale;	/* fbnoscale=1: fetch the small buffer with no scaler (A/B) */                 /* fbdump=1: log the scaler programming */
@@ -671,6 +673,11 @@
 	uint32_t lock = 0;
 	fVLock = PE_parse_boot_argn("sweetfb_lock", &lock, sizeof(lock)) && lock != 0 && fIntf1 != NULL && fVTotal > 100;
