+		sweet_fb_serial_lock = IOLockAlloc();
+		IOLog("SWEET FB: experimental present serialization %s\n", sweet_fb_serial_lock ? "enabled" : "allocation failed");
+	}
 	IOLog("SWEET FB: vsync %s the panel (%u lines a frame)\n", fVLock ? "follows" : "does not follow", fVTotal);
