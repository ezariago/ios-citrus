+/* Match cs_validate_hash's blob selection before it reads the hash unit. */
+static boolean_t
+citrus_cs_hash_fits_range(struct cs_blob *blobs, memory_object_offset_t page_offset,
+    vm_size_t available)
+{
+	for (struct cs_blob *blob = blobs; blob != NULL; blob = blob->csb_next) {
+		off_t offset = page_offset - blob->csb_base_offset;
+		if (offset < blob->csb_start_offset || offset >= blob->csb_end_offset ||
+		    blob->csb_mem_kaddr == 0 || blob->csb_cd == NULL) {
+			continue;
+		}
+		/* cs_validate_hash computes its size with a 32-bit shift. */
+		if (blob->csb_hash_pageshift >= 32) {
+			return FALSE;
+		}
+		uint64_t unit = 1ULL << blob->csb_hash_pageshift;
+		return ((uint64_t)offset & (unit - 1)) == 0 && unit <= available;
+	}
+	/* No matching signature: leave the original no-hash handling intact. */
+	return TRUE;
