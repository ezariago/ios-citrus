+/* Poll a GDSC/branch until it reports the expected state. */
+static bool
+sweet_usb_gdsc_on(vm_offset_t gcc)
+{
+	uint32_t v = usb_rd(gcc, GCC_USB30_PRIM_GDSCR);
+	if (!(v & GDSCR_PWR_ON)) {
+		*(volatile uint32_t *)(gcc + GCC_USB30_PRIM_GDSCR) = v & ~GDSCR_SW_COLLAPSE;
+		__asm__ volatile ("dsb sy" ::: "memory");
+		for (int i = 0; i < 200; i++) {
+			if (usb_rd(gcc, GCC_USB30_PRIM_GDSCR) & GDSCR_PWR_ON) {
+				break;
 			}
+			delay(100);
 		}
 	}
+	return (usb_rd(gcc, GCC_USB30_PRIM_GDSCR) & GDSCR_PWR_ON) != 0;
 }
 
+/* Turn on the USB30_PRIM power domain, its clocks and the AHB2PHY block. */
+static bool
+sweet_usb_power_on(vm_offset_t gcc)
+{
+	bool ok = true;
+
+	ok = sweet_usb_gdsc_on(gcc);
+	printf("SWEET USB: GDSC on -> 0x%08x (%s)\n", usb_rd(gcc, GCC_USB30_PRIM_GDSCR),
+	    ok ? "on" : "STILL OFF");
+
+	/* The QUSB2 PHY sits behind the USB AHB2PHY block: clock + reset first. */
+	sweet_usb_clk_set(gcc, 0x1d008, true);
+	*(volatile uint32_t *)(gcc + GCC_USB_PHY_CFG_AHB2PHY_BCR) = 0;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	delay(100);
+
+	for (unsigned i = 0; i < sizeof(usb_cbcr) / sizeof(usb_cbcr[0]); i++) {
+		sweet_usb_clk_set(gcc, usb_cbcr[i].off, true);
+	}
+	delay(100);
+	for (unsigned i = 0; i < sizeof(usb_cbcr) / sizeof(usb_cbcr[0]); i++) {
+		printf("SWEET USB: clk %-16s now 0x%08x (%s)\n", usb_cbcr[i].name,
+		    usb_rd(gcc, usb_cbcr[i].off),
+		    sweet_usb_clk_on(gcc, usb_cbcr[i].off) ? "on" : "OFF");
+	}
+
+	/* Pulse the controller reset now that its clocks are running. */
+	*(volatile uint32_t *)(gcc + GCC_USB30_PRIM_BCR) = 1;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	delay(100);
+	*(volatile uint32_t *)(gcc + GCC_USB30_PRIM_BCR) = 0;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	delay(100);
