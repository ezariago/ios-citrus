+		    ns / 1000000000ull, os_atomic_load(&sweet_svc_runs, relaxed),
+		    os_atomic_load(&sweet_ufs_users, relaxed),
+		    os_atomic_load(&sweet_other_bytes, relaxed),
+		    (uint64_t)sweet_intr_pc);
