+/*
+ * Make the UFS power domain and its clock branches unconditionally on.
+ *  - GDSCR: clear SW_COLLAPSE (request off), HW_CONTROL (let the hardware
+ *    collapse it) and SW_OVERRIDE; this is what Linux's gdsc_init does for a
+ *    software-controlled domain. Wait for PWR_ON.
+ *  - CBCR: set CLK_ENABLE, clear HWCG so the branch cannot be auto-gated.
+ * Every write is a read-modify-write of only those bits; already-correct
+ * registers are left untouched, so a healthy boot sees zero changes.
+ */
+static void
+sweet_ufs_gcc_force(bool first)
+{
+	uint32_t v, want, bad, changed = 0;
+	bool collapsed = false;
+
+	if (!sweet_gcc_mapped || sweet_ufs_clk_mode == 0) {
+		return;
+	}
+	sweet_ufs_gcc_read_state();
+
+	v = sweet_gcc_state.gdsc;
+	bad = GDSCR_SW_COLLAPSE | GDSCR_HW_CONTROL | GDSCR_SW_OVERRIDE;
+	if ((v & bad) || !(v & GDSCR_PWR_ON)) {
+		collapsed = !(v & GDSCR_PWR_ON);
+		if (collapsed) {
+			sweet_gcc_state.collapse_count++;
+		}
+		gcc_wr(GCC_UFS_PHY_GDSCR, v & ~bad);
+		for (int i = 0; i < 100; i++) {
+			if (gcc_rd(GCC_UFS_PHY_GDSCR) & GDSCR_PWR_ON) {
+				break;
+			}
+			delay(1);
+		}
+		changed++;
+	}
+
+	if (sweet_ufs_clk_mode == 1) {
+		for (unsigned i = 0; i < sizeof(ufs_cbcr) / sizeof(ufs_cbcr[0]); i++) {
+			v = gcc_rd(ufs_cbcr[i].off);
+			want = (v | CBCR_CLK_ENABLE) & ~CBCR_HWCG;
+			if (v != want) {
+				gcc_wr(ufs_cbcr[i].off, want);
+				changed++;
+			}
+		}
+	}
+
+	sweet_ufs_gcc_read_state();
+	if (changed) {
+		os_atomic_inc(&sweet_gcc_changes, relaxed);
+		sweet_ufs_log("SWEET UFS: GCC forced on (%u writes)%s: gdsc 0x%08x ahb 0x%08x axi 0x%08x unipro 0x%08x noc 0x%08x clkref 0x%08x\n",
+		    changed, collapsed ? " [domain was COLLAPSED]" : "",
+		    sweet_gcc_state.gdsc, sweet_gcc_state.ahb, sweet_gcc_state.axi,
+		    sweet_gcc_state.unipro, sweet_gcc_state.noc, sweet_gcc_state.clkref);
+	} else if (first) {
+		printf("SWEET UFS: GCC ufs domain already on: gdsc 0x%08x ahb 0x%08x axi 0x%08x unipro 0x%08x noc 0x%08x clkref 0x%08x\n",
+		    sweet_gcc_state.gdsc, sweet_gcc_state.ahb, sweet_gcc_state.axi,
+		    sweet_gcc_state.unipro, sweet_gcc_state.noc, sweet_gcc_state.clkref);
+	}
+}
