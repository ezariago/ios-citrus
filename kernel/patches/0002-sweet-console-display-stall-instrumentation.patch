+/*
+ * Number of 32-bit words that may safely be read from kernelAddress().
+ *
+ * width*height is NOT the buffer size: a 2-bytes-per-pixel surface (e.g. the
+ * 312x202 LA08 surface SpringBoard creates) has width*height*bpe bytes, so a
+ * scan of width*height *uint32_t* runs to twice the end of its allocation and
+ * takes a kernel data abort inside present(). Use the real allocation length
+ * (set by the create ioctl from the descriptor, or rounded row*height for the
+ * physical panel surface) and fall back to the row geometry.
+ */
+static uint32_t
+sweet_surface_word_limit(SweetSurface *s)
+{
+	uint64_t words = (uint64_t)s->allocSize / sizeof(uint32_t);
+
+	if (words == 0) {
+		words = (uint64_t)s->bytesPerRow * s->height / sizeof(uint32_t);
+	}
+	uint64_t pixels = (uint64_t)s->width * s->height;
+	if (words > pixels) {
+		words = pixels;
+	}
+	return (uint32_t)MIN(words, 0xffffffffull);
+}
+
+static uint32_t
+sweet_surface_rgb_nz(SweetSurface *s)
+{
+	uintptr_t va = s->kernelAddress();
+	if (va == 0) {
+		return 0;
+	}
+	const uint32_t *q = (const uint32_t *)va;
+	uint32_t tot = sweet_surface_word_limit(s), nz = 0;
+	for (uint32_t k = 0; k < tot; k += 97) {
+		nz += (q[k] & 0x00ffffffu) != 0;
+	}
+	return nz;
+}
