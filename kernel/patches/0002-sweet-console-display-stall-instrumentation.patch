+static bool
+sweet_usb_qusb2_init(vm_offset_t gcc)
+{
+	vm_offset_t phy = ml_io_map(QUSB2_PA, QUSB2_SIZE);
+	if (phy == 0) {
+		printf("SWEET USB: QUSB2 map failed\n");
+		return false;
+	}
+	*(volatile uint32_t *)(gcc + GCC_QUSB2PHY_PRIM_BCR) = 1;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	delay(100);
+	*(volatile uint32_t *)(gcc + GCC_QUSB2PHY_PRIM_BCR) = 0;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	delay(100);
+	printf("SWEET USB: QUSB2 reset released, PLL_TEST 0x%02x PWRDN 0x%02x STATUS 0x%02x\n",
+	    usb_rd(phy, Q2_PLL_TEST), usb_rd(phy, Q2_POWERDOWN), usb_rd(phy, Q2_PLL_STATUS));
+
+	*(volatile uint32_t *)(phy + Q2_POWERDOWN) = usb_rd(phy, Q2_POWERDOWN) |
+	    Q2_CLAMP_N_EN | Q2_FREEZIO_N | Q2_POWER_DOWN;
+	for (unsigned i = 0; i < sizeof(qusb2_init_seq) / sizeof(qusb2_init_seq[0]); i++) {
+		*(volatile uint32_t *)(phy + qusb2_init_seq[i][1]) = qusb2_init_seq[i][0];
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	*(volatile uint32_t *)(phy + Q2_POWERDOWN) =
+	    usb_rd(phy, Q2_POWERDOWN) & ~Q2_POWER_DOWN;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	delay(200);
+	/* Single-ended (cmos) reference clock: sm6115_phy_cfg.se_clk_scheme_default */
+	*(volatile uint32_t *)(phy + Q2_PLL_TEST) = 0x80;
+	__asm__ volatile ("dsb sy" ::: "memory");
+
+	uint32_t status = 0;
+	for (int i = 0; i < 100; i++) {
+		status = usb_rd(phy, Q2_PLL_STATUS);
+		if (status & Q2_PLL_LOCKED) {
+			break;
+		}
+		delay(100);
+	}
+	printf("SWEET USB: QUSB2 PLL status 0x%02x (%s) PWRDN 0x%02x TUNE1 0x%02x\n",
+	    status, (status & Q2_PLL_LOCKED) ? "locked" : "NOT LOCKED",
+	    usb_rd(phy, Q2_POWERDOWN), usb_rd(phy, Q2_TUNE1));
+	return (status & Q2_PLL_LOCKED) != 0;
+}
