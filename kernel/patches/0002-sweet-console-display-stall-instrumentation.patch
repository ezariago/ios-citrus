+ * Panic persistence. panic_trap_to_debugger() calls sweet_early_panic() before
+ * anything is printed to the normal console, and with no USB serial reader a
+ * panic otherwise vanishes on reset. Store the text in one dedicated block just
+ * below the 16 stall-sample blocks, through the same polled slot-1 writer the
+ * interrupt recorder uses. On a UFS wedge the store simply fails.
+ */
+int sweet_panic_store(const char *text, unsigned int len);
+
+int
+sweet_panic_store(const char *text, unsigned int len)
+{
+	void *diag;
+
+	if (!su.ready || su.dma == 0 || sweet_hb_base == 0 || text == NULL || len == 0) {
+		return -1;
+	}
+	diag = (void *)(su.dma + DMA_DIAG_BOUNCE);
+	bzero(diag, DMA_DIAG_BLOCK);
+	memcpy(diag, text, MIN(len, (unsigned int)DMA_DIAG_BLOCK));
+	/* 16 = SWEET_STALL_SLOTS, which is defined further down. */
+	return ufs_diag_write_block(sweet_hb_base - 1 - 16 - 1);
+}
+
+/*
+ * SMP observer persistence (osfmk/arm64/cpu.c). One fixed block just above the
+ * 16 rotating stall samples and the panic block, so a reset cannot erase the
+ * cross-core capture. The slot-1 polled writer refuses while a normal UFS
+ * request is in flight, and the observer only calls this after CPU0 has
+ * stopped taking timer interrupts for two seconds.
+ */
+int sweet_obs_persist(const void *data, int len);
+
+int
+sweet_obs_persist(const void *data, int len)
+{
+	if (!su.ready || su.dma == 0 || sweet_hb_base == 0 || data == NULL ||
+	    len <= 0 || len > (int)DMA_DIAG_BLOCK) {
+		return -1;
+	}
+	void *diag = (void *)(su.dma + DMA_DIAG_BOUNCE);
+	bzero(diag, DMA_DIAG_BLOCK);
+	memcpy(diag, data, (size_t)len);
+	/* 16 = SWEET_STALL_SLOTS; this block is the one below the panic block. */
+	return ufs_diag_write_block(sweet_hb_base - 1 - 16);
+}
+
 static void
+sweet_hb_write(uint32_t phase, bool try_only)
+{
+	static uint64_t seq;
+	void *bounce = (void *)(su.dma + DMA_BOUNCE);
+
+	sweet_irq_stats.ptimer_ctl = __builtin_arm_rsr64("cntp_ctl_el0");
+	sweet_irq_stats.ptimer_tval = __builtin_arm_rsr64("cntp_tval_el0");
+	sweet_irq_stats.ptimer_frq = __builtin_arm_rsr64("cntfrq_el0");
+	struct sweet_heartbeat hb = {
+		.magic = { 'S', 'W', 'E', 'E', 'T', 'H', 'B', '1' },
+		.version = SWEET_HB_VERSION,
+		.phase = phase,
+		.boot_id = sweet_hb_prev.boot_id,
+		.seq = ++seq,
+		.console_bytes = os_atomic_load(&sweet_log_total, relaxed),
+		.console_seq = os_atomic_load(&sweet_console_seq, relaxed),
+		.ufs_ios = os_atomic_load(&sweet_ufs_ios, relaxed),
+		.flush_runs = os_atomic_load(&sweet_flush_runs, relaxed),
+		.free_pages = vm_page_free_count,
+		.wire_pages = vm_page_wire_count,
+		.svc_runs = os_atomic_load(&sweet_svc_runs, relaxed),
+		.panel_runs = os_atomic_load(&sweet_panel_runs, relaxed),
+		.intr_pc = sweet_intr_pc,
+		.ufs_users = os_atomic_load(&sweet_ufs_users, relaxed),
+		.irq = sweet_irq_stats,
+		.gcc_changes = os_atomic_load(&sweet_gcc_changes, relaxed),
+		.gcc_gdsc = sweet_gcc_state.gdsc,
+		.gcc_axi = sweet_gcc_state.axi,
+		.gcc_ahb = sweet_gcc_state.ahb,
+		.gcc_unipro = sweet_gcc_state.unipro,
+		.gcc_noc = sweet_gcc_state.noc,
+		.gcc_clkref = sweet_gcc_state.clkref,
+		.gcc_collapses = sweet_gcc_state.collapse_count,
+		.hc_hce = sweet_hc_state.hce,
+		.hc_hcs = sweet_hc_state.hcs,
+		.hc_is = sweet_hc_state.is,
+		.hc_utrldbr = sweet_hc_state.utrldbr,
+		.hc_utrlrsr = sweet_hc_state.utrlrsr,
+		.hc_seq = sweet_hc_state.seq,
+	};
+	uint64_t ns;
+	absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+	hb.uptime_s = ns / 1000000000ULL;
+	hb.prev_boot_id = sweet_hb_prev.prev_boot_id;
+	hb.prev_phase = sweet_hb_prev.prev_phase;
+	hb.prev_uptime_s = sweet_hb_prev.prev_uptime_s;
+	hb.prev_console_bytes = sweet_hb_prev.prev_console_bytes;
+	hb.prev_console_seq = sweet_hb_prev.prev_console_seq;
+	hb.prev_ufs_ios = sweet_hb_prev.prev_ufs_ios;
+	hb.prev_flush_runs = sweet_hb_prev.prev_flush_runs;
+
+	/* A stalled UFS must not stop the watchdog from panicking: try only. */
+	if (try_only) {
+		os_atomic_inc(&sweet_ufs_users, relaxed);
+		if (!lck_mtx_try_lock(&sweet_ufs_lock)) {
+			os_atomic_dec(&sweet_ufs_users, relaxed);
+			return;
+		}
+	} else {
+		SWEET_UFS_LOCK();
+	}
+	bzero(bounce, UFS_BLOCK);
+	memcpy(bounce, &hb, sizeof(hb));
+	int error = ufs_write_blocks(sweet_hb_base, 1);
+	if (!error) {
+		error = ufs_sync_cache();
+	}
+	SWEET_UFS_UNLOCK();
+	if (!error) {
+		sweet_hb_prev = hb;     /* what the next boot will see */
+	}
+}
+
+/* Called from the stall watchdog just before it panics. */
+void
+sweet_hb_mark(uint32_t phase)
+{
+	if (sweet_hb_base != 0) {
+		sweet_hb_write(phase, true);
+	}
+}
+
+/*
+ * Interrupt-context stall probe. When every thread stops making progress the
+ * scheduler cannot run any watchdog, so this runs from a timer_call (which
+ * always keeps a decrementer deadline armed) and reads the pc that
+ * rtclock_intr recorded for the interrupted thread. It reports twice:
+ *  - to the panel, by printing to the kernel console and pointing the MDP back
+ *    at the console frame, which needs no scheduler, locks or disk;
+ *  - to a ring of blocks below the heartbeat block, when no thread is inside
+ *    the UFS driver.
+ */
+#define SWEET_STALL_SLOTS       16
+#define SWEET_STALL_AFTER_NS    10000000000ull   /* 10 s without progress */
+#define SWEET_STALL_EVERY_NS     5000000000ull   /* probe period */
+#define SWEET_STALL_VERSION      3u
+
+struct sweet_stall {
+	char magic[8];
+	uint32_t version;
+	uint32_t slot;
+	uint64_t seq;
+	uint64_t uptime_s;
+	uint64_t stall_s;
+	uint64_t pc;            /* interrupted pc: kernel VA if in the kernel */
+	uint64_t last_pc;       /* pc of the previous sample */
+	char name[16];          /* process name of the interrupted thread */
+	uint64_t console_bytes;
+	uint64_t ufs_ios;
+	uint64_t free_pages;
+	uint64_t ufs_users;
+	uint64_t op_age_ms;     /* v2: age of the in-flight UFS command */
+	uint32_t op_cdb;        /* v2: its SCSI opcode, 0 = none */
+	uint32_t op_flags;      /* bit0 write, bit1 active; ptimer: bit2 user, bit3 periodic */
+	uint64_t ptimer_runs;   /* v3: independent 1 Hz physical-timer ticks */
+};
+
+/*
+ * Independent 1 Hz tick on the ARM *physical* timer (PPI 18). XNU itself runs
+ * on the virtual timer (PPI 19), so if the scheduler path dies this one may
+ * still fire. Its whole purpose is to answer "is the CPU still taking
+ * interrupts?" after a stall, and to record stall samples when nothing else
+ * runs. Boot-arg sweetptimer=1 enables it.
+ */
+static int sweet_ptimer_on;
+static int sweet_ptimer_record;
+static int sweet_vtimer_record;
+uint64_t sweet_ptimer_runs;
+
+void sweet_ptimer_rearm(void);
+void sweet_ptimer_rearm(void)
+{
+	if (!sweet_ptimer_on) {
+		return;
+	}
+	uint64_t frq = __builtin_arm_rsr64("cntfrq_el0");
+	__builtin_arm_wsr64("cntp_tval_el0", frq);      /* 1 s from now */
+	__builtin_arm_wsr64("cntp_ctl_el0", 1);         /* enable, unmasked */
+	__builtin_arm_isb(ISB_SY);
+}
+
+void sweet_ptimer_enable(void);
+void
+sweet_ptimer_enable(void)
+{
+	int on = 0;
+	if (!PE_parse_boot_argn("sweetptimer", &on, sizeof(on)) || !on) {
+		return;
+	}
+	/* Boot-arg parsing stays in thread context, never in the ISR. */
+	PE_parse_boot_argn("sweetptrecord", &sweet_ptimer_record, sizeof(sweet_ptimer_record));
+	sweet_irq_stats.ptimer_record = sweet_ptimer_record;
+	sweet_ptimer_on = 1;
+	sweet_ptimer_rearm();
+	printf("SWEET PTIMER: 1 Hz physical-timer tick enabled (INTID %u)\n",
+	    SWEET_PTIMER_INTID);
+}
+
+void sweet_ptimer_tick(uintptr_t pc, int user_mode);
+void
+sweet_ptimer_tick(uintptr_t pc, int user_mode)
+{
+	static uint64_t last_out, last_ios, idle_since, samples;
+	uint64_t now = mach_absolute_time();
+	uint64_t out, ios, ns;
+
+	os_atomic_inc(&sweet_ptimer_runs, relaxed);
+	sweet_irq_stats.ptimer_ticks = sweet_ptimer_runs;
+	sweet_irq_stats.ptimer_pc = pc;
+	sweet_irq_stats.ptimer_user = user_mode;
+	out = os_atomic_load(&sweet_log_total, relaxed);
+	ios = os_atomic_load(&sweet_ufs_ios, relaxed);
+	if (out != last_out || ios != last_ios || idle_since == 0) {
+		last_out = out;
+		last_ios = ios;
+		idle_since = now;
+	}
+	absolutetime_to_nanoseconds(now - idle_since, &ns);
+	uint64_t idle_s = ns / 1000000000ull;
+	if (!sweet_ptimer_record && ns < SWEET_STALL_AFTER_NS) {
+		return;
+	}
+	/* One sample every 5 s when stalled, or regardless of progress with
+	 * sweetptrecord=1. v3 carries the tick count for the later pull. */
+	if ((os_atomic_load(&sweet_ptimer_runs, relaxed) % 5) != 0 || sweet_hb_base == 0) {
+		return;
+	}
+	struct sweet_stall st;
+	bzero(&st, sizeof(st));
+	st.magic[0] = 'S'; st.magic[1] = 'W'; st.magic[2] = 'E'; st.magic[3] = 'E';
+	st.magic[4] = 'T'; st.magic[5] = 'S'; st.magic[6] = 'T'; st.magic[7] = 'L';
+	st.version = SWEET_STALL_VERSION;
+	st.slot = (uint32_t)(samples++ % SWEET_STALL_SLOTS);
+	st.seq = samples;
+	absolutetime_to_nanoseconds(now, &ns);
+	st.uptime_s = ns / 1000000000ull;
+	st.stall_s = idle_s;
+	st.pc = pc;
+	st.last_pc = sweet_intr_pc;
+	/* proc_selfname only copies the current process's resident name. */
+	proc_selfname(st.name, sizeof(st.name));
+	st.console_bytes = out;
+	st.ufs_ios = ios;
+	st.free_pages = vm_page_free_count;
+	st.ufs_users = os_atomic_load(&sweet_ufs_users, relaxed);
+	st.op_cdb = sweet_cur_op.cdb0;
+	st.op_flags = (sweet_cur_op.write ? 1u : 0u) | (sweet_cur_op.active ? 2u : 0u) |
+	    (user_mode ? 4u : 0u) | (sweet_ptimer_record ? 8u : 0u);
+	if (sweet_cur_op.active && now > sweet_cur_op.start) {
+		absolutetime_to_nanoseconds(now - sweet_cur_op.start, &ns);
+		st.op_age_ms = ns / 1000000ull;
+	}
+	st.ptimer_runs = os_atomic_load(&sweet_ptimer_runs, relaxed);
+	void *diag = (void *)(su.dma + DMA_DIAG_BOUNCE);
+	bzero(diag, DMA_DIAG_BLOCK);
+	memcpy(diag, &st, sizeof(st));
+	(void)ufs_diag_write_block(sweet_hb_base - 1 - (st.slot % SWEET_STALL_SLOTS));
+}
+
+/* Periodic samples on the already-working virtual timer. Physical IRQ delivery
+ * is not assumed; sweetvrecord is resolved once during UFS initialization. */
+static void
+sweet_virtual_record(uintptr_t pc, int user_mode)
+{
+	static uint64_t samples;
+	uint64_t now = mach_absolute_time(), ns;
+	struct sweet_stall st;
+	if (sweet_hb_base == 0) return;
+	bzero(&st, sizeof(st));
+	memcpy(st.magic, "SWEETSTL", 8);
+	st.version = SWEET_STALL_VERSION;
+	st.slot = (uint32_t)(samples++ % SWEET_STALL_SLOTS);
+	st.seq = samples;
+	absolutetime_to_nanoseconds(now, &ns);
+	st.uptime_s = ns / 1000000000ull;
+	st.pc = pc;
+	st.last_pc = sweet_intr_pc;
+	proc_selfname(st.name, sizeof(st.name));
+	st.console_bytes = os_atomic_load(&sweet_log_total, relaxed);
+	st.ufs_ios = os_atomic_load(&sweet_ufs_ios, relaxed);
+	st.free_pages = vm_page_free_count;
+	st.ufs_users = os_atomic_load(&sweet_ufs_users, relaxed);
+	st.op_cdb = sweet_cur_op.cdb0;
+	st.op_flags = (sweet_cur_op.write ? 1u : 0u) |
+	    (sweet_cur_op.active ? 2u : 0u) | (user_mode ? 4u : 0u) | 8u;
+	if (sweet_cur_op.active && now > sweet_cur_op.start) {
+		absolutetime_to_nanoseconds(now - sweet_cur_op.start, &ns);
+		st.op_age_ms = ns / 1000000ull;
+	}
+	st.ptimer_runs = os_atomic_load(&sweet_ptimer_runs, relaxed);
+	void *diag = (void *)(su.dma + DMA_DIAG_BOUNCE);
+	bzero(diag, DMA_DIAG_BLOCK);
+	memcpy(diag, &st, sizeof(st));
+	(void)ufs_diag_write_block(sweet_hb_base - 1 - st.slot);
+}
