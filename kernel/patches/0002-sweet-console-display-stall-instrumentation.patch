+/*
+ * Diagnostic counters for the Citrus/Sweet idle path.
+ *
+ * cpu_idle() has a "proximate timer" shortcut that waits for the next timer
+ * interrupt with WFE while IRQs are masked.  On this port the platform never
+ * populates cpu_idle_latency (it is zero), so that shortcut is only entered
+ * when the software deadline is already in the past.  These counters let the
+ * 1 Hz sampler and the 5 s timer-interrupt liveness line show whether the
+ * shortcut is being taken, how it was entered, and whether it ever returned.
+ *
+ * The struct is filled with a plain copy; the reader is a diagnostic thread
+ * and may observe a torn update.  Do not use it for policy decisions.
+ */
+#ifndef _ARM_SWEET_IDLE_STATS_H_
+#define _ARM_SWEET_IDLE_STATS_H_
+
+typedef struct sweet_idle_stats {
+	uint64_t prox_entries;       /* cpu_proximate_timer() returned true */
+	uint64_t prox_expired;       /* rtcPop was already in the past */
+	uint64_t wfe_iters;          /* completed WFEs in the idle WFE loop */
+	uint64_t wfi_iters;          /* WFIs issued by the fixed wait */
+	uint64_t skipped;            /* expired waits bypassed (mode 2) */
+	uint64_t first_now;          /* first proxy entry, for rate context */
+	uint64_t last_now;           /* state captured at the latest entry */
+	uint64_t last_rtcpop;
+	uint64_t last_isr;
+	uint64_t last_cntv_ctl;
+	uint64_t last_cntv_tval;
+	uint64_t last_cntkctl;
+	uint64_t last_daif;
+	uint64_t wfe_recommendation; /* ml_cluster_wfe_timeout(cluster 0) */
+	uint64_t idle_latency;       /* cpu_idle_latency (0 on this port) */
+	uint32_t last_expired;
+	uint32_t mode;               /* 0 = old WFE, 1 = WFI, 2 = skip expired */
+} sweet_idle_stats_t;
+
+extern void sweet_idle_stats_snapshot(sweet_idle_stats_t *out);
+
+#endif /* _ARM_SWEET_IDLE_STATS_H_ */
