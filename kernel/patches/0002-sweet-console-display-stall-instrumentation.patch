+	    citrus_touch_probe_mode == 6 || citrus_touch_probe_mode == 7 ||
+	    citrus_touch_probe_mode == 8 || citrus_touch_probe_mode == 9 ||
+	    citrus_touch_probe_mode == 10) && halted) {
