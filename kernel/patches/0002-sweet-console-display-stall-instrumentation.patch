+		printf("CITRUS TOUCH: mode9 start app command failed\n");
+		return false;
+	}
+	touch_wait(10);
+	citrus9_status_raw(west, "start+10ms");
+	touch_wait(40);
+	citrus9_status_raw(west, "start+50ms");
+	touch_wait(200);
+	citrus9_status_raw(west, "start+250ms");
+	citrus9_read_raw(west, "chip a3 (app)", 0xa3, 1, 1, true);
+	citrus9_read_raw(west, "id 90 (boot)", 0x90, 1, 2, false);
+	citrus9_status_raw(west, "post");
+	ok = citrus9_idle(west, true, &status);
+	printf("CITRUS TOUCH: mode9 app idle=%d status=%#x\n", ok, status);
+	if (ok) {
+		ok = citrus9_read(west, 0xa3, &chip, 1, true);
+		printf("CITRUS TOUCH: mode9 app chip ok=%d id=%#x\n", ok, chip);
+		ok = ok && citrus9_read(west, 0xa6, &fwver, 1, true);
+		printf("CITRUS TOUCH: mode9 app fw ok=%d ver=%#x\n", ok, fwver);
+	}
