+/*
+ * A 32-cell progress bar along the bottom of the console frame. Each timer
+ * probe advances it, so the screen alone says whether interrupts are still
+ * arriving after the system stops making progress: if the bar keeps moving
+ * past the freeze, the kernel is alive and only the I/O threads are wedged.
+ */
+static void
+sweet_panel_bar(int filled)
+{
+	uintptr_t va = 0;
+	uint32_t stride = 0, height = 0;
+	uint64_t pa = 0;
+
+	if (!sweet_fb_console_frame(&va, &stride, &height, &pa) || va == 0 ||
+	    height < 64 || stride < 128) {
+		return;
+	}
+	int width = (int)(stride / 4);
+	int bh = 48;                    /* bar height, top of the frame */
+
+	/* Black band at the top, white filled bar whose length wraps every 60 s,
+	 * plus a solid marker at each end so the direction is obvious. */
+	for (int y = 0; y < bh; y++) {
+		uint32_t *p = (uint32_t *)(va + (uint64_t)y * stride);
+		for (int x = 0; x < width; x++) {
+			p[x] = 0xff000000u;
+		}
+	}
+	int n = (filled % 60);
+	int len = width * n / 60;
+	for (int y = 4; y < bh - 4; y++) {
+		uint32_t *p = (uint32_t *)(va + (uint64_t)y * stride);
+		for (int x = 0; x < len; x++) {
+			p[x] = 0xffffffffu;
+		}
+		for (int x = 0; x < 8 && x < width; x++) {          /* left tick */
+			p[x] = 0xff00ff00u;
+		}
+	}
+	clean_dcache64((addr64_t)va, (unsigned)(bh * stride), TRUE);
+}
+
+/*
+ * Called from rtclock_intr (osfmk/arm/rtclock.c) on every timer interrupt, in
+ * interrupt context, with the interrupted pc. rtclock also keeps a 1 Hz tick
+ * armed (see there) because timer_call callbacks never run on this port:
+ * ml_timer_evaluate() is empty, so only thread-wakeup deadlines are serviced.
+ */
+/*
+ * Persist the counters from the timer interrupt. Uses the controller only when
+ * no thread is inside the driver (one CPU, interrupts off here), so a UFS wedge
+ * cannot corrupt anything: the block simply stops advancing.
+ */
+static void
+sweet_hb_write_from_irq(void)
+{
+	static uint64_t seq;
+	void *bounce = (void *)(su.dma + DMA_BOUNCE);
+
+	if (sweet_hb_base == 0 || os_atomic_load(&sweet_ufs_users, relaxed) != 0) {
+		return;
+	}
+	/* Never touch the single UTRL slot from interrupt context unless asked. */
+	if (!sweet_irq_ufs_writes()) {
+		return;
+	}
+	sweet_irq_stats.ptimer_ctl = __builtin_arm_rsr64("cntp_ctl_el0");
+	sweet_irq_stats.ptimer_tval = __builtin_arm_rsr64("cntp_tval_el0");
+	sweet_irq_stats.ptimer_frq = __builtin_arm_rsr64("cntfrq_el0");
+	struct sweet_heartbeat hb = {
+		.magic = { 'S', 'W', 'E', 'E', 'T', 'H', 'B', '1' },
+		.version = SWEET_HB_VERSION,
+		.phase = SWEET_HB_RUNNING,
+		.boot_id = sweet_hb_prev.boot_id,
+		.seq = ++seq,
+		.console_bytes = os_atomic_load(&sweet_log_total, relaxed),
+		.console_seq = os_atomic_load(&sweet_console_seq, relaxed),
+		.ufs_ios = os_atomic_load(&sweet_ufs_ios, relaxed),
+		.flush_runs = os_atomic_load(&sweet_flush_runs, relaxed),
+		.free_pages = vm_page_free_count,
+		.wire_pages = vm_page_wire_count,
+		.svc_runs = os_atomic_load(&sweet_svc_runs, relaxed),
+		.panel_runs = os_atomic_load(&sweet_panel_runs, relaxed),
+		.intr_pc = sweet_intr_pc,
+		.ufs_users = os_atomic_load(&sweet_ufs_users, relaxed),
+		.irq = sweet_irq_stats,
+		.gcc_changes = os_atomic_load(&sweet_gcc_changes, relaxed),
+		.gcc_gdsc = sweet_gcc_state.gdsc,
+		.gcc_axi = sweet_gcc_state.axi,
+		.gcc_ahb = sweet_gcc_state.ahb,
+		.gcc_unipro = sweet_gcc_state.unipro,
+		.gcc_noc = sweet_gcc_state.noc,
+		.gcc_clkref = sweet_gcc_state.clkref,
+		.gcc_collapses = sweet_gcc_state.collapse_count,
+		.hc_hce = sweet_hc_state.hce,
+		.hc_hcs = sweet_hc_state.hcs,
+		.hc_is = sweet_hc_state.is,
+		.hc_utrldbr = sweet_hc_state.utrldbr,
+		.hc_utrlrsr = sweet_hc_state.utrlrsr,
+		.hc_seq = sweet_hc_state.seq,
+	};
+	uint64_t ns;
+	absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+	hb.uptime_s = ns / 1000000000ull;
+	hb.prev_boot_id = sweet_hb_prev.prev_boot_id;
+	hb.prev_phase = sweet_hb_prev.prev_phase;
+	hb.prev_uptime_s = sweet_hb_prev.prev_uptime_s;
+	hb.prev_console_bytes = sweet_hb_prev.prev_console_bytes;
+	hb.prev_console_seq = sweet_hb_prev.prev_console_seq;
+	hb.prev_ufs_ios = sweet_hb_prev.prev_ufs_ios;
+	hb.prev_flush_runs = sweet_hb_prev.prev_flush_runs;
+	bzero(bounce, UFS_BLOCK);
+	memcpy(bounce, &hb, sizeof(hb));
+	if (ufs_write_blocks(sweet_hb_base, 1) == 0) {
+		(void)ufs_sync_cache();
+	}
+	/* The thread-side writer must not overwrite this with older counters. */
+	sweet_hb_prev = hb;
+}
+
+void
+sweet_stall_service(uintptr_t pc, int user_mode)
+{
+	uint64_t step, ns;
+	static uint64_t next_service;
+	uint64_t now;
+
+	/* A user-mode interrupt says nothing about kernel loops; keep the last
+	 * kernel pc instead. */
+	if (!user_mode) {
+		sweet_intr_pc = pc;
+	}
+	nanoseconds_to_absolutetime(SWEET_STALL_EVERY_NS, &step);
+	now = mach_absolute_time();
+	if (now < next_service) {
+		return;
+	}
+	next_service = now + step;
+	os_atomic_inc(&sweet_svc_runs, relaxed);
+
+	/*
+	 * Lock-free liveness line from the timer interrupt, straight into the USB
+	 * console ring. This runs even while every thread is stuck, so after a
+	 * "silent" boot these lines say whether the CPU is still taking
+	 * interrupts (kernel alive, some thread/console lock stuck) or whether it
+	 * is really wedged on a load (no lines at all). Never printf here.
+	 */
+	{
+		char lv[256];
+		uint64_t lns = 0;
+		int ln;
+		sweet_idle_stats_t ids;
+		sweet_idle_stats_snapshot(&ids);
+		absolutetime_to_nanoseconds(now, &lns);
+		ln = snprintf(lv, sizeof(lv),
+		    "SWEET LV T=%llu SVC=%llu IOS=%llu CB=%llu U=%llu PC=%llx "
+		    "IDLE=%llu/%llu/%llu/%llu WFE=%llu REC=0x%llx KCTL=0x%llx\n",
+		    lns / 1000000000ull, os_atomic_load(&sweet_svc_runs, relaxed),
+		    os_atomic_load(&sweet_ufs_ios, relaxed),
+		    os_atomic_load(&sweet_log_total, relaxed),
+		    os_atomic_load(&sweet_ufs_users, relaxed), (uint64_t)sweet_intr_pc,
+		    ids.prox_entries, ids.prox_expired, ids.wfi_iters, ids.skipped,
+		    ids.wfe_iters, ids.wfe_recommendation, ids.last_cntkctl);
+		if (ln > 0) {
+			sweet_log_append(lv, MIN(ln, (int)sizeof(lv) - 1));
+		}
+	}
+
+	if (sweet_panel_on()) {
+		os_atomic_inc(&sweet_panel_runs, relaxed);
+	}
+	if (sweet_panel_draw()) {
+		char line[112];
+		int n;
+
+		absolutetime_to_nanoseconds(now, &ns);
+		n = snprintf(line, sizeof(line), "SWEET PANEL T=%lluS N=%llu UFS=%llu C=%llu PC=%llx",
+		    ns / 1000000000ull, os_atomic_load(&sweet_svc_runs, relaxed),
+		    os_atomic_load(&sweet_ufs_users, relaxed),
+		    os_atomic_load(&sweet_other_bytes, relaxed),
+		    (uint64_t)sweet_intr_pc);
+		/* No printf, no console locks, no scheduler: raw pixels + MMIO. */
+		sweet_panel_text(line, n, 0);
+		sweet_panel_bar((int)(os_atomic_load(&sweet_svc_runs, relaxed) % 32));
+		sweet_fb_show_console();
+		sweet_console_hold = 1;
+	}
+	sweet_hb_write_from_irq();
+	if (sweet_vtimer_record) {
+		sweet_virtual_record(pc, user_mode);
+	} else {
+		sweet_stall_probe();
+	}
+}
+
+static void
+sweet_stall_probe(void)
+{
+	static uint64_t idle_since, last_sample, samples;
+	static uint64_t last_out, last_ios, prev_pc;
+	uint64_t now = mach_absolute_time();
+	uint64_t step, idle_ns;
+
+	if (sweet_hb_base == 0) {
+		return;
+	}
+	uint64_t out = os_atomic_load(&sweet_other_bytes, relaxed);
+	uint64_t ios = os_atomic_load(&sweet_ufs_ios, relaxed);
+	if (out != last_out || ios != last_ios) {
+		last_out = out;
+		last_ios = ios;
+		idle_since = 0;
+		return;
+	}
+	if (idle_since == 0) {
+		idle_since = now;
+		return;
+	}
+	absolutetime_to_nanoseconds(now - idle_since, &idle_ns);
+	if (idle_ns < SWEET_STALL_AFTER_NS) {
+		return;
+	}
+	nanoseconds_to_absolutetime(SWEET_STALL_EVERY_NS, &step);
+	if (now - last_sample < step) {
+		return;
+	}
+	last_sample = now;
+
+	uintptr_t pc = sweet_intr_pc;
+	uint64_t users = os_atomic_load(&sweet_ufs_users, relaxed);
+	struct sweet_stall st = {
+		.magic = { 'S', 'W', 'E', 'E', 'T', 'S', 'T', 'L' },
+		.version = SWEET_STALL_VERSION,
+		.slot = (uint32_t)(samples % SWEET_STALL_SLOTS),
+		.seq = ++samples,
+		.stall_s = idle_ns / 1000000000ull,
+		.pc = pc,
+		.last_pc = prev_pc,
+		.console_bytes = out,
+		.ufs_ios = ios,
+		.free_pages = vm_page_free_count,
+		.ufs_users = users,
+	};
+	prev_pc = pc;
+	uint64_t ns;
+	absolutetime_to_nanoseconds(now, &ns);
+	st.uptime_s = ns / 1000000000ull;
+	proc_selfname(st.name, sizeof(st.name));
+
+	/*
+	 * Panel first: this must work even when the compositor, the disk and the
+	 * scheduler are gone. printf draws into the console shadow; the hook
+	 * points the display at it with register writes only.
+	 */
+	char line[160];
+	int n = snprintf(line, sizeof(line),
+	    "SWEET STALL T=%llu STALL=%llu UFS=%llu PC=%llx LAST=%llx %s",
+	    st.uptime_s, st.stall_s, users, (uint64_t)pc, (uint64_t)prev_pc, st.name);
+	sweet_panel_text(line, n, 1);
+	sweet_fb_show_console();
+
+	/*
+	 * Persist the sample through UTRL slot 1, which the driver never uses.
+	 * This works even when a thread holds sweet_ufs_lock - the exact case
+	 * the previous version could not record.
+	 */
+	if (st.seq != 0) {
+		void *diag = (void *)(su.dma + DMA_DIAG_BOUNCE);
+		uint64_t ns2 = 0;
+		if (sweet_cur_op.active && mach_absolute_time() > sweet_cur_op.start) {
+			absolutetime_to_nanoseconds(mach_absolute_time() - sweet_cur_op.start, &ns2);
+		}
+		st.op_age_ms = ns2 / 1000000ull;
+		st.op_cdb = sweet_cur_op.cdb0;
+		st.op_flags = (sweet_cur_op.write ? 1u : 0u) | (sweet_cur_op.active ? 2u : 0u);
+		bzero(diag, DMA_DIAG_BLOCK);
+		memcpy(diag, &st, sizeof(st));
+		(void)ufs_diag_write_block(sweet_hb_base - 1 - (st.slot % SWEET_STALL_SLOTS));
+	}
+}
+
+/*
+ * Read-only inventory of a firmware-reserved RAM window.
+ *
+ * ABL reserves 0xf3c00000..0xffc00000 (192 MiB) inside the OS bank; it has no
+ * device-tree node, so its owner is unknown. The window sits directly below
+ * 952 MiB that is free, so if it is dead RAM the ADT can publish one
+ * contiguous 2992 MiB range instead of today's 1792 MiB -- but only if it is
+ * not live co-processor or secure memory. This probe only reads: an XPU
+ * violation faults here instead of corrupting anyone's memory, which is the
+ * answer we want before touching the ADT.
+ *
+ * sweetresprobe=<seconds> (0 = off, default) runs once, from the heartbeat
+ * thread, so the console is already attached and the output is captured.
+ */
+#define SWEET_RESP_PA     0xf3c00000ull
+#define SWEET_RESP_SIZE   0x00c00000ull         /* 192 MiB */
+#define SWEET_RESP_POINTS 16
+
+static unsigned sweet_resprobe_s;
+static boolean_t sweet_resprobe_done;
+
+static void
+sweet_resprobe(void)
+{
+	uint64_t step = SWEET_RESP_SIZE / SWEET_RESP_POINTS;
+	unsigned busy = 0;
+	unsigned mapped = 0;
+
+	printf("SWEET RESP: probing %#llx..%#llx (192 MiB, read-only)\n",
+	    SWEET_RESP_PA, SWEET_RESP_PA + SWEET_RESP_SIZE);
+	for (unsigned i = 0; i < SWEET_RESP_POINTS; i++) {
+		uint64_t pa = SWEET_RESP_PA + (uint64_t)i * step;
+		vm_offset_t va = ml_io_map(pa, 0x1000);
+		if (va == 0) {
+			printf("SWEET RESP %#llx: map failed\n", pa);
+			continue;
+		}
+		uint32_t w0 = *(volatile uint32_t *)(va + 0x00);
+		uint32_t w1 = *(volatile uint32_t *)(va + 0x04);
+		uint32_t w2 = *(volatile uint32_t *)(va + 0x08);
+		uint32_t w3 = *(volatile uint32_t *)(va + 0x0c);
+		mapped++;
+		if (w0 | w1 | w2 | w3) {
+			busy++;
+		}
+		printf("SWEET RESP %#llx: %08x %08x %08x %08x\n", pa, w0, w1, w2, w3);
+	}
+	printf("SWEET RESP: %u/%u points readable, %u non-zero; window is %s\n",
+	    mapped, SWEET_RESP_POINTS, busy,
+	    (mapped == SWEET_RESP_POINTS && busy == 0) ? "all-zero (claimable candidate)" :
+	    "NOT empty (do not claim)");
+}
+
+static void
+sweet_hb_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	void *bounce = (void *)(su.dma + DMA_BOUNCE);
+	struct sweet_heartbeat old;
+	int error;
+
+	sweet_hb_base = su.first_block + su.nblocks - SWEET_LOG_BLOCKS - 1;
+	bzero(&old, sizeof(old));
+	SWEET_UFS_LOCK();
+	error = ufs_read_blocks(sweet_hb_base, 1);
+	if (!error) {
+		memcpy(&old, bounce, sizeof(old));
+	}
+	SWEET_UFS_UNLOCK();
+
+	if (error == 0 && memcmp(old.magic, "SWEETHB1", 8) == 0 &&
+	    old.version >= 2 && old.version <= SWEET_HB_VERSION) {
+		sweet_hb_prev.boot_id = old.boot_id + 1;
+		sweet_hb_prev.prev_boot_id = old.boot_id;
+		sweet_hb_prev.prev_phase = old.phase;
+		sweet_hb_prev.prev_uptime_s = old.uptime_s;
+		sweet_hb_prev.prev_console_bytes = old.console_bytes;
+		sweet_hb_prev.prev_console_seq = old.console_seq;
+		sweet_hb_prev.prev_ufs_ios = old.ufs_ios;
+		sweet_hb_prev.prev_flush_runs = old.flush_runs;
+	} else {
+		sweet_hb_prev.boot_id = 1;
+	}
+	sweet_hb_write(SWEET_HB_RUNNING, false);
+	(void)sweet_panel_on();
+	(void)PE_parse_boot_argn("sweetresprobe", &sweet_resprobe_s,
+	    sizeof(sweet_resprobe_s));
+	if (sweet_resprobe_s > 600) {
+		sweet_resprobe_s = 0;
+	}
+	for (;;) {
+		(void)tsleep(&sweet_hb_chan, PZERO, "sweethb", hz * SWEET_HB_SECS);
+		if (!sweet_resprobe_done && sweet_resprobe_s != 0) {
+			uint64_t ns = 0;
+			absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+			if (ns / 1000000000ull >= (uint64_t)sweet_resprobe_s) {
+				sweet_resprobe_done = TRUE;
+				sweet_resprobe();
+			}
+		}
+		sweet_hb_write(SWEET_HB_RUNNING, false);
+	}
+}
