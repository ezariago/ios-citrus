+		uint64_t active0 = sweet_gic_redist_read(wat_mpidr, SWEET_GICR_ISACTIVER0);
+		uint64_t enable0 = sweet_gic_redist_read(wat_mpidr, SWEET_GICR_ISENABLER0);
+		uint64_t waker0 = sweet_gic_redist_read(wat_mpidr, SWEET_GICR_WAKER);
+		thread_t thr = __atomic_load_n(&wat->cpu_active_thread, __ATOMIC_RELAXED);
