+		/* Vendor boot-ROM handshake, PRAM firmware download, app id. */
+		citrus_touch_vendor_bringup();
+		goto out;
+	}
+	if (citrus_touch_probe_mode == 8) {
+		/* Handshake variants + GPIO bit-bang, no firmware write. */
+		citrus_touch_handshake_variants();
