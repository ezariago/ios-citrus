+	uint64_t last_out = sweet_log_position();
+	uint64_t last_ios = sweet_ufs_ios_count();
+	int idle = 0;
+	for (;;) {
+		(void)tsleep(&chan, PZERO, "sweetwdt", 5 * hz);
+		uint64_t out = sweet_log_position();
+		uint64_t ios = sweet_ufs_ios_count();
+		if (out != last_out || ios != last_ios) {
+			last_out = out;
+			last_ios = ios;
+			idle = 0;
+			continue;
+		}
+		idle += 5;
+		if (idle < secs) {
+			continue;
+		}
+		/* Record the stall even if the console or a panic cannot print. */
+		sweet_hb_mark(1);
+		printf("SWEET WDT: no console output or block I/O for %d s\n", idle);
+		printf("SWEET WDT: console generated %llu bytes, flushed %llu\n",
+		    sweet_log_position(), sweet_log_flushed_bytes());
+		sweet_sample_compact = 1;
+		printf("SMP --- stall dump\n");
+		proc_iterate(PROC_ALLPROCLIST, sweet_sample_proc, NULL, NULL, NULL);
+		panic("SWEET WDT: stall, no progress for %d s", idle);
+	}
