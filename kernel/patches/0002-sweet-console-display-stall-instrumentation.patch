+/* Called from thread context once the root device is attached (sweet_ufs.c).
+ * Does nothing unless a second CPU is running, so cpus=1 stays unchanged. */
+void
+sweet_obs_start(void)
+{
+	thread_t thread;
+	kern_return_t kr;
+
+	if (ml_get_cpu_count() <= SWEET_OBS_CPU) {
+		return;
+	}
+	if (kernel_thread_start(&sweet_obs_thread, NULL, &thread) != KERN_SUCCESS) {
