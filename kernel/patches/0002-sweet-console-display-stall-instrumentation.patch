+/* Index into sweet_font5x7: 0-25 = A-Z, 26-35 = 0-9, 36 = space/unknown. */
+static const char sweet_text_chars[] = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789 ";
+
+static int
+sweet_text_index(char ch)
+{
+	if (ch >= 'a' && ch <= 'z') {
+		ch -= 'a' - 'A';
+	}
+	/* '=' reads fine as two dashes; '.' and '-' are drawn below. */
+	if (ch == '=') {
+		return -2;
+	}
+	if (ch == '.') {
+		return -3;
+	}
+	if (ch == '-') {
+		return -4;
+	}
+	for (int i = 0; i < 36; i++) {
+		if (sweet_text_chars[i] == ch) {
+			return i;
+		}
+	}
+	return 36;
+}
+
+/* Draw one line of text at row band `row` (0 = top of the status area). */
+static void
+sweet_panel_text(const char *s, int len, int row)
+{
+	uintptr_t va = 0;
+	uint32_t stride = 0, height = 0;
+	uint64_t pa = 0;
+
+	if (!sweet_fb_console_frame(&va, &stride, &height, &pa) || va == 0) {
+		if (!sweet_console_shadow_info(&va, &stride, &height) || va == 0) {
+			return;
+		}
+	}
+	const int scale = SWEET_GLYPH_SCALE;
+	const int char_w = 6 * scale;
+	const int char_h = 8 * scale;
+	int width = (int)(stride / 4);
+	int band_h = char_h * SWEET_TEXT_ROWS;
+	int y0 = (int)height - band_h + row * char_h;
+	if (y0 < 0) {
+		y0 = 0;
+	}
+	/* First draw: flood the frame so it is obvious whether the panel is
+	 * really scanning this buffer at all. */
+	{
+		static int flooded;
+		if (!flooded) {
+			flooded = 1;
+			for (uint32_t y = 0; y < height; y++) {
+				uint32_t *p = (uint32_t *)(va + (uint64_t)y * stride);
+				for (int x = 0; x < width; x++) {
+					p[x] = 0xff000000u;   /* black */
+				}
+			}
+			clean_dcache64((addr64_t)va, (unsigned)(height * stride), TRUE);
+		}
+	}
+	/* Clear the whole status band once per row update. */
+	for (int y = y0; y < y0 + char_h && y < (int)height; y++) {
+		uint32_t *p = (uint32_t *)(va + (uint64_t)y * stride);
+		for (int x = 0; x < width; x++) {
+			p[x] = 0xff000000u;
+		}
+	}
+	for (int i = 0; i < len; i++) {
+		int idx = sweet_text_index(s[i]);
+		int x0 = i * char_w;
+		if (idx == 36) {
+			continue;
+		}
+		for (int gy = 0; gy < 7; gy++) {
+			uint8_t bits;
+			if (idx == -2) {
+				bits = (gy == 3 || gy == 4) ? 0x1f : 0;      /* '=' */
+			} else if (idx == -3) {
+				bits = (gy == 6) ? 0x0e : 0;                 /* '.' */
+			} else if (idx == -4) {
+				bits = (gy == 3) ? 0x1f : 0;                 /* '-' */
+			} else {
+				bits = sweet_font5x7[idx][gy];
+			}
+			for (int sy = 0; sy < scale; sy++) {
+				int y = y0 + 1 * scale + gy * scale + sy;
+				if (y >= (int)height) {
+					continue;
+				}
+				uint32_t *p = (uint32_t *)(va + (uint64_t)y * stride);
+				for (int gx = 0; gx < 5; gx++) {
+					if (!(bits & (0x10 >> gx))) {
+						continue;
+					}
+					for (int sx = 0; sx < scale; sx++) {
+						int x = x0 + gx * scale + sx;
+						if (x < width) {
+							p[x] = 0xffffffffu;
+						}
+					}
+				}
+			}
+		}
+	}
+	clean_dcache64((addr64_t)va + (uint64_t)y0 * stride,
+	    (unsigned)(char_h * stride), TRUE);
+}
