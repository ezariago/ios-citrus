+/* This port runs one CPU. A bounded page-table walk/copy with interrupts
+ * masked keeps translations stable without taking VM locks or paging in data.
+ * Missing/non-RAM pages simply truncate this observational backtrace. */
+static bool
+sweet_sample_read_resident(vm_map_t map, uint64_t src, void *dst, size_t len)
+{
+	bool ok = true;
+	boolean_t istate = ml_set_interrupts_enabled(FALSE);
+	while (len != 0) {
+		pmap_paddr_t pa = pmap_vtophys(vm_map_pmap(map), src);
+		if (pa == 0 || !pmap_valid_address(pa)) {
+			ok = false;
+			break;
+		}
+		size_t n = MIN(len, PAGE_SIZE - (pa & PAGE_MASK));
+		bcopy((const void *)phystokv(pa), dst, n);
+		src += n;
+		dst = (char *)dst + n;
+		len -= n;
+	}
+	ml_set_interrupts_enabled(istate);
+	return ok;
+}
