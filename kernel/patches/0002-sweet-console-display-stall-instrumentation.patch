+	    touch_rd(gcc, 0x7900c), touch_rd(gcc, 0x1f3a8), touch_rd(gcc, 0x1f3ac));
+	for (unsigned i = 0; i < sizeof(offsets) / sizeof(offsets[0]); i++) {
+		uint32_t value = touch_rd(gcc, offsets[i]);
+		printf("CITRUS TOUCH: clock %s off=%#x value=%#x halted=%u\n",
+		    names[i], offsets[i], value, (value >> 31) & 1u);
+		if (value & (1u << 31)) {
+			halted = true;
+		}
