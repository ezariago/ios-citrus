+/*
+ * SMP observer (research/CITRUS-CROSS-PROJECT.md section 6, step 2).
+ *
+ * With cpus=2 a second Gold core exists that no single-core stall can take
+ * away. This thread pins itself to CPU1 and, once a second, reports CPU0's
+ * state as seen *from the outside*:
+ *
+ *   - cpu_stat.timer_cnt on CPU0: does the architected timer still deliver?
+ *   - cpu_stat.ipi_cnt plus a SIGPnop round trip: does CPU0 still take SGIs?
+ *     cpu_signal_handler() bumps ipi_cnt before it looks at any service bit,
+ *     so a delta is a positive handshake with the target core, and
+ *     cpu_signal() itself fails with SIGPdisabled when CPU0 is not listening.
+ *   - GICv3 redistributor of CPU0 (pending/active/enable/waker): a PPI that is
+ *     pending but not active means CPU0 is not acking interrupts at all, while
+ *     an active bit means CPU0 is stuck inside that handler.
+ *   - cpu_active_thread of CPU0, with its name: what CPU0 is running.
+ *
+ * The 1 Hz line goes through sweet_log_append(), the lock-free console ring,
+ * so it needs no console lock, no UFS lock and no scheduler service on CPU0.
+ * When CPU0's timer stops for SWEET_OBS_STALL_NS the same data is additionally
+ * persisted into one fixed UFS diag block (slot-1 polled writer, which refuses
+ * while a normal UFS request is in flight) so the capture survives a reset.
+ */
+#define SWEET_OBS_CPU            1
+#define SWEET_OBS_STALL_NS       (2ULL * NSEC_PER_SEC)
+
+extern void sweet_log_append(const char *c, int size);
+extern int sweet_obs_persist(const void *data, int len);
+extern void thread_get_thread_name(thread_t th, char *name);
+extern uint64_t sweet_gic_redist_read(uint32_t phys_id, uint32_t offset);
+
+/* GICv3 redistributor frame offsets (RD_base) the observer reports. */
+#define SWEET_GICR_WAKER        0x0014u
+#define SWEET_GICR_ISENABLER0   0x10100u
+#define SWEET_GICR_ISPENDR0     0x10200u
+#define SWEET_GICR_ISACTIVER0   0x10300u
+
+struct sweet_obs_record {
+	uint8_t  magic[8];       /* "SWEETOBS" */
+	uint64_t seq;
+	uint64_t uptime_s;
+	uint64_t stall_s;
+	uint64_t timer0;         /* timer interrupts taken by the observed CPU */
+	uint64_t timer1;         /* timer interrupts taken by the observer CPU */
+	uint64_t ipi0;           /* IPIs taken by the observed CPU */
+	uint64_t ipi_delta;      /* change since the previous sample */
+	int32_t  ipi_rc;         /* cpu_signal() result (0 success, 14 failure) */
+	uint32_t sig0;           /* cpu_signal mask of the observed CPU */
+	uint64_t pend0, active0, enable0, waker0;
+	uint64_t thr0;           /* cpu_active_thread of the observed CPU */
+	uint64_t stack0;
+	uint32_t obs_cpu;
+	uint32_t wat_mpidr;
+	char     name[64];       /* observed CPU's active thread name */
