+static void
+sweet_ufs_clk_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	for (;;) {
+		(void)tsleep(&sweet_gcc_state, PZERO, "sweetclk", hz);
+		if (sweet_ufs_clk_mode != 0) {
+			sweet_ufs_gcc_force(false);
+		}
+		sweet_ufs_hc_sample();
+	}
+}
