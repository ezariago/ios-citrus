+ * interrupt: printf takes the console ticket lock and the console state machine
+ * may scrolled mid-update, which froze the phone at the first report. These
+ * helpers write pixels straight into the console frame and clean the cache.
+ */
+#define SWEET_GLYPH_SCALE 4
+#define SWEET_TEXT_ROWS   12
+static const uint8_t sweet_font5x7[37][7] = {
