+			goto out;
+		}
+		/*
+		 * clk-rcg2.c: CMD_RCGR bit31 is CMD_ROOT_OFF (1 = clock off),
+		 * bit1 is CMD_ROOT_EN, bit0 is CMD_UPDATE. Enabling the branch
+		 * already clears ROOT_OFF; the previous "ROOT_EN = bit31" write
+		 * was inverted and would have disabled the serial clock.
+		 */
+		uint32_t rcg = touch_rd(gcc, TOUCH_RCG);
+		if (rcg & (1u << 31)) {
+			printf("CITRUS TOUCH: RCG still off after vote; setting ROOT_EN\n");
+			touch_wr(gcc, TOUCH_RCG, rcg | (1u << 1));
+			__asm__ volatile("dsb sy" ::: "memory");
+			for (unsigned i = 0; i < 1000; i++) {
+				if (!(touch_rd(gcc, TOUCH_RCG) & (1u << 31))) {
+					break;
+				}
+				delay(1);
+			}
+		}
+		printf("CITRUS TOUCH: SE2 running cbcr=%#x rcg=%#x root_off=%u cfg=%#x\n",
+		    touch_rd(gcc, TOUCH_RCG - 4u), rcg,
+		    (touch_rd(gcc, TOUCH_RCG) >> 31) & 1u,
+		    touch_rd(gcc, TOUCH_RCG + 4u));
+		halted = false;
+	}
+	if (citrus_touch_probe_mode == 1 ||
+	    (halted && citrus_touch_probe_mode != 5)) {
+		printf("CITRUS TOUCH: SE2 untouched (%s); no clock/pin/power writes\n",
+		    halted ? "a required clock is halted" : "GCC-only mode");
+		goto out;
+	}
+	if (citrus_touch_probe_mode == 4 || citrus_touch_probe_mode == 5 ||
+	    citrus_touch_probe_mode == 6) {
+		/*
+		 * First writes beyond GCC: pinmux + reset always; the GENI SPI
+		 * transfer only in modes 4/6. Mode 5 isolates pinmux/reset and
+		 * never touches SE2.
+		 */
+		citrus_touch_spi_probe(gcc, citrus_touch_probe_mode != 5);
+		if (citrus_touch_probe_mode == 5) {
+			goto out;
+		}
+	}
