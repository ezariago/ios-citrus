+/*
+ * Error-path logging that never takes the console lock. The normal printf
+ * path can deadlock: a UFS waiter holds sweet_ufs_lock and blocks on the
+ * console lock while the console writer is blocked on sweet_ufs_lock, which
+ * is one explanation for the silent ~150 s freeze. Appending straight to the
+ * lock-free ring keeps the message and lets the driver finish the timeout and
+ * release the lock. sweet_log_append is documented as callable in any context.
+ */
+static void
+sweet_ufs_log(const char *fmt, ...)
+{
+	char buf[200];
+	va_list ap;
+	int n;
+
+	va_start(ap, fmt);
+	n = vsnprintf(buf, sizeof(buf), fmt, ap);
+	va_end(ap);
+	if (n > 0) {
+		sweet_log_append(buf, MIN(n, (int)sizeof(buf) - 1));
+	}
+}
