+/*
+ * Flight recorder: one device block just before the console-log area (still
+ * far past the end of the 16 GiB HFS image, so nothing else uses it). A
+ * kernel thread rewrites it every few seconds with counters that show which
+ * subsystem is still running, so a later reset cannot hide a stall behind a
+ * blocked console. It also carries a persistent boot id plus a snapshot of
+ * the previous boot's last heartbeat, so a watchdog panic + hardware reset
+ * loop is visible after the fact. tools/pull-sweetlog.sh fetches it too.
+ */
+#define SWEET_HB_SECS   5
+#define SWEET_HB_VERSION 1u
+#define SWEET_HB_RUNNING 0u
+#define SWEET_HB_DUMPING 1u
+
+struct sweet_heartbeat {
+	char magic[8];
+	uint32_t version;
+	uint32_t phase;         /* 0 running, 1 watchdog dump/panic in progress */
+	uint64_t boot_id;       /* persistent, incremented by each boot */
+	uint64_t seq;           /* heartbeat write number */
+	uint64_t uptime_s;      /* mach_absolute_time since boot */
+	uint64_t console_bytes; /* characters handed to the console */
+	uint64_t console_seq;   /* last console-log flush sequence persisted */
+	uint64_t ufs_ios;       /* block I/O requests serviced */
+	uint64_t flush_runs;    /* console flush thread wakeups */
+	uint64_t free_pages;    /* VM free page count */
+	uint64_t wire_pages;    /* VM wired page count */
+	/* how far the previous boot got before the phone reset */
+	uint64_t prev_boot_id, prev_phase, prev_uptime_s, prev_console_bytes,
+	    prev_console_seq, prev_ufs_ios, prev_flush_runs;
 };
 
+static int sweet_hb_chan;
+static uint64_t sweet_hb_base;
+static struct sweet_heartbeat sweet_hb_prev;   /* this boot's own last write */
 static void
+sweet_hb_write(uint32_t phase, bool try_only)
+{
+	static uint64_t seq;
+	void *bounce = (void *)(su.dma + DMA_BOUNCE);
+
+	struct sweet_heartbeat hb = {
+		.magic = { 'S', 'W', 'E', 'E', 'T', 'H', 'B', '1' },
+		.version = SWEET_HB_VERSION,
+		.phase = phase,
+		.boot_id = sweet_hb_prev.boot_id,
+		.seq = ++seq,
+		.console_bytes = os_atomic_load(&sweet_log_total, relaxed),
+		.console_seq = os_atomic_load(&sweet_console_seq, relaxed),
+		.ufs_ios = os_atomic_load(&sweet_ufs_ios, relaxed),
+		.flush_runs = os_atomic_load(&sweet_flush_runs, relaxed),
+		.free_pages = vm_page_free_count,
+		.wire_pages = vm_page_wire_count,
+	};
+	uint64_t ns;
+	absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+	hb.uptime_s = ns / 1000000000ULL;
+	hb.prev_boot_id = sweet_hb_prev.prev_boot_id;
+	hb.prev_phase = sweet_hb_prev.prev_phase;
+	hb.prev_uptime_s = sweet_hb_prev.prev_uptime_s;
+	hb.prev_console_bytes = sweet_hb_prev.prev_console_bytes;
+	hb.prev_console_seq = sweet_hb_prev.prev_console_seq;
+	hb.prev_ufs_ios = sweet_hb_prev.prev_ufs_ios;
+	hb.prev_flush_runs = sweet_hb_prev.prev_flush_runs;
+
+	/* A stalled UFS must not stop the watchdog from panicking: try only. */
+	if (try_only) {
+		os_atomic_inc(&sweet_ufs_users, relaxed);
+		if (!lck_mtx_try_lock(&sweet_ufs_lock)) {
+			os_atomic_dec(&sweet_ufs_users, relaxed);
+			return;
+		}
+	} else {
+		SWEET_UFS_LOCK();
+	}
+	bzero(bounce, UFS_BLOCK);
+	memcpy(bounce, &hb, sizeof(hb));
+	int error = ufs_write_blocks(sweet_hb_base, 1);
+	if (!error) {
+		error = ufs_sync_cache();
+	}
+	SWEET_UFS_UNLOCK();
+	if (!error) {
+		sweet_hb_prev = hb;     /* what the next boot will see */
+	}
+}
+
+/* Called from the stall watchdog just before it panics. */
+void
+sweet_hb_mark(uint32_t phase)
+{
+	if (sweet_hb_base != 0) {
+		sweet_hb_write(phase, true);
+	}
+}
