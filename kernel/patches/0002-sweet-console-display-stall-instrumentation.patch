+/*
+ * Interrupt-context one-block write through UTRL slot 1. Used only by the
+ * stall recorder: the driver never touches slot 1, its UCD or its bounce
+ * buffer, so this cannot corrupt an in-flight driver command. It is also
+ * bounded in time and clears the doorbell if the controller does not.
+ */
+static int
+ufs_diag_write_block(uint64_t lba)
+{
+	struct utrd *u = (struct utrd *)(su.dma + DMA_UTRL + sizeof(struct utrd));
+	struct ucd *c = (struct ucd *)(su.dma + DMA_DIAG_UCD);
+	uint64_t cpa = su.dma_pa + DMA_DIAG_UCD;
+	uint64_t bpa = su.dma_pa + DMA_DIAG_BOUNCE;
+	uint8_t cdb[10] = {
+		0x2a, 0,
+		(uint8_t)(lba >> 24), (uint8_t)(lba >> 16), (uint8_t)(lba >> 8), (uint8_t)lba,
+		0, 0, 1, 0,
+	};
+
+	if (!su.cache || su.dma == 0 || !su.ready) {
+		return -1;
+	}
+	bzero(u, sizeof(*u));
+	bzero(c->cmd, 64);
+	c->cmd[0] = 0x01;
+	c->cmd[1] = 0x20;                       /* data out */
+	c->cmd[2] = su.lun;
+	c->cmd[3] = ufs_next_tag();
+	c->cmd[12] = 0; c->cmd[13] = 0; c->cmd[14] = 0x10; c->cmd[15] = 0;
+	memcpy(&c->cmd[16], cdb, sizeof(cdb));
+	u->dw0 = (1u << 28) | (1u << 25) | (1u << 24);
+	u->dw2 = 0x0f;
+	u->ucdba = (uint32_t)cpa;
+	u->ucdbau = (uint32_t)(cpa >> 32);
+	u->resp = (512u / 4) << 16 | (512u / 4);
+	c->prdt[0].addr_lo = (uint32_t)bpa;
+	c->prdt[0].addr_hi = (uint32_t)(bpa >> 32);
+	c->prdt[0].dbc = DMA_DIAG_BLOCK - 1;
+	u->prdt = (1024u / 4) << 16 | 1;
+	dma_clean(DMA_UTRL + sizeof(struct utrd), sizeof(*u));
+	dma_clean(DMA_DIAG_UCD, 64 + sizeof(cdb));
+	dma_clean(DMA_DIAG_UCD + offsetof(struct ucd, prdt), sizeof(c->prdt[0]));
+	dma_clean(DMA_DIAG_BOUNCE, DMA_DIAG_BLOCK);
+	__builtin_arm_dsb(0xf);
+
+	ufs_wr(REG_UTRLDBR, 1u << 1);            /* slot 1 doorbell */
+	for (int i = 0; i < 2000; i++) {         /* <= ~20 ms, never spins forever */
+		if (!(ufs_rd(REG_UTRLDBR) & (1u << 1))) {
+			ufs_wr(REG_IS, ufs_rd(REG_IS));
+			return 0;
+		}
+		delay(10);
+	}
+	ufs_wr(REG_UTRLCLR, 1u << 1);            /* give the slot back */
+	return -1;
 }
 
+/*
+ * The UFS command that is in flight right now. A healthy thread can read this
+ * and print it without taking any lock, which is how the live USB console
+ * reports which command is stuck when progress stops.
+ */
+static struct {
+	uint64_t seq, start;
+	uint32_t len, tag;
+	uint8_t  cdb0, write, active;
+} sweet_cur_op;
+
+static void
+sweet_ufs_op_begin(uint8_t cdb0, uint32_t len, bool write)
+{
+	sweet_cur_op.seq++;
+	sweet_cur_op.start = mach_absolute_time();
+	sweet_cur_op.cdb0 = cdb0;
+	sweet_cur_op.len = len;
+	sweet_cur_op.write = write ? 1 : 0;
+	sweet_cur_op.active = 1;
+}
+
+static void
+sweet_ufs_op_end(void)
+{
+	sweet_cur_op.active = 0;
+}
+
+/* "op=0x28 w len=131072 age=3400ms n=1234" (empty when the driver is idle). */
+int sweet_ufs_op_string(char *buf, int max);
+
+int
+sweet_ufs_op_string(char *buf, int max)
+{
+	if (!sweet_cur_op.active) {
+		return snprintf(buf, max, "idle");
+	}
+	uint64_t ns = 0;
+	if (mach_absolute_time() > sweet_cur_op.start) {
+		absolutetime_to_nanoseconds(mach_absolute_time() - sweet_cur_op.start, &ns);
+	}
+	return snprintf(buf, max, "op=0x%02x%s len=%u age=%llums n=%llu",
+	    sweet_cur_op.cdb0, sweet_cur_op.write ? "w" : "r", sweet_cur_op.len,
+	    ns / 1000000ull, sweet_cur_op.seq);
+}
