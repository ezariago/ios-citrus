+static void
+sweet_wdt_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	static int chan;
+	int secs = 0;
+	if (!PE_parse_boot_argn("sweetwdt", &secs, sizeof(secs)) || secs < 15) {
+		return;
+	}
+	/*
+	 * Console bytes are the real progress signal: the flush thread keeps
+	 * waking even when a console lock or the display path has wedged every
+	 * writer, so its own wakeups cannot be used here.
+	 */
+	uint64_t last_out = sweet_log_position();
+	uint64_t last_ios = sweet_ufs_ios_count();
+	int idle = 0;
+	for (;;) {
+		(void)tsleep(&chan, PZERO, "sweetwdt", 5 * hz);
+		uint64_t out = sweet_log_position();
+		uint64_t ios = sweet_ufs_ios_count();
+		if (out != last_out || ios != last_ios) {
+			last_out = out;
+			last_ios = ios;
+			idle = 0;
+			continue;
+		}
+		idle += 5;
+		if (idle < secs) {
