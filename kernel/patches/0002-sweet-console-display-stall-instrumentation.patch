+/* Data-phase-only report read: the vendor passes cmd == NULL here
+ * (fts_read_touchdata(): buf[0]=0x01, then fts_read(NULL, 0, buf+1, n-1)).
+ * The IC streams the report; the last two bytes are the CRC16. */
+static bool
+citrus10_report(vm_offset_t west, uint8_t *out, unsigned n)
+{
+	static uint8_t tx[96], rx[96];
+	uint16_t crc = 0, want;
+	unsigned i, total = 1u + n + 2u;
+
+	if (n == 0 || total > sizeof(tx)) {
+		return false;
+	}
+	memset(tx, 0, total);
+	tx[0] = CITRUS7_DATA;
+	citrus8_bb_set(west, CITRUS8_BB_CS, true, false);
+	delay(2);
+	for (i = 0; i < total; i++) {
+		rx[i] = citrus9_bb_byte(west, CITRUS9_MOSI, CITRUS9_MISO, tx[i]);
+		if (i == 0 && total > 1) {
+			delay(30);
+		}
+	}
+	citrus8_bb_set(west, CITRUS8_BB_CS, true, true);
+	delay(150);
+	memcpy(out, rx + 1, n + 2);
+	citrus_fts_crc(out, n, &crc);
+	want = (uint16_t)out[n] | ((uint16_t)out[n + 1] << 8);
+	return crc == want;
+}
