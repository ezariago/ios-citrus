+			rec.ipi_rc = rc;
+			rec.sig0 = sig0;
+			rec.pend0 = pend0;
+			rec.active0 = active0;
+			rec.enable0 = enable0;
+			rec.waker0 = waker0;
+			rec.thr0 = (uint64_t)(uintptr_t)thr;
