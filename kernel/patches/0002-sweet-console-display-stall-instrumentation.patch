+static void
+sweet_obs_thread(void *arg __unused, wait_result_t result __unused)
+{
+	cpu_data_t *wat = cpu_datap(0);
+	cpu_data_t *self = getCpuDatap();
+	uint32_t wat_mpidr = (uint32_t)ml_get_topology_info()->cpus[0].phys_id;
+	uint64_t last_timer = 0, last_ipi = 0, last_ns = 0, stall_ns = 0, seq = 0;
+	uint64_t last_persist_ns = 0, last_line_ns = 0;
+
