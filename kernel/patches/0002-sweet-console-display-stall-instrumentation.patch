+static int sweet_panel_mode = -1;
+int sweet_console_hold;
+
+/* Parsed on first use: the recorder thread used to set this only at ~36 s, so
+ * every earlier probe run drew nothing and the panel test proved nothing. */
+static bool
+sweet_panel_on(void)
+{
+	/*
+	 * Only ever resolved in thread context (sweet_ufs_init / the recorder
+	 * thread). PE_parse_boot_argn must not be called from a timer
+	 * interrupt early in boot: doing that killed every boot within a few
+	 * seconds before the first log flush. Unknown means "do nothing".
+	 */
+	return sweet_panel_mode > 0;
+}
+
+/* Pixel drawing is level 2: level 1 only counts probe runs so a boot can be
+ * observed without touching the framebuffer at all. */
+static bool
+sweet_panel_draw(void)
+{
+	return sweet_panel_on() && sweet_panel_mode >= 2;
+}
+
+/*
+ * Writing the flight recorder from a timer interrupt is only safe when no
+ * driver command is outstanding: ufs_scsi() owns exactly one UTRL slot, one
+ * UCD and one bounce buffer, and it takes no lock the interrupt path could
+ * respect. If a real I/O is in flight when the probe rings the doorbell, the
+ * probe overwrites that command's UTRD, so the waiting thread sees the probe's
+ * completion (or none) and the slot state is garbage. That is a prime suspect
+ * for the ~36 s freeze. Boot with sweetirqwr=0 to disable the interrupt-side
+ * writes while keeping the lock-free panel output and the thread heartbeat.
+ */
+static int sweet_irq_writes = -1;
+static bool
+sweet_irq_ufs_writes(void)
+{
+	if (sweet_irq_writes < 0) {
+		int v = 1;
+		/* Thread context only: see sweet_panel_on(). */
+		PE_parse_boot_argn("sweetirqwr", &v, sizeof(v));
+		sweet_irq_writes = v;
+	}
+	return sweet_irq_writes != 0;
+}
+
+/* Called once from sweet_ufs_init, in thread context. */
+static void
+sweet_irq_writes_resolve(void)
+{
+	PE_parse_boot_argn("sweetvrecord", &sweet_vtimer_record, sizeof(sweet_vtimer_record));
+	if (sweet_irq_writes < 0) {
+		int v = 1;
+		PE_parse_boot_argn("sweetirqwr", &v, sizeof(v));
+		sweet_irq_writes = v;
+	}
+	if (sweet_panel_mode < 0) {
+		int v = 0;
+		PE_parse_boot_argn("sweetpanel", &v, sizeof(v));
+		sweet_panel_mode = v;
+	}
+}
