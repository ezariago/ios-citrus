+	se = ml_io_map(0x04a88000u, 0x4000);
+	if (!se) {
+		printf("CITRUS TOUCH: SE2 mapping failed\n");
+		goto out;
+	}
+	uint32_t fw = touch_rd(se, 0x68);
+	uint32_t protocol = (fw >> 8) & 0xffu; /* geni_se_protocol: SPI=1 */
+	printf("CITRUS TOUCH: SE2 fw=%#x protocol=%u sfw=%#x status=%#x hwtx=%#x hwrx=%#x\n",
+	    fw, protocol, touch_rd(se, 0x6c), touch_rd(se, 0x40),
+	    touch_rd(se, 0xe24), touch_rd(se, 0xe28));
+	printf("CITRUS TOUCH: SPI firmware %s; no transaction attempted\n",
+	    protocol == 1 ? "present" : "not established");
+out:
+	printf("CITRUS TOUCH: probe finished; touchscreen input remains disabled\n");
