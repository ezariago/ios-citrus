+/*
+ * Give up on slot 0 and reinitialize the transfer list. Clearing the doorbell
+ * alone is not enough: the device may still deliver the abandoned completion
+ * later. Stop the ring, drain the doorbell, let any response already on the
+ * link land while the ring is stopped, then publish the list again. A late
+ * response is additionally rejected by the task-tag check in ufs_scsi().
+ */
+static int
+ufs_ring_restart(void)
+{
+	uint64_t list = su.dma_pa + DMA_UTRL;
+	uint64_t deadline, now;
+
+	nanoseconds_to_absolutetime(RING_STOP_NS, &deadline);
+	deadline += mach_absolute_time();
+
+	ufs_wr(REG_UTRLRSR, 0);
+	__builtin_arm_dsb(0xf);
+	while ((ufs_rd(REG_UTRLRSR) & 1) && (now = mach_absolute_time()) < deadline) {
+		delay(1);
+	}
+	ufs_wr(REG_UTRLCLR, ~0u);
+	__builtin_arm_dsb(0xf);
+	while (ufs_rd(REG_UTRLDBR) && (now = mach_absolute_time()) < deadline) {
+		delay(1);
+	}
+	if (ufs_rd(REG_UTRLDBR)) {
+		printf("SWEET UFS: ring would not drain (dbr 0x%x hcs 0x%x)\n",
+		    ufs_rd(REG_UTRLDBR), ufs_rd(REG_HCS));
+		return ETIMEDOUT;
+	}
+
+	/*
+	 * The doorbell is clear but the device can still be finishing the old
+	 * command. It must finish before slot 0 is reused, otherwise its response
+	 * could overwrite the next command's UTRD/UCD.
+	 */
+	delay(RING_DRAIN_MS);
+	ufs_wr(REG_UTRLCLR, ~0u);
+	ufs_wr(REG_IS, ufs_rd(REG_IS));
+	__builtin_arm_dsb(0xf);
+
+	ufs_wr(REG_UTRLBA, (uint32_t)list);
+	ufs_wr(REG_UTRLBAU, (uint32_t)(list >> 32));
+	ufs_wr(REG_UTRLRSR, 1);
+	__builtin_arm_dsb(0xf);
+	if (ufs_rd(REG_UTRLBA) != (uint32_t)list ||
+	    ufs_rd(REG_UTRLBAU) != (uint32_t)(list >> 32) ||
+	    !(ufs_rd(REG_UTRLRSR) & 1)) {
+		printf("SWEET UFS: ring restart failed (ba 0x%x%08x rsr 0x%x)\n",
+		    ufs_rd(REG_UTRLBAU), ufs_rd(REG_UTRLBA), ufs_rd(REG_UTRLRSR));
+		return EIO;
+	}
+	return 0;
 }
 
