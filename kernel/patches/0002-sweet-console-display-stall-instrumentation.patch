+		obs = cpu_to_processor(SWEET_OBS_CPU);
+		if (obs == NULL) {
+			assert_wait_timeout((event_t)&sweet_obs_thread, THREAD_UNINT,
+			    1, NSEC_PER_SEC);
+			thread_block(THREAD_CONTINUE_NULL);
+		}
+	}
+
+	/* thread_bind() takes effect when the thread is next made runnable, so
+	 * check the CPU after blocking once. */
+	if (obs != NULL && cpu_number() != SWEET_OBS_CPU) {
+		thread_bind(obs);
+		thread_block(THREAD_CONTINUE_NULL);
+	}
+
+	if (cpu_number() != SWEET_OBS_CPU) {
+		static const char msg[] =
+		    "SWEET OBS: could not run on CPU 1; observer disabled\n";
+		sweet_log_append(msg, (int)sizeof(msg) - 1);
