+/* "op=0x28 w len=131072 age=3400ms n=1234" (empty when the driver is idle). */
+int sweet_ufs_op_string(char *buf, int max);
+
+int
+sweet_ufs_op_string(char *buf, int max)
+{
+	if (!sweet_cur_op.active) {
+		return snprintf(buf, max, "idle");
+	}
+	uint64_t ns = 0;
+	if (mach_absolute_time() > sweet_cur_op.start) {
+		absolutetime_to_nanoseconds(mach_absolute_time() - sweet_cur_op.start, &ns);
+	}
+	return snprintf(buf, max, "op=0x%02x%s len=%u age=%llums n=%llu",
+	    sweet_cur_op.cdb0, sweet_cur_op.write ? "w" : "r", sweet_cur_op.len,
+	    ns / 1000000ull, sweet_cur_op.seq);
