+/*
+ * Interrupt-context stall probe. When every thread stops making progress the
+ * scheduler cannot run any watchdog, so this runs from a timer_call (which
+ * always keeps a decrementer deadline armed) and reads the pc that
+ * rtclock_intr recorded for the interrupted thread. It reports twice:
+ *  - to the panel, by printing to the kernel console and pointing the MDP back
+ *    at the console frame, which needs no scheduler, locks or disk;
+ *  - to a ring of blocks below the heartbeat block, when no thread is inside
+ *    the UFS driver.
+ */
+#define SWEET_STALL_SLOTS       16
+#define SWEET_STALL_AFTER_NS    10000000000ull   /* 10 s without progress */
+#define SWEET_STALL_EVERY_NS     5000000000ull   /* probe period */
+#define SWEET_STALL_VERSION      1u
+
+struct sweet_stall {
+	char magic[8];
+	uint32_t version;
+	uint32_t slot;
+	uint64_t seq;
+	uint64_t uptime_s;
+	uint64_t stall_s;
+	uint64_t pc;            /* interrupted pc: kernel VA if in the kernel */
+	uint64_t last_pc;       /* pc of the previous sample */
+	char name[16];          /* process name of the interrupted thread */
+	uint64_t console_bytes;
+	uint64_t ufs_ios;
+	uint64_t free_pages;
+	uint64_t ufs_users;
+};
+
+/* Set by rtclock_intr (osfmk/arm/rtclock.c) before it runs the timer queue. */
+uintptr_t sweet_intr_pc;
+
+static void sweet_stall_probe(void);
+extern void sweet_fb_show_console(void);
+extern void sweet_console_force(const char *s, int len);
+
+static int sweet_panel_mode;
+int sweet_console_hold;
+
+/*
+ * Called from rtclock_intr (osfmk/arm/rtclock.c) on every timer interrupt, in
+ * interrupt context, with the interrupted pc. rtclock also keeps a 1 Hz tick
+ * armed (see there) because timer_call callbacks never run on this port:
+ * ml_timer_evaluate() is empty, so only thread-wakeup deadlines are serviced.
+ */
+void
+sweet_stall_service(uintptr_t pc)
+{
+	uint64_t step, ns;
+	static int shown;
+	static uint64_t next_service;
+	uint64_t now;
+
+	sweet_intr_pc = pc;
+	nanoseconds_to_absolutetime(SWEET_STALL_EVERY_NS, &step);
+	now = mach_absolute_time();
+	if (now < next_service) {
+		return;
+	}
+	next_service = now + step;
+
+	if (sweet_panel_mode) {
+		/* Prove from the first firing that this path reaches the panel. */
+		char line[96];
+		absolutetime_to_nanoseconds(now, &ns);
+		int n = snprintf(line, sizeof(line), "SWEET PANEL t=%llus ufs=%llu c=%llu\n",
+		    ns / 1000000000ull, os_atomic_load(&sweet_ufs_users, relaxed),
+		    os_atomic_load(&sweet_other_bytes, relaxed));
+		sweet_in_probe = 1;
+		printf("%s", line);
+		sweet_console_force(line, n);
+		sweet_in_probe = 0;
+		sweet_fb_show_console();
+		sweet_console_hold = 1;   /* keep the console frame on the panel */
+		shown = 1;
+		(void)shown;
+	}
+	sweet_stall_probe();
+}
+
+static void
+sweet_stall_probe(void)
+{
+	static uint64_t idle_since, last_sample, samples;
+	static uint64_t last_out, last_ios, prev_pc;
+	uint64_t now = mach_absolute_time();
+	uint64_t step, idle_ns;
+
+	if (sweet_hb_base == 0) {
+		return;
+	}
+	uint64_t out = os_atomic_load(&sweet_other_bytes, relaxed);
+	uint64_t ios = os_atomic_load(&sweet_ufs_ios, relaxed);
+	if (out != last_out || ios != last_ios) {
+		last_out = out;
+		last_ios = ios;
+		idle_since = 0;
+		return;
+	}
+	if (idle_since == 0) {
+		idle_since = now;
+		return;
+	}
+	absolutetime_to_nanoseconds(now - idle_since, &idle_ns);
+	if (idle_ns < SWEET_STALL_AFTER_NS) {
+		return;
+	}
+	nanoseconds_to_absolutetime(SWEET_STALL_EVERY_NS, &step);
+	if (now - last_sample < step) {
+		return;
+	}
+	last_sample = now;
+
+	uintptr_t pc = sweet_intr_pc;
+	uint64_t users = os_atomic_load(&sweet_ufs_users, relaxed);
+	struct sweet_stall st = {
+		.magic = { 'S', 'W', 'E', 'E', 'T', 'S', 'T', 'L' },
+		.version = SWEET_STALL_VERSION,
+		.slot = (uint32_t)(samples % SWEET_STALL_SLOTS),
+		.seq = ++samples,
+		.stall_s = idle_ns / 1000000000ull,
+		.pc = pc,
+		.last_pc = prev_pc,
+		.console_bytes = out,
+		.ufs_ios = ios,
+		.free_pages = vm_page_free_count,
+		.ufs_users = users,
+	};
+	prev_pc = pc;
+	uint64_t ns;
+	absolutetime_to_nanoseconds(now, &ns);
+	st.uptime_s = ns / 1000000000ull;
+	proc_selfname(st.name, sizeof(st.name));
+
+	/*
+	 * Panel first: this must work even when the compositor, the disk and the
+	 * scheduler are gone. printf draws into the console shadow; the hook
+	 * points the display at it with register writes only.
+	 */
+	char line[160];
+	int n = snprintf(line, sizeof(line),
+	    "SWEET STALL %llus stall=%llus ufs=%llu pc=0x%llx last=0x%llx %s\n",
+	    st.uptime_s, st.stall_s, users, (uint64_t)pc, (uint64_t)prev_pc, st.name);
+	sweet_in_probe = 1;
+	printf("%s", line);
+	sweet_console_force(line, n);
+	sweet_in_probe = 0;
+	sweet_fb_show_console();
+
+	/* Then persist it, if no thread is inside the driver right now. */
+	if (users == 0) {
+		void *bounce = (void *)(su.dma + DMA_BOUNCE);
+		bzero(bounce, UFS_BLOCK);
+		memcpy(bounce, &st, sizeof(st));
+		if (ufs_write_blocks(sweet_hb_base - 1 - (st.slot % SWEET_STALL_SLOTS), 1) == 0) {
+			(void)ufs_sync_cache();
+		}
+	}
+}
+
+static void
+sweet_hb_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	void *bounce = (void *)(su.dma + DMA_BOUNCE);
+	struct sweet_heartbeat old;
+	int error;
+
+	sweet_hb_base = su.first_block + su.nblocks - SWEET_LOG_BLOCKS - 1;
+	bzero(&old, sizeof(old));
+	SWEET_UFS_LOCK();
+	error = ufs_read_blocks(sweet_hb_base, 1);
+	if (!error) {
+		memcpy(&old, bounce, sizeof(old));
+	}
+	SWEET_UFS_UNLOCK();
+
+	if (error == 0 && memcmp(old.magic, "SWEETHB1", 8) == 0 && old.version == SWEET_HB_VERSION) {
+		sweet_hb_prev.boot_id = old.boot_id + 1;
+		sweet_hb_prev.prev_boot_id = old.boot_id;
+		sweet_hb_prev.prev_phase = old.phase;
+		sweet_hb_prev.prev_uptime_s = old.uptime_s;
+		sweet_hb_prev.prev_console_bytes = old.console_bytes;
+		sweet_hb_prev.prev_console_seq = old.console_seq;
+		sweet_hb_prev.prev_ufs_ios = old.ufs_ios;
+		sweet_hb_prev.prev_flush_runs = old.flush_runs;
+	} else {
+		sweet_hb_prev.boot_id = 1;
+	}
+	sweet_hb_write(SWEET_HB_RUNNING, false);
+	PE_parse_boot_argn("sweetpanel", &sweet_panel_mode, sizeof(sweet_panel_mode));
+	for (;;) {
+		(void)tsleep(&sweet_hb_chan, PZERO, "sweethb", hz * SWEET_HB_SECS);
+		sweet_hb_write(SWEET_HB_RUNNING, false);
+	}
+}
