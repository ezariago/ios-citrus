+#define SE_SPI_CPOL      0x230u
+#define SE_SPI_DEMUX_INV 0x24cu
+#define SE_SPI_DEMUX_SEL 0x250u
+#define SE_SPI_TRANS_CFG 0x25cu
+#define SE_SPI_WORD_LEN  0x268u
+#define SE_SPI_TX_LEN    0x26cu
+#define SE_SPI_RX_LEN    0x270u
+#define SE_SPI_DELAYS    0x278u
+#define SE_CLK_SEL       0x07cu
+#define SE_SER_M_CLK     0x048u
+#define SE_M_CMD0        0x600u
+#define SE_M_CMD_CTRL    0x604u
+#define SE_M_IRQ         0x610u
+#define SE_M_IRQ_EN      0x614u
+#define SE_M_IRQ_CLR     0x618u
+#define SE_TX_FIFO       0x700u
+#define SE_RX_FIFO       0x780u
+#define SE_TX_FIFO_ST    0x800u
+#define SE_RX_FIFO_ST    0x804u
+#define SE_TX_WM         0x80cu
+#define SE_M_IRQ_DONE    (1u << 0)
+#define SE_M_IRQ_ERR     ((1u << 1) | (1u << 2) | (1u << 3) | (1u << 4) | \
+                          (1u << 5)) /* overrun/illegal/failure/cancel/abort */
+#define SE_PACKING_4X8_0 0x0007f8feu
+#define SE_PACKING_4X8_1 0x000ffefeu
+
+static void
+citrus_gpio(vm_offset_t tile, unsigned pin, unsigned mux, unsigned pull,
+    unsigned drive, bool out, bool high)
+{
+	uint32_t cfg = touch_rd(tile, CITRUS_GPIO_CFG(pin));
+	uint32_t io = touch_rd(tile, CITRUS_GPIO_IO(pin));
+	/* TLMM: IO bit0 = input value (read-only), bit1 = output latch,
+	 * CFG bit9 = output enable. Writing bit0 left reset asserted. */
+	io = (io & ~2u) | (high ? 2u : 0u);
+	touch_wr(tile, CITRUS_GPIO_IO(pin), io);
+	cfg &= ~0x3ffu;
+	cfg |= (mux << 2) | pull | (drive << 6) | (out ? 0x200u : 0u);
+	touch_wr(tile, CITRUS_GPIO_CFG(pin), cfg);
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
+/*
+ * FT8719 SPI transport, following the vendor
+ * drivers/input/touchscreen/FT8719/focaltech_spi.c:
+ *  - every package is sent as two GENI fragments: the package byte alone,
+ *    a 30 us gap, then the payload (CS stays asserted via FRAGMENTATION);
+ *  - responses are shifted by that first byte;
+ *  - READ_CMD (0xA0) appends a little-endian CRC16/Kermit over the payload;
+ *  - the boot ID is write[0x55]+data[0xAA], 12 ms, read[0x90 0 0 0] -> 2 B.
+ * All waits are bounded; a failed engine is cancelled and not retried.
+ */
+#define CITRUS_FTS_STATUS  0x05u
+#define CITRUS_FTS_CMD     0xC0u
+#define CITRUS_FTS_DATA    0x3Fu
+#define CITRUS_FTS_READ    0xA0u
+#define CITRUS_FTS_GAP_US  30u
+#define CITRUS_FTS_MAX     64u
+
+static void
+citrus_fts_crc(const uint8_t *data, unsigned len, uint16_t *crc_out)
+{
+	uint16_t crc = 0xffffu;
+	for (unsigned i = 0; i < len; i++) {
+		crc ^= data[i];
+		for (unsigned j = 0; j < 8; j++) {
+			crc = (crc & 1u) ? (uint16_t)((crc >> 1) ^ 0x8408u)
+					 : (uint16_t)(crc >> 1);
+		}
+	}
+	*crc_out = crc;
+}
+
+/* One GENI FIFO command. fragment=true keeps CS asserted for the next one. */
+static bool
+citrus_spi_cmd(vm_offset_t se, const uint8_t *tx, uint8_t *rx, unsigned len,
+    bool fragment)
+{
+	uint32_t irq = 0;
+	unsigned i, j, words = (len + 3u) / 4u;
+	bool done = false;
+
+	if (len == 0 || len > CITRUS_FTS_MAX) {
+		return false;
+	}
+	/* Do not gate on M_GENI_CMD_ACTIVE: the vendor spi-geni driver never
+	 * reads it before submitting, and ABL leaves it set on this SE. The
+	 * probe cancels/aborts that stale state once before the first command. */
+	touch_wr(se, SE_M_IRQ_CLR, 0xffffffffu);
+	/* Vendor order: lengths and watermark, start the command, then fill
+	 * the FIFO (spi_geni_handle_tx). */
+	touch_wr(se, SE_TX_WM, 1);
+	touch_wr(se, SE_SPI_TX_LEN, len);
+	touch_wr(se, SE_SPI_RX_LEN, len);
+	touch_wr(se, SE_M_CMD0, (3u << 27) | (fragment ? (1u << 2) : 0));
+	for (i = 0; i < len; i += 4) {
+		uint32_t w = 0;
+		for (j = 0; j < 4 && i + j < len; j++) {
+			w |= (uint32_t)tx[i + j] << (8u * j);
+		}
+		touch_wr(se, SE_TX_FIFO, w);
+	}
+	for (i = 0; i < 2000; i++) {
+		irq = touch_rd(se, SE_M_IRQ);
+		if (irq & SE_M_IRQ_ERR) {
+			break;
+		}
+		if (irq & SE_M_IRQ_DONE) {
+			done = true;
+			break;
+		}
+		delay(10);
+	}
+	if (done) {
+		for (i = 0; i < words; i++) {
+			uint32_t w = touch_rd(se, SE_RX_FIFO);
+			for (j = 0; j < 4 && i * 4u + j < len; j++) {
+				rx[i * 4u + j] = (uint8_t)(w >> (8u * j));
+			}
+		}
+	} else {
+		printf("CITRUS TOUCH: SE2 cmd len=%u frag=%u irq=%#x status=%#x\n",
+		    len, fragment ? 1u : 0u, irq, touch_rd(se, 0x40));
+	}
+	touch_wr(se, SE_M_IRQ_CLR, 0xffffffffu);
+	return done;
+}
+
+/* Two-fragment FTS package. */
+static bool
+citrus_fts_xfer(vm_offset_t se, const uint8_t *tx, uint8_t *rx, unsigned len)
+{
+	if (!citrus_spi_cmd(se, tx, rx, 1, len > 1)) {
+		return false;
+	}
+	if (len > 1) {
+		delay(CITRUS_FTS_GAP_US);
+		if (!citrus_spi_cmd(se, tx + 1, rx + 1, len - 1, false)) {
+			return false;
+		}
+	}
+	delay(150); /* vendor CS_HIGH_DELAY */
+	return true;
+}
+
+/* 0x05 status package: the chip status is the second byte. */
+static bool
+citrus_fts_status(vm_offset_t se, uint8_t *status)
+{
+	uint8_t tx[2] = {CITRUS_FTS_STATUS, 0x00};
+	uint8_t rx[2] = {0, 0};
+	if (!citrus_fts_xfer(se, tx, rx, sizeof(tx))) {
+		return false;
+	}
+	*status = rx[1];
+	return true;
+}
+
+/* Vendor fts_write(): command package, then an optional data package. */
+static bool
+citrus_fts_write(vm_offset_t se, uint8_t cmd, const uint8_t *data,
+    unsigned dlen)
+{
+	uint8_t tx[CITRUS_FTS_MAX], rx[CITRUS_FTS_MAX];
+	unsigned n = 0;
+
+	if (dlen > 4) {
+		return false;
+	}
+	memset(tx, 0, sizeof(tx));
+	memset(rx, 0, sizeof(rx));
+	tx[n++] = CITRUS_FTS_CMD;
+	tx[n++] = 0x00u | 1u; /* WRITE_CMD | cmdlen */
+	tx[n++] = cmd;
+	if (!citrus_fts_xfer(se, tx, rx, n)) {
+		return false;
+	}
+	if (!data || !dlen) {
+		return true;
+	}
+	touch_wait(1);
+	memset(tx, 0, sizeof(tx));
+	memset(rx, 0, sizeof(rx));
+	n = 0;
+	tx[n++] = CITRUS_FTS_DATA;
+	for (unsigned i = 0; i < dlen; i++) {
+		tx[n++] = data[i];
+	}
+	return citrus_fts_xfer(se, tx, rx, n);
+}
+
+/* Vendor fts_read(): command package, then a data package with CRC. */
+static bool
+citrus_fts_read(vm_offset_t se, const uint8_t *cmd, unsigned cmdlen,
+    uint8_t *data, unsigned dlen, bool fw_running)
+{
+	uint8_t tx[CITRUS_FTS_MAX], rx[CITRUS_FTS_MAX];
+	unsigned n = 0, pkg = cmdlen + (fw_running ? 2u : 0u);
+	uint16_t crc = 0, want;
+
+	if (cmdlen == 0 || dlen == 0 || dlen > CITRUS_FTS_MAX - 8u ||
+	    pkg > 15u) {
+		return false;
+	}
+	memset(tx, 0, sizeof(tx));
+	memset(rx, 0, sizeof(rx));
+	tx[n++] = CITRUS_FTS_CMD;
+	tx[n++] = CITRUS_FTS_READ | pkg;
+	for (unsigned i = 0; i < cmdlen; i++) {
+		tx[n++] = cmd[i];
+	}
+	if (fw_running) {
+		tx[n++] = (uint8_t)(dlen >> 8);
+		tx[n++] = (uint8_t)dlen;
+	}
+	if (!citrus_fts_xfer(se, tx, rx, n)) {
+		return false;
+	}
+	touch_wait(1); /* let the IC prepare the response */
+	memset(tx, 0, sizeof(tx));
+	memset(rx, 0, sizeof(rx));
+	n = dlen + 3u; /* data package byte + payload + 2 CRC bytes */
+	tx[0] = CITRUS_FTS_DATA;
+	if (!citrus_fts_xfer(se, tx, rx, n)) {
+		return false;
+	}
+	memcpy(data, rx + 1, dlen);
+	citrus_fts_crc(rx + 1, dlen, &crc);
+	want = (uint16_t)rx[dlen + 1] | ((uint16_t)rx[dlen + 2] << 8);
+	if (crc != want) {
+		printf("CITRUS TOUCH: FTS crc calc=%#x read=%#x raw=%02x %02x %02x %02x %02x %02x %02x %02x\n",
+		    crc, want, rx[0], rx[1], rx[2], rx[3], rx[4], rx[5],
+		    rx[6], rx[7]);
+		return false;
+	}
+	return true;
+}
+
+/*
+ * Program gcc_qupv3_wrap0_s2_clk_src to the vendor's 6 MHz selection:
+ * 48 MHz from P_GPLL0_OUT_AUX2 (300 MHz * 4/25), pre-div 1, dual-edge M/N.
+ * clk-rcg2 requires force-enable (CMD_ROOT_EN, bit 1) around the update.
+ * CFG = pre_div 1 | src 2 << 8 | CFG_MODE_DUAL_EDGE 2 << 12.
+ * M = 4, N = ~(25 - 4), D = ~25.
+ */
+static bool
+citrus_se_clock_48m(vm_offset_t gcc)
+{
+	uint32_t cfg_before = touch_rd(gcc, TOUCH_RCG + 4u);
+	uint32_t cmd = touch_rd(gcc, TOUCH_RCG);
+	bool updated = false;
+
+	touch_wr(gcc, TOUCH_RCG, cmd | (1u << 1)); /* force enable */
+	touch_wr(gcc, TOUCH_RCG + 0x8u, 4u);
+	touch_wr(gcc, TOUCH_RCG + 0xcu, 0xffeau);
+	touch_wr(gcc, TOUCH_RCG + 0x10u, 0xffe6u);
+	touch_wr(gcc, TOUCH_RCG + 4u, 0x2201u);
+	touch_wr(gcc, TOUCH_RCG, (1u << 1) | (1u << 0)); /* ROOT_EN | UPDATE */
+	for (unsigned i = 0; i < 1000; i++) {
+		if (!(touch_rd(gcc, TOUCH_RCG) & 1u)) {
+			updated = true;
+			break;
+		}
+		delay(1);
+	}
+	touch_wr(gcc, TOUCH_RCG, 0); /* clear force enable */
+	__asm__ volatile("dsb sy" ::: "memory");
+	printf("CITRUS TOUCH: RCG 48M cfg=%#x->%#x updated=%d root_off=%u\n",
+	    cfg_before, touch_rd(gcc, TOUCH_RCG + 4u), updated,
+	    (touch_rd(gcc, TOUCH_RCG) >> 31) & 1u);
+	return updated && !(touch_rd(gcc, TOUCH_RCG) & (1u << 31));
+}
+
+/* Internal loopback: proves the sequencer, serial clock and FIFO packing. */
+static bool
+citrus_spi_loopback_test(vm_offset_t se)
+{
+	static const uint8_t ltx[4] = {0xa5, 0x5a, 0x3c, 0xc3};
+	uint8_t lrx[4] = {0, 0, 0, 0};
+	bool l;
+
+	touch_wr(se, SE_SPI_LOOPBACK, 1);
+	l = citrus_spi_cmd(se, ltx, lrx, sizeof(ltx), false);
+	printf("CITRUS TOUCH: SPI loopback ok=%d sel=%#x mclk=%#x rx=%02x %02x %02x %02x\n",
+	    l, touch_rd(se, SE_CLK_SEL), touch_rd(se, SE_SER_M_CLK),
+	    lrx[0], lrx[1], lrx[2], lrx[3]);
+	touch_wr(se, SE_SPI_LOOPBACK, 0);
+	return l;
+}
+
+/*
+ * First real SPI milestone: mux the QUP0 SE2 pins, pulse the FT8719 reset,
+ * then run the vendor status + boot-ID protocol on the polled GENI engine.
+ * No interrupt handler, no DMA, no firmware upload, no HID data.
+ */
+static void
+citrus_touch_spi_probe(vm_offset_t gcc, bool do_spi)
+{
+	vm_offset_t west, south, se;
+	uint8_t status = 0xff;
+	bool ok = false;
+	unsigned i;
+
+	west = ml_io_map(CITRUS_WEST_PA, 0x80000);
+	south = ml_io_map(CITRUS_SOUTH_PA, 0x80000);
+	se = ml_io_map(0x04a88000u, 0x4000);
+	if (!west || !south || !se) {
+		printf("CITRUS TOUCH: TLMM/SE2 mapping failed west=%d south=%d se=%d\n",
+		    west != 0, south != 0, se != 0);
+		return;
+	}
+	/* All four SPI pins are QUP0 SE2 mux 1 on WEST. */
+	citrus_gpio(west, CITRUS_PIN_MOSI, 1, 0, 3, false, false);
+	citrus_gpio(west, CITRUS_PIN_MISO, 1, 0, 3, false, false);
+	citrus_gpio(west, CITRUS_PIN_CLK,  1, 0, 3, false, false);
+	citrus_gpio(west, CITRUS_PIN_CS0,  1, 0, 3, false, false);
+	/* IRQ stays GPIO input, no pull; not used for the probe. */
+	citrus_gpio(west, CITRUS_PIN_IRQ, 0, 0, 0, false, false);
+	/* Reset is active low on SOUTH tile. */
+	citrus_gpio(south, CITRUS_PIN_RESET, 0, 0, 0, true, true);
+	touch_wait(1);
+	citrus_gpio(south, CITRUS_PIN_RESET, 0, 0, 0, true, false);
+	touch_wait(2);
+	citrus_gpio(south, CITRUS_PIN_RESET, 0, 0, 0, true, true);
+	touch_wait(120);
+	printf("CITRUS TOUCH: SPI pins muxed, reset released: cfg103=%#x io103=%#x irq_io=%#x\n",
+	    touch_rd(south, CITRUS_GPIO_CFG(CITRUS_PIN_RESET)),
+	    touch_rd(south, CITRUS_GPIO_IO(CITRUS_PIN_RESET)),
+	    touch_rd(west, CITRUS_GPIO_IO(CITRUS_PIN_IRQ)));
+	if (!do_spi) {
+		printf("CITRUS TOUCH: pinmux/reset-only mode; SE2 untouched\n");
+		return;
+	}
+	printf("CITRUS TOUCH: SE2 pre status=%#x irq=%#x\n",
+	    touch_rd(se, 0x40), touch_rd(se, SE_M_IRQ));
+
+	/*
+	 * Vendor geni_se_io_init() (qcom-geni-se.c). The decisive one is
+	 * GENI_FORCE_DEFAULT (0x20 = 1): it resets the sequencer, which is
+	 * what clears the command ABL left active. Without it, the first
+	 * submission overruns (M_IRQ bit 1) or is ignored (irq 0).
+	 */
+	touch_wr(se, 0x28, touch_rd(se, 0x28) | 0x7fu);   /* GENI_CGC_CTRL */
+	touch_wr(se, 0xe30, touch_rd(se, 0xe30) | 0x0fu); /* DMA general cfg */
+	touch_wr(se, 0x24, 0x7fu);                        /* GENI_OUTPUT_CTRL */
+	touch_wr(se, 0x20, 1u);                           /* FORCE_DEFAULT */
+	delay(100);
+	printf("CITRUS TOUCH: SE2 reset status=%#x irq=%#x force=%#x\n",
+	    touch_rd(se, 0x40), touch_rd(se, SE_M_IRQ), touch_rd(se, 0x20));
+	/* FIFO mode selection: no GSI/DMA, clear all GENI IRQ state. */
+	touch_wr(se, 0xe18, 0);
+	touch_wr(se, 0x640, 0xffffffffu); /* S_IRQ_CLEAR */
+	touch_wr(se, SE_M_IRQ_CLR, 0xffffffffu);
+
+	/* FIFO mode, 4x8 packing, 8-bit words, SPI mode 0, CS0. */
+	touch_wr(se, SE_DMA_MODE, 0);
+	touch_wr(se, SE_TX_PACK0, SE_PACKING_4X8_0);
+	touch_wr(se, SE_TX_PACK1, SE_PACKING_4X8_1);
+	touch_wr(se, SE_RX_PACK0, SE_PACKING_4X8_0);
+	touch_wr(se, SE_RX_PACK1, SE_PACKING_4X8_1);
+	touch_wr(se, SE_BYTE_GRAN, 0);
+	touch_wr(se, SE_SPI_WORD_LEN, 4);       /* (8 bits - MIN_WORD_LEN) */
+	touch_wr(se, SE_SPI_LOOPBACK, 0);
+	touch_wr(se, SE_SPI_DEMUX_SEL, 0);
+	touch_wr(se, SE_SPI_DEMUX_INV, 0);
+	touch_wr(se, SE_SPI_CPHA, 0);
+	touch_wr(se, SE_SPI_CPOL, 0);
+	touch_wr(se, SE_SPI_TRANS_CFG, 0);
+	touch_wr(se, SE_SPI_DELAYS, 0);
+	/*
+	 * Vendor geni_se_init(): the RX ready-for-receive watermark is flow
+	 * control, not an interrupt threshold. Left at 0 the RX FIFO reports
+	 * full after the first word, so a full-duplex command starts (status
+	 * 0x41) and never reaches DONE. RX depth is 16 words -> 14.
+	 */
+	touch_wr(se, 0x810, 0);
+	touch_wr(se, 0x814, 14u);
+	touch_wr(se, 0xe1c, 0x0cu); /* SE_IRQ_EN: GENI M|S */
+	/*
+	 * Attempt 1: RCG is parked at CXO 19.2 MHz (CFG 0x100000), which is
+	 * DFS level 2; serial divider 4 gives 4.8 MHz.
+	 * Attempt 2 (vendor path for the DT's 6 MHz): RCG 48 MHz, DFS level 5,
+	 * serial divider 8 -> 6 MHz. Two GENI streams can hang, so try both.
+	 */
+	uint32_t mclk0 = touch_rd(se, SE_SER_M_CLK);
+	touch_wr(se, SE_CLK_SEL, 2);
+	touch_wr(se, SE_SER_M_CLK, 0x41u);
+	printf("CITRUS TOUCH: SE2 cfg word_len=%#x pack=%#x/%#x clk_sel=%#x ser_m_clk=%#x->%#x status=%#x\n",
+	    touch_rd(se, SE_SPI_WORD_LEN), touch_rd(se, SE_TX_PACK0),
+	    touch_rd(se, SE_RX_PACK0), touch_rd(se, SE_CLK_SEL), mclk0,
+	    touch_rd(se, SE_SER_M_CLK), touch_rd(se, 0x40));
+	touch_wr(se, SE_M_IRQ_CLR, 0xffffffffu);
+	touch_wr(se, SE_M_IRQ_EN, SE_M_IRQ_DONE | SE_M_IRQ_ERR);
+	touch_wr(se, SE_TX_WM, 0);
+	/*
+	 * ABL can leave the primary sequencer marked active with no pending
+	 * IRQ. Cancel, then abort, with bounded waits; continue either way
+	 * because the vendor driver does not treat this bit as a gate.
+	 */
+	if (touch_rd(se, 0x40) & 1u) {
+		printf("CITRUS TOUCH: SE2 stale active, cancelling status=%#x\n",
+		    touch_rd(se, 0x40));
+		touch_wr(se, SE_M_CMD_CTRL, 4); /* cancel */
+		for (i = 0; i < 200 && !(touch_rd(se, SE_M_IRQ) & (1u << 4)); i++) {
+			delay(100);
+		}
+		touch_wr(se, SE_M_CMD_CTRL, 2); /* abort */
+		for (i = 0; i < 200 && !(touch_rd(se, SE_M_IRQ) & (1u << 5)); i++) {
+			delay(100);
+		}
+		touch_wr(se, SE_M_IRQ_CLR, 0xffffffffu);
+		printf("CITRUS TOUCH: SE2 after cancel/abort status=%#x irq=%#x\n",
+		    touch_rd(se, 0x40), touch_rd(se, SE_M_IRQ));
+	}
+	/*
+	 * Control: internal SPI loopback. If the GENI sequencer and serial
+	 * clock run, the received bytes are the transmitted ones regardless of
+	 * the FT8719, its power or the pin mux. A failure here is upstream of
+	 * the touch IC. Try the CXO clock plan first, then the vendor 48 MHz
+	 * plan (a command that never clocks leaves the sequencer active, so
+	 * the second attempt starts with a fresh FORCE_DEFAULT).
+	 */
+	bool loop_ok = citrus_spi_loopback_test(se);
+	if (!loop_ok) {
+		touch_wait(20);
+		if (citrus_se_clock_48m(gcc)) {
+			touch_wr(se, 0x20, 1u); /* FORCE_DEFAULT again */
+			delay(100);
+			touch_wr(se, SE_CLK_SEL, 5);
+			touch_wr(se, SE_SER_M_CLK, 0x81u);
+			delay(100);
+			loop_ok = citrus_spi_loopback_test(se);
+		}
+	}
+	if (!loop_ok) {
+		printf("CITRUS TOUCH: SPI loopback failed on both clock plans\n");
+	}
+	touch_wait(1);
+	/*
+	 * The chip answers every read with 0x08, which looks like its status
+	 * byte rather than data: it is not ready. Sweep CPHA and the serial
+	 * divider with a status package before trusting any register read.
+	 * mclk 0x41 = 19.2/4 (4.8 MHz), 0x101 = 19.2/16 (1.2 MHz); a result
+	 * with (status & 0x81) == 0x01 or 0x00 is idle.
+	 */
+	{
+		static const unsigned cphas[2] = {0, 1};
+		static const uint32_t mclks[2] = {0x41u, 0x101u};
+		for (unsigned ci = 0; ci < 2; ci++) {
+			for (unsigned mi = 0; mi < 2; mi++) {
+				uint8_t s = 0xff;
+				bool sok = false;
+				touch_wr(se, SE_SPI_CPHA, cphas[ci]);
+				touch_wr(se, SE_SER_M_CLK, mclks[mi]);
+				delay(1000);
+				for (unsigned t = 0; t < 4; t++) {
+					sok = citrus_fts_status(se, &s);
+					if (sok && ((s & 0x81u) == 1u ||
+					    (s & 0x81u) == 0u)) {
+						break;
+					}
+					delay(150);
+				}
+				printf("CITRUS TOUCH: status sweep cpha=%u mclk=%#x ok=%d status=%#x\n",
+				    cphas[ci], mclks[mi], sok, s);
+			}
+		}
+		touch_wr(se, SE_SPI_CPHA, 0);
+		touch_wr(se, SE_SER_M_CLK, 0x41u);
+	}
+
+	for (i = 0; i < 3; i++) {
+		ok = citrus_fts_status(se, &status);
+		printf("CITRUS TOUCH: FTS status try=%u ok=%d status=%#x irq=%#x\n",
+		    i, ok, status, touch_rd(se, SE_M_IRQ));
+		if (ok) {
+			break;
+		}
+		touch_wait(5);
+	}
+	if (!ok) {
+		printf("CITRUS TOUCH: SPI status failed; no chip ID attempt\n");
+		goto abort;
+	}
+	{
+		/*
+		 * After reset the FT8719 runs its factory firmware, so the
+		 * normal register reads use the fw-running framing (two length
+		 * bytes). 0xA3/0x9F are the chip-ID pair the vendor's
+		 * fts_wait_tp_to_valid() polls; 0xA6/0xA8 add firmware/vendor.
+		 */
+		static const uint8_t reg_idh[1] = {0xa3};
+		static const uint8_t reg_idl[1] = {0x9f};
+		static const uint8_t reg_fw[1] = {0xa6};
+		static const uint8_t reg_vendor[1] = {0xa8};
+		uint8_t idh = 0, idl = 0, fw = 0, vendor = 0;
+		bool a = citrus_fts_read(se, reg_idh, 1, &idh, 1, true);
+		bool b = a && citrus_fts_read(se, reg_idl, 1, &idl, 1, true);
+		bool c = b && citrus_fts_read(se, reg_fw, 1, &fw, 1, true);
+		bool d = c && citrus_fts_read(se, reg_vendor, 1, &vendor, 1, true);
+
+		printf("CITRUS TOUCH: FTS normal id ok=%d/%d/%d/%d id=%02x%02x fw=%02x vendor=%02x\n",
+		    a, b, c, d, idh, idl, fw, vendor);
+	}
+	{
+		/*
+		 * Fallback: the boot-ROM ID path. _FT8719 = 0x8719080D has
+		 * FLAG_IDC_BIT (bit 11) set, so is_incell is true and the
+		 * vendor uses FTS_CMD_READ_ID_LEN_INCELL = 1 (0x90 only).
+		 */
+		static const uint8_t idcmd[1] = {0x90};
+		const uint8_t start = 0xaa;
+		uint8_t id[2] = {0, 0};
+		bool w = citrus_fts_write(se, 0x55, &start, 1);
+
+		printf("CITRUS TOUCH: FTS boot start ok=%d\n", w);
+		touch_wait(12);
+		bool r = w && citrus_fts_read(se, idcmd, sizeof(idcmd), id,
+		    sizeof(id), false);
+		printf("CITRUS TOUCH: FTS boot id ok=%d id=%02x%02x (%s)\n",
+		    r, id[0], id[1],
+		    (id[0] == 0x87 && (id[1] == 0x19 || id[1] == 0xa9 ||
+		    id[1] == 0xb9)) ? "FT8719" : "unexpected");
+	}
+abort:
+	printf("CITRUS TOUCH: SPI end irq=%#x status=%#x txcount=%#x rxcount=%#x\n",
+	    touch_rd(se, SE_M_IRQ), touch_rd(se, 0x40),
+	    touch_rd(se, SE_TX_FIFO_ST), touch_rd(se, SE_RX_FIFO_ST));
+	touch_wr(se, SE_M_IRQ_CLR, 0xffffffffu);
+	touch_wr(se, SE_TX_WM, 0);
+	if (!ok || (touch_rd(se, 0x40) & 1u)) {
+		touch_wr(se, SE_M_CMD_CTRL, 4); /* cancel */
+		delay(100);
+		touch_wr(se, SE_M_CMD_CTRL, 2); /* abort */
+	}
+}
+
+/*
+ * Mode 7: the vendor focaltech_flash.c boot path.
+ *
+ * The FT8719 has no non-volatile application store. After reset its boot ROM
+ * listens on SPI; the vendor driver then downloads
+ * /vendor/firmware/focaltech_ts_fw.bin into PRAM before the touch application
+ * runs (FTS_AUTO_UPGRADE_EN=1 and FTS_FW_REQUEST_SUPPORT=1 in
+ * focaltech_config.h, and the OrangeFox "juice" recovery tree ships exactly
+ * that file). A chip left in boot ROM answers its status byte (0x08) to every
+ * package, which is what modes 4/6 observed.
+ *
+ * Protocol, from drivers/input/touchscreen/FT8719/focaltech_*.c at 02ca1a919564:
+ *  - fts_wait_idle(): poll the 0x05 status package before every package;
+ *    boot mode is idle at (status & 0x81) == 0x00, app mode at == 0x01.
+ *  - fts_enter_into_boot(): reset (1 ms low), 8 ms, write 0x55, 8 ms, read
+ *    0x90 into two bytes; 30 outer x 3 inner attempts.
+ *  - download: 0xAE, then a data package of addr[2:0] + len[1:0] + payload.
+ *  - fts_pram_start(): command 0x08, then app framing (length bytes + CRC).
+ * `setting_nf` for rom id 0x8719 is {app2 64K, ecclen 128K, delay 8, spi_pe,
+ * fd_check, no dram}: only the PRAM slice is written and the DRAM half is not
+ * used. The ECC self-check is skipped; the start is verified by reading the
+ * application chip id instead.
+ */
+#define CITRUS7_STATUS    0x05u
+#define CITRUS7_CMD       0xC0u
+#define CITRUS7_DATA      0x3Fu
+#define CITRUS7_READ      0xA0u
+#define CITRUS7_ROM_WRITE 0xAEu
+#define CITRUS7_ROM_START 0x08u
+#define CITRUS7_CHUNK     48u  /* FIFO is 16 x 4 B; packet stays at 14 words */
+#define CITRUS7_POLL_US   150u
+#define CITRUS7_POLLS     100u
+
+/* Vendor fts_wait_idle(): the status package is a 2-byte transaction. */
+static bool
+citrus7_wait_idle(vm_offset_t se, bool fw_running, uint8_t *out)
+{
+	uint8_t status = 0xff;
+	unsigned i;
+
+	for (i = 0; i < CITRUS7_POLLS; i++) {
+		delay(CITRUS7_POLL_US);
+		if (!citrus_fts_status(se, &status)) {
+			continue;
+		}
+		if ((status & 0x81u) == (fw_running ? 0x01u : 0x00u)) {
+			if (out) {
+				*out = status;
+			}
+			return true;
+		}
+	}
+	if (out) {
+		*out = status;
+	}
+	return false;
+}
+
+/* Vendor fts_boot_write(): idle, command package, idle, data package. */
+static bool
+citrus7_write(vm_offset_t se, uint8_t cmd, const uint8_t *data, unsigned dlen)
+{
+	uint8_t tx[CITRUS_FTS_MAX], rx[CITRUS_FTS_MAX];
+	unsigned n = 0;
+
+	if (dlen > CITRUS_FTS_MAX - 8u) {
+		return false;
+	}
+	if (!citrus7_wait_idle(se, false, NULL)) {
+		printf("CITRUS TOUCH: mode7 write %02x: chip never idle\n", cmd);
+		return false;
+	}
+	tx[n++] = CITRUS7_CMD;
+	tx[n++] = 0x00u | 1u; /* WRITE_CMD | one command byte */
+	tx[n++] = cmd;
+	if (!citrus_fts_xfer(se, tx, rx, n)) {
+		printf("CITRUS TOUCH: mode7 write %02x: command package failed\n", cmd);
+		return false;
+	}
+	if (!data || !dlen) {
+		return true;
+	}
+	if (!citrus7_wait_idle(se, false, NULL)) {
+		printf("CITRUS TOUCH: mode7 write %02x: busy before data\n", cmd);
+		return false;
+	}
+	memset(tx, 0, sizeof(tx));
+	memset(rx, 0, sizeof(rx));
+	n = 0;
+	tx[n++] = CITRUS7_DATA;
+	memcpy(tx + n, data, dlen);
+	n += dlen;
+	if (!citrus_fts_xfer(se, tx, rx, n)) {
+		printf("CITRUS TOUCH: mode7 write %02x: data package failed\n", cmd);
+		return false;
+	}
+	return true;
+}
+
+/* Vendor fts_read(): idle, command package, idle, data package with CRC. */
+static bool
+citrus7_read(vm_offset_t se, uint8_t cmd, uint8_t *data, unsigned dlen,
+    bool fw_running)
+{
+	uint8_t tx[CITRUS_FTS_MAX], rx[CITRUS_FTS_MAX];
+	uint16_t crc = 0, want;
+	unsigned n = 0, pkg;
+
+	if (dlen == 0 || dlen > 16u) {
+		return false;
+	}
+	pkg = 1u + (fw_running ? 2u : 0u);
+	if (!citrus7_wait_idle(se, fw_running, NULL)) {
+		return false;
+	}
+	tx[n++] = CITRUS7_CMD;
+	tx[n++] = (uint8_t)(CITRUS7_READ | pkg);
+	tx[n++] = cmd;
+	if (fw_running) {
+		tx[n++] = (uint8_t)(dlen >> 8);
+		tx[n++] = (uint8_t)(dlen & 0xffu);
+	}
+	if (!citrus_fts_xfer(se, tx, rx, n)) {
+		return false;
+	}
+	if (!citrus7_wait_idle(se, fw_running, NULL)) {
+		return false;
+	}
+	memset(tx, 0, sizeof(tx));
+	memset(rx, 0, sizeof(rx));
+	n = dlen + 3u; /* data package byte + payload + 2 CRC bytes */
+	tx[0] = CITRUS7_DATA;
+	if (!citrus_fts_xfer(se, tx, rx, n)) {
+		return false;
+	}
+	memcpy(data, rx + 1, dlen);
+	citrus_fts_crc(rx + 1, dlen, &crc);
+	want = (uint16_t)rx[dlen + 1] | ((uint16_t)rx[dlen + 2] << 8);
+	if (crc != want) {
+		printf("CITRUS TOUCH: mode7 read %02x crc=%#x/%#x raw=%02x %02x %02x %02x\n",
+		    cmd, crc, want, rx[0], rx[1], rx[2], rx[3]);
+		return false;
+	}
+	return true;
+}
+
+/* Reset with the vendor timing: 1 ms low, then settle. */
+static void
+citrus7_reset(vm_offset_t south, unsigned settle_ms)
+{
+	citrus_gpio(south, CITRUS_PIN_RESET, 0, 3, 8, true, false);
+	touch_wait(1);
+	citrus_gpio(south, CITRUS_PIN_RESET, 0, 3, 8, true, true);
+	touch_wait(settle_ms);
+}
+
+/* geni_se_io_init + SPI setup, identical to the working mode-4/6 path. */
+static void
+citrus7_se_init(vm_offset_t se)
+{
+	touch_wr(se, 0x28, touch_rd(se, 0x28) | 0x7fu);   /* GENI_CGC_CTRL */
+	touch_wr(se, 0xe30, touch_rd(se, 0xe30) | 0x0fu); /* DMA general cfg */
+	touch_wr(se, 0x24, 0x7fu);                        /* GENI_OUTPUT_CTRL */
+	touch_wr(se, 0x20, 1u);                           /* FORCE_DEFAULT */
+	delay(100);
+	touch_wr(se, 0xe18, 0);                           /* FIFO mode */
+	touch_wr(se, 0x640, 0xffffffffu);                 /* S_IRQ_CLEAR */
+	touch_wr(se, SE_M_IRQ_CLR, 0xffffffffu);
+	touch_wr(se, SE_DMA_MODE, 0);
+	touch_wr(se, SE_TX_PACK0, SE_PACKING_4X8_0);
+	touch_wr(se, SE_TX_PACK1, SE_PACKING_4X8_1);
+	touch_wr(se, SE_RX_PACK0, SE_PACKING_4X8_0);
+	touch_wr(se, SE_RX_PACK1, SE_PACKING_4X8_1);
+	touch_wr(se, SE_BYTE_GRAN, 0);
+	touch_wr(se, SE_SPI_WORD_LEN, 4);                 /* 8 bits - 4 */
+	touch_wr(se, SE_SPI_LOOPBACK, 0);
+	touch_wr(se, SE_SPI_DEMUX_SEL, 0);
+	touch_wr(se, SE_SPI_DEMUX_INV, 0);
+	touch_wr(se, SE_SPI_CPHA, 0);
+	touch_wr(se, SE_SPI_CPOL, 0);
+	touch_wr(se, SE_SPI_TRANS_CFG, 0);
+	touch_wr(se, SE_SPI_DELAYS, 0);
+	touch_wr(se, 0x810, 0);                           /* RX watermark */
+	touch_wr(se, 0x814, 14u);                         /* RX RFR watermark */
+	touch_wr(se, 0xe1c, 0x0cu);                       /* SE_IRQ_EN M|S */
+	touch_wr(se, SE_CLK_SEL, 2);                      /* 19.2 MHz DFS level */
+	touch_wr(se, SE_SER_M_CLK, 0x41u);                /* 19.2 / 4 = 4.8 MHz */
+	touch_wr(se, SE_M_IRQ_CLR, 0xffffffffu);
+	touch_wr(se, SE_M_IRQ_EN, SE_M_IRQ_DONE | SE_M_IRQ_ERR);
+	touch_wr(se, SE_TX_WM, 1);
+}
+
+/* Write the PRAM application slice, then start it. */
+static bool
+citrus7_download(vm_offset_t se)
+{
+	uint32_t addr = 0;
+	unsigned packets = 0;
+
+	while (addr < citrus_ft8719_fw_len) {
+		uint8_t pkt[5u + CITRUS7_CHUNK];
+		unsigned n = citrus_ft8719_fw_len - addr;
+
+		if (n > CITRUS7_CHUNK) {
+			n = CITRUS7_CHUNK;
+		}
+		pkt[0] = (uint8_t)(addr >> 16);
+		pkt[1] = (uint8_t)(addr >> 8);
+		pkt[2] = (uint8_t)addr;
+		pkt[3] = (uint8_t)(n >> 8);
+		pkt[4] = (uint8_t)(n & 0xffu);
+		memcpy(pkt + 5, citrus_ft8719_fw + addr, n);
+		if (!citrus7_write(se, CITRUS7_ROM_WRITE, pkt, n + 5u)) {
+			printf("CITRUS TOUCH: mode7 fw write failed at %#x (%u/%u)\n",
+			    addr, addr, citrus_ft8719_fw_len);
+			return false;
+		}
+		addr += n;
+		if ((++packets & 0x7fu) == 0) {
+			printf("CITRUS TOUCH: mode7 fw %u/%u\n", addr,
+			    citrus_ft8719_fw_len);
+			touch_wait(0); /* yield; do not spin the CPU for seconds */
+		}
+	}
+	return true;
+}
+
+/* Mode 7 entry: pads, reset, boot handshake, firmware, application id. */
+static void
+citrus_touch_vendor_bringup(void)
+{
+	vm_offset_t west, south, se;
+	uint8_t status = 0xff, id[2] = {0, 0};
+	bool boot = false;
+	unsigned attempt, inner;
+
+	west = ml_io_map(CITRUS_WEST_PA, 0x80000);
+	south = ml_io_map(CITRUS_SOUTH_PA, 0x80000);
+	se = ml_io_map(0x04a88000u, 0x4000);
+	if (!west || !south || !se) {
+		printf("CITRUS TOUCH: mode7 mapping failed west=%d south=%d se=%d\n",
+		    west != 0, south != 0, se != 0);
+		return;
+	}
+	/* MOSI/MISO/CLK and CS0 are QUP0 SE2 mux 1; the live DTB gives pins
+	 * 6/7/71 and 80, pull-down, 6 mA. INT is GPIO93 and reset GPIO103;
+	 * the pmx_ts_* pinctrl groups name stale pins 80/71 and are not used. */
+	citrus_gpio(west, CITRUS_PIN_MOSI, 1, 1, 3, false, false);
+	citrus_gpio(west, CITRUS_PIN_MISO, 1, 1, 3, false, false);
+	citrus_gpio(west, CITRUS_PIN_CLK,  1, 1, 3, false, false);
+	citrus_gpio(west, CITRUS_PIN_CS0,  1, 3, 3, false, false);
+	citrus_gpio(west, CITRUS_PIN_IRQ,  0, 3, 8, false, false);
+	citrus7_reset(south, 12);
+	printf("CITRUS TOUCH: mode7 pads irq93=%#x reset103=%#x/%#x\n",
+	    touch_rd(west, CITRUS_GPIO_IO(CITRUS_PIN_IRQ)),
+	    touch_rd(south, CITRUS_GPIO_CFG(CITRUS_PIN_RESET)),
+	    touch_rd(south, CITRUS_GPIO_IO(CITRUS_PIN_RESET)));
+	citrus7_se_init(se);
+	if (citrus7_wait_idle(se, false, &status)) {
+		printf("CITRUS TOUCH: mode7 pre-handshake status=%#x (boot idle)\n",
+		    status);
+	} else {
+		printf("CITRUS TOUCH: mode7 pre-handshake status=%#x (not boot idle)\n",
+		    status);
+	}
+	/* fts_enter_into_boot(): 30 outer attempts, 3 reads each, reset per try. */
+	for (attempt = 0; attempt < 30 && !boot; attempt++) {
+		uint8_t last[2] = {0xee, 0xee};
+		bool got = false;
+
+		citrus7_reset(south, 8);
+		for (inner = 0; inner < 3 && !boot; inner++) {
+			uint8_t id2[2] = {0, 0};
+
+			if (!citrus7_write(se, 0x55, NULL, 0)) {
+				continue;
+			}
+			touch_wait(8);
+			if (!citrus7_read(se, 0x90, id2, 2, false)) {
+				continue;
+			}
+			last[0] = id2[0];
+			last[1] = id2[1];
+			got = true;
+			if (id2[0] == 0x87 && (id2[1] == 0x19 || id2[1] == 0xa9 ||
+			    id2[1] == 0xb9)) {
+				id[0] = id2[0];
+				id[1] = id2[1];
+				boot = true;
+			}
+		}
+		printf("CITRUS TOUCH: mode7 enter-boot try=%u id=%02x%02x ok=%d\n",
+		    attempt, last[0], last[1], got);
+	}
+	if (!boot) {
+		printf("CITRUS TOUCH: mode7 boot ROM never returned an FT8719 id;"
+		    " no download\n");
+		if (citrus7_wait_idle(se, true, &status)) {
+			printf("CITRUS TOUCH: mode7 app-idle status=%#x\n", status);
+		} else {
+			printf("CITRUS TOUCH: mode7 status=%#x (neither mode idle)\n",
+			    status);
+		}
+		goto out;
+	}
+	printf("CITRUS TOUCH: mode7 boot ROM id=%02x%02x; downloading %u bytes\n",
+	    id[0], id[1], citrus_ft8719_fw_len);
+	if (!citrus7_download(se)) {
+		goto out;
+	}
+	printf("CITRUS TOUCH: mode7 pram written; starting application\n");
+	if (!citrus7_write(se, CITRUS7_ROM_START, NULL, 0)) {
+		goto out;
+	}
+	touch_wait(50);
+	if (citrus7_wait_idle(se, true, &status)) {
+		printf("CITRUS TOUCH: mode7 application idle status=%#x\n", status);
+	} else {
+		printf("CITRUS TOUCH: mode7 application not idle status=%#x\n", status);
+	}
+	{
+		uint8_t chip = 0, fwver = 0;
+		bool a = citrus7_read(se, 0xa3, &chip, 1, true); /* chip id */
+		bool b = a && citrus7_read(se, 0xa6, &fwver, 1, true);
+
+		printf("CITRUS TOUCH: mode7 app chip=%#x ok=%d fw=%#x ok=%d\n",
+		    chip, a, fwver, b);
+	}
+	printf("CITRUS TOUCH: mode7 irq93=%#x\n",
+	    touch_rd(west, CITRUS_GPIO_IO(CITRUS_PIN_IRQ)));
+out:
+	touch_wr(se, SE_M_IRQ_CLR, 0xffffffffu);
+	touch_wr(se, SE_TX_WM, 0);
+}
+
+/*
+ * Mode 8: discriminate where the 0x08/0xEEEE boot-ID answer comes from.
+ *
+ * touchprobe15 proved the status byte changes from 0x00 (fresh reset) to 0x08
+ * as soon as a 0x55 start command is sent, so CS/clock/MOSI are not obviously
+ * dead. Mode 8 runs four handshake variants and then repeats the same
+ * handshake by bit-banging GPIO6/7/71/80, with no GENI involvement:
+ *   A  probe path  : 0x55 + data 0xAA, 12 ms, read 0x90 (1-byte command)
+ *   A4             : same, but 0x90 00 00 00 (non-incell command length)
+ *   B  upgrade path: 0x55 alone, 8 ms, read 0x90
+ *   C  float test  : reset held low, status + 0x90 while the IC is off
+ *   D  no start    : reset released, read 0x90 without any start command
+ *   BB bit-bang    : A repeated on plain GPIO, 500 kHz, manual CS
+ * If C still reads 0x08 the value is an artefact, not the chip. If BB returns
+ * 0x8719 the GENI setup is wrong; if BB also returns 0x08 the IC is not
+ * executing the handshake (CS/MOSI/power or a different boot protocol).
+ */
+#define CITRUS8_BB_MOSI CITRUS_PIN_MOSI
+#define CITRUS8_BB_MISO CITRUS_PIN_MISO
+#define CITRUS8_BB_CLK  CITRUS_PIN_CLK
+#define CITRUS8_BB_CS   CITRUS_PIN_CS0
+
+/* Clear whatever ABL or a failed submission left active in the sequencer. */
+static void
+citrus_touch_se_recover(vm_offset_t se)
+{
+	unsigned i;
+
+	if (!(touch_rd(se, 0x40) & 1u)) {
+		return;
+	}
+	touch_wr(se, SE_M_CMD_CTRL, 4u); /* cancel */
+	for (i = 0; i < 200 && !(touch_rd(se, SE_M_IRQ) & (1u << 4)); i++) {
+		delay(100);
+	}
+	touch_wr(se, SE_M_CMD_CTRL, 2u); /* abort */
+	for (i = 0; i < 200 && !(touch_rd(se, SE_M_IRQ) & (1u << 5)); i++) {
+		delay(100);
+	}
+	touch_wr(se, SE_M_IRQ_CLR, 0xffffffffu);
+	touch_wr(se, SE_TX_WM, 1);
+	printf("CITRUS TOUCH: mode8 recover status=%#x irq=%#x\n",
+	    touch_rd(se, 0x40), touch_rd(se, SE_M_IRQ));
+}
+
+/* One status package, raw, no idle wait: prints both reply bytes. */
+static void
+citrus8_status(vm_offset_t se, const char *tag)
+{
+	static const uint8_t tx[2] = {CITRUS7_STATUS, 0x00};
+	uint8_t rx[2] = {0, 0};
+
+	if (citrus_fts_xfer(se, tx, rx, sizeof(tx))) {
+		printf("CITRUS TOUCH: mode8 %s status=%02x %02x\n", tag, rx[0], rx[1]);
+	} else {
+		printf("CITRUS TOUCH: mode8 %s status: transfer failed\n", tag);
+	}
+}
+
+/* Read package, raw, prints every received byte. */
+static void
+citrus8_read(vm_offset_t se, const char *tag, uint8_t cmd, unsigned cmdlen,
+    unsigned dlen, bool fw_running)
+{
+	uint8_t tx[CITRUS_FTS_MAX] = {0}, rx[CITRUS_FTS_MAX] = {0};
+	unsigned n = 0, i;
+
+	if (cmdlen == 0 || cmdlen > 4 || dlen == 0 || dlen > 8) {
+		printf("CITRUS TOUCH: mode8 %s: bad lengths\n", tag);
+		return;
+	}
+	tx[n++] = CITRUS7_CMD;
+	tx[n++] = (uint8_t)(CITRUS7_READ | (cmdlen + (fw_running ? 2u : 0u)));
+	for (i = 0; i < cmdlen; i++) {
+		tx[n++] = (i == 0) ? cmd : 0;
+	}
+	if (fw_running) {
+		tx[n++] = (uint8_t)(dlen >> 8);
+		tx[n++] = (uint8_t)(dlen & 0xffu);
+	}
+	if (!citrus_fts_xfer(se, tx, rx, n)) {
+		printf("CITRUS TOUCH: mode8 %s: command phase failed\n", tag);
+		return;
+	}
+	touch_wait(1);
+	memset(tx, 0, sizeof(tx));
+	memset(rx, 0, sizeof(rx));
+	n = dlen + 3u;
+	tx[0] = CITRUS7_DATA;
+	if (!citrus_fts_xfer(se, tx, rx, n)) {
+		printf("CITRUS TOUCH: mode8 %s: data phase failed\n", tag);
+		return;
+	}
+	printf("CITRUS TOUCH: mode8 %s:", tag);
+	for (i = 0; i < dlen + 3u; i++) {
+		printf(" %02x", rx[i]);
+	}
+	printf("\n");
+}
+
+/* Bit-bang: plain GPIO, mode 0, manual CS. */
+static void
+citrus8_bb_set(vm_offset_t west, unsigned pin, bool out, bool high)
+{
+	citrus_gpio(west, pin, 0, 3, 3, out, high);
+}
+
+static uint8_t
+citrus8_bb_byte(vm_offset_t west, unsigned mosi, unsigned miso,
+    uint8_t value, bool cpha1)
+{
+	uint8_t rx = 0;
+	int bit;
+
+	for (bit = 7; bit >= 0; bit--) {
+		if (!cpha1) {
+			citrus8_bb_set(west, mosi, true, (value >> bit) & 1u);
+			delay(1);
+			citrus8_bb_set(west, CITRUS8_BB_CLK, true, true);
+			delay(1);
+			rx = (uint8_t)((rx << 1) |
+			    (touch_rd(west, CITRUS_GPIO_IO(miso)) & 1u));
+			citrus8_bb_set(west, CITRUS8_BB_CLK, true, false);
+			delay(1);
+		} else {
+			citrus8_bb_set(west, CITRUS8_BB_CLK, true, true);
+			delay(1);
+			citrus8_bb_set(west, mosi, true, (value >> bit) & 1u);
+			delay(1);
+			citrus8_bb_set(west, CITRUS8_BB_CLK, true, false);
+			delay(1);
+			rx = (uint8_t)((rx << 1) |
+			    (touch_rd(west, CITRUS_GPIO_IO(miso)) & 1u));
+		}
+	}
+	return rx;
+}
+
+static void
+citrus8_bb_xfer(vm_offset_t west, unsigned mosi, unsigned miso, const char *tag,
+    const uint8_t *tx, unsigned n, uint8_t *rx, bool cpha1)
+{
+	unsigned i;
+
+	citrus8_bb_set(west, CITRUS8_BB_CS, true, false); /* select */
+	delay(2);
+	for (i = 0; i < n; i++) {
+		rx[i] = citrus8_bb_byte(west, mosi, miso, tx[i], cpha1);
+		if (i == 0 && n > 1) {
+			delay(30);
+		}
+	}
+	citrus8_bb_set(west, CITRUS8_BB_CS, true, true); /* deselect */
+	delay(150);
+	printf("CITRUS TOUCH: mode8 %s bb:", tag);
+	for (i = 0; i < n; i++) {
+		printf(" %02x", rx[i]);
+	}
+	printf("\n");
+}
+
+/* Pull test: a pad driven by the IC ignores a weak pull, a floating pad
+ * follows it. This finds the IC's MISO output without driving any pad. */
+static void
+citrus8_levels(vm_offset_t west, const char *tag)
+{
+	static const unsigned pins[] = {CITRUS_PIN_MOSI, CITRUS_PIN_MISO,
+	    CITRUS_PIN_CLK, CITRUS_PIN_CS0, CITRUS_PIN_IRQ};
+	static const unsigned pulls[] = {0u, 1u, 3u}; /* none, down, up */
+	unsigned p, k, v[3];
+
+	printf("CITRUS TOUCH: mode8 levels %s\n", tag);
+	for (p = 0; p < sizeof(pins) / sizeof(pins[0]); p++) {
+		for (k = 0; k < 3; k++) {
+			citrus_gpio(west, pins[p], 0, pulls[k], 3, false, false);
+			delay(50);
+			v[k] = touch_rd(west, CITRUS_GPIO_IO(pins[p])) & 1u;
+		}
+		printf("   gpio%u none=%u down=%u up=%u%s\n", pins[p], v[0], v[1],
+		    v[2], (v[1] == v[2]) ? " DRIVEN" : "");
+	}
+}
+
+static void
+citrus_touch_bitbang_probe(void)
+{
+	vm_offset_t west, south;
+	static const uint8_t start[2] = {CITRUS7_STATUS, 0x00};
+	static const uint8_t boot_cmd[3] = {CITRUS7_CMD, 0x01, 0x55};
+	static const uint8_t boot_data[2] = {CITRUS7_DATA, 0xaa};
+	static const uint8_t rd_cmd[3] = {CITRUS7_CMD, 0xa1, 0x90};
+	static const uint8_t rd_data[5] = {CITRUS7_DATA, 0, 0, 0, 0};
+	unsigned mosi = CITRUS_PIN_MOSI, miso = CITRUS_PIN_MISO;
+	unsigned p, v[3];
+	uint8_t rx[8];
+
+	west = ml_io_map(CITRUS_WEST_PA, 0x80000);
+	south = ml_io_map(CITRUS_SOUTH_PA, 0x80000);
+	if (!west || !south) {
+		printf("CITRUS TOUCH: mode8 bit-bang mapping failed\n");
+		return;
+	}
+	/* The IC's MISO is the pad that ignores the pull. If the data pins are
+	 * the other way round, follow the hardware instead of the assumption. */
+	for (p = 0; p < 2; p++) {
+		unsigned pin = p == 0 ? CITRUS_PIN_MOSI : CITRUS_PIN_MISO;
+		citrus_gpio(west, pin, 0, 1, 3, false, false);
+		delay(50);
+		v[1] = touch_rd(west, CITRUS_GPIO_IO(pin)) & 1u;
+		citrus_gpio(west, pin, 0, 3, 3, false, false);
+		delay(50);
+		v[2] = touch_rd(west, CITRUS_GPIO_IO(pin)) & 1u;
+		if (v[1] == v[2] && pin == CITRUS_PIN_MOSI) {
+			miso = CITRUS_PIN_MOSI;
+			mosi = CITRUS_PIN_MISO;
+		}
+	}
+	printf("CITRUS TOUCH: mode8 bit-bang roles mosi=%u miso=%u\n", mosi, miso);
+
+	citrus8_bb_set(west, mosi, true, false);
+	citrus8_bb_set(west, CITRUS8_BB_CLK, true, false);
+	citrus8_bb_set(west, CITRUS8_BB_CS, true, true); /* deselected */
+	citrus8_bb_set(west, miso, false, false);
+	citrus7_reset(south, 20);
+	printf("CITRUS TOUCH: mode8 bit-bang start irq93=%#x\n",
+	    touch_rd(west, CITRUS_GPIO_IO(CITRUS_PIN_IRQ)) & 1u);
+	citrus8_bb_xfer(west, mosi, miso, "status c0", start, 2, rx, false);
+	citrus8_bb_xfer(west, mosi, miso, "status c1", start, 2, rx, true);
+	citrus8_bb_xfer(west, mosi, miso, "start55", boot_cmd, 3, rx, false);
+	delay(30);
+	citrus8_bb_xfer(west, mosi, miso, "dataAA", boot_data, 2, rx, false);
+	touch_wait(12);
+	citrus8_bb_xfer(west, mosi, miso, "read90", rd_cmd, 3, rx, false);
+	citrus8_bb_xfer(west, mosi, miso, "read90d", rd_data, 5, rx, false);
+	printf("CITRUS TOUCH: mode8 bit-bang done irq93=%#x\n",
+	    touch_rd(west, CITRUS_GPIO_IO(CITRUS_PIN_IRQ)) & 1u);
+}
+
+static void
+citrus_touch_handshake_variants(void)
+{
+	vm_offset_t west, south, se;
+
+	west = ml_io_map(CITRUS_WEST_PA, 0x80000);
+	south = ml_io_map(CITRUS_SOUTH_PA, 0x80000);
+	se = ml_io_map(0x04a88000u, 0x4000);
+	if (!west || !south || !se) {
+		printf("CITRUS TOUCH: mode8 mapping failed\n");
+		return;
+	}
+	/* All four SPI pads and the IRQ pad as plain inputs first: what does the
+	 * IC drive while it is out of reset and while it is held in reset? */
+	citrus_gpio(west, CITRUS_PIN_MOSI, 0, 0, 3, false, false);
+	citrus_gpio(west, CITRUS_PIN_MISO, 0, 0, 3, false, false);
+	citrus_gpio(west, CITRUS_PIN_CLK,  0, 0, 3, false, false);
+	citrus_gpio(west, CITRUS_PIN_CS0,  0, 0, 3, false, false);
+	citrus_gpio(west, CITRUS_PIN_IRQ,  0, 0, 8, false, false);
+	citrus_gpio(south, CITRUS_PIN_RESET, 0, 3, 8, true, true);
+	touch_wait(200);
+	citrus8_levels(west, "out-of-reset");
+	citrus_gpio(south, CITRUS_PIN_RESET, 0, 3, 8, true, false);
+	touch_wait(50);
+	citrus8_levels(west, "held-in-reset");
+	citrus_gpio(south, CITRUS_PIN_RESET, 0, 3, 8, true, true);
+	touch_wait(200);
+
+	/* Now the GENI path again, with the SE properly initialised. */
+	citrus_gpio(west, CITRUS_PIN_MOSI, 1, 1, 3, false, false);
+	citrus_gpio(west, CITRUS_PIN_MISO, 1, 1, 3, false, false);
+	citrus_gpio(west, CITRUS_PIN_CLK,  1, 1, 3, false, false);
+	citrus_gpio(west, CITRUS_PIN_CS0,  1, 3, 3, false, false);
+	citrus_gpio(west, CITRUS_PIN_IRQ,  0, 3, 8, false, false);
+	citrus7_se_init(se);
+	citrus_touch_se_recover(se);
+	citrus8_status(se, "geni+reset");
+	citrus8_read(se, "geni read90", 0x90, 1, 2, false);
+	citrus8_status(se, "geni again");
+	touch_wr(se, SE_M_IRQ_CLR, 0xffffffffu);
+	touch_wr(se, SE_TX_WM, 0);
+}
+
+/*
+ * Mode 9: bit-bang bring-up. touchprobe17 proved the transport and the pin
+ * roles: the FT8719's MISO is GPIO6 and its MOSI is GPIO7 (the board crosses
+ * the QUP2 data pair relative to our earlier assumption), CLK is GPIO71, CS0
+ * is GPIO80, reset is GPIO103. A 300 kHz bit-bang handshake returned
+ * 87 19 3c bc (FT8719 boot id plus a valid CRC16/0xbc3c) where GENI returned
+ * 08 08 08 08. So mode 9 uses plain GPIO for the whole vendor boot path:
+ * 0x55+0xAA -> 0x90 id -> PRAM download (0xAE packets) -> 0x08 start app ->
+ * application chip/firmware id.
+ */
+#define CITRUS9_MOSI 7u
+#define CITRUS9_MISO 6u
+#define CITRUS9_CHUNK 48u
+
+/* Fast bit-bang byte: the pads are already muxed to GPIO and set as outputs,
+ * so only the output latch (IO bit 1) changes per bit. citrus_gpio() would
+ * rewrite the configuration and take a dsb per bit; at ~300 kHz that made a
+ * 90-byte report read cost milliseconds and starved the rest of the kernel. */
+static uint8_t
+citrus9_bb_byte(vm_offset_t west, unsigned mosi, unsigned miso, uint8_t value)
+{
+	uint8_t rx = 0;
+	int bit;
+
+	for (bit = 7; bit >= 0; bit--) {
+		touch_wr(west, CITRUS_GPIO_IO(mosi),
+		    (value >> bit) & 1u ? 2u : 0u);
+		touch_wr(west, CITRUS_GPIO_IO(CITRUS8_BB_CLK), 2u);
+		rx = (uint8_t)((rx << 1) |
+		    (touch_rd(west, CITRUS_GPIO_IO(miso)) & 1u));
+		touch_wr(west, CITRUS_GPIO_IO(CITRUS8_BB_CLK), 0u);
+	}
+	return rx;
+}
+
+/* One package, quiet: CS low, first byte, 30 us, rest, CS high. */
+static bool
+citrus9_pkg(vm_offset_t west, const uint8_t *tx, unsigned n, uint8_t *rx)
+{
+	unsigned i;
+
+	if (n == 0 || n > CITRUS_FTS_MAX) {
+		return false;
+	}
+	citrus8_bb_set(west, CITRUS8_BB_CS, true, false);
+	delay(2);
+	for (i = 0; i < n; i++) {
+		rx[i] = citrus9_bb_byte(west, CITRUS9_MOSI, CITRUS9_MISO, tx[i]);
+		if (i == 0 && n > 1) {
+			delay(30);
+		}
+	}
+	citrus8_bb_set(west, CITRUS8_BB_CS, true, true);
+	delay(150);
+	return true;
+}
+
+/* Vendor fts_wait_idle() over bit-bang. */
+static bool
+citrus9_idle(vm_offset_t west, bool fw_running, uint8_t *out)
+{
+	uint8_t tx[2] = {CITRUS7_STATUS, 0x00};
+	uint8_t rx[2] = {0, 0};
+	unsigned i;
+
+	for (i = 0; i < 50; i++) {
+		if (!citrus9_pkg(west, tx, 2, rx)) {
+			return false;
+		}
+		if ((rx[1] & 0x81u) == (fw_running ? 0x01u : 0x00u)) {
+			if (out) {
+				*out = rx[1];
+			}
+			return true;
+		}
+		delay(150);
+	}
+	return false;
+}
+
+/*
+ * Vendor fts_write(): while the IC is in boot ROM, 0xAE/0x85/0xF2 carry six
+ * command bytes and 0xCC carries seven, i.e. the address/length parameters
+ * travel in the COMMAND package, and only the remaining bytes go in the data
+ * package. 0xAE with one command byte (what modes 7/9 v1 sent) is malformed:
+ * the ROM sees an address and length of zero.
+ */
+static bool
+citrus9_write(vm_offset_t west, uint8_t cmd, const uint8_t *data,
+    unsigned dlen, bool fw_running)
+{
+	uint8_t tx[CITRUS_FTS_MAX], rx[CITRUS_FTS_MAX];
+	unsigned cmdlen = 1, param, payload, n = 0;
+
+	if (!fw_running) {
+		if (cmd == 0xae || cmd == 0x85 || cmd == 0xf2) {
+			cmdlen = 6;
+		} else if (cmd == 0xcc) {
+			cmdlen = 7;
+		}
+	}
+	param = cmdlen - 1u;
+	if (dlen < param || dlen > CITRUS_FTS_MAX - 8u) {
+		return false;
+	}
+	payload = dlen - param;
+	if (!citrus9_idle(west, fw_running, NULL)) {
+		return false;
+	}
+	tx[n++] = CITRUS7_CMD;
+	tx[n++] = (uint8_t)(0x00u | cmdlen);
+	tx[n++] = cmd;
+	for (unsigned i = 0; i < param; i++) {
+		tx[n++] = data[i];
+	}
+	if (!citrus9_pkg(west, tx, n, rx)) {
+		return false;
+	}
+	if (!payload) {
+		return true;
+	}
+	if (!citrus9_idle(west, fw_running, NULL)) {
+		return false;
+	}
+	memset(tx, 0, sizeof(tx));
+	n = 0;
+	tx[n++] = CITRUS7_DATA;
+	memcpy(tx + n, data + param, payload);
+	n += payload;
+	return citrus9_pkg(west, tx, n, rx);
+}
+
+static bool
+citrus9_read(vm_offset_t west, uint8_t cmd, uint8_t *data, unsigned dlen,
+    bool fw_running)
+{
+	uint8_t tx[CITRUS_FTS_MAX], rx[CITRUS_FTS_MAX];
+	uint16_t crc = 0, want;
+	unsigned n = 0;
+
+	if (dlen == 0 || dlen > 16u) {
+		return false;
+	}
+	if (!citrus9_idle(west, fw_running, NULL)) {
+		printf("CITRUS TOUCH: mode9 read %02x: never idle\n", cmd);
+		return false;
+	}
+	tx[n++] = CITRUS7_CMD;
+	tx[n++] = (uint8_t)(CITRUS7_READ | (1u + (fw_running ? 2u : 0u)));
+	tx[n++] = cmd;
+	if (fw_running) {
+		tx[n++] = (uint8_t)(dlen >> 8);
+		tx[n++] = (uint8_t)(dlen & 0xffu);
+	}
+	if (!citrus9_pkg(west, tx, n, rx)) {
+		return false;
+	}
+	if (!citrus9_idle(west, fw_running, NULL)) {
+		printf("CITRUS TOUCH: mode9 read %02x: busy\n", cmd);
+		return false;
+	}
+	memset(tx, 0, sizeof(tx));
+	memset(rx, 0, sizeof(rx));
+	n = dlen + 3u;
+	tx[0] = CITRUS7_DATA;
+	if (!citrus9_pkg(west, tx, n, rx)) {
+		return false;
+	}
+	memcpy(data, rx + 1, dlen);
+	citrus_fts_crc(rx + 1, dlen, &crc);
+	want = (uint16_t)rx[dlen + 1] | ((uint16_t)rx[dlen + 2] << 8);
+	if (crc != want) {
+		printf("CITRUS TOUCH: mode9 read %02x crc=%#x/%#x raw=%02x %02x %02x %02x %02x\n",
+		    cmd, crc, want, rx[0], rx[1], rx[2], rx[3], rx[4]);
+		return false;
+	}
+	return true;
+}
+
+/* Status package, raw, no idle gate. */
+static void
+citrus9_status_raw(vm_offset_t west, const char *tag)
+{
+	uint8_t tx[2] = {CITRUS7_STATUS, 0x00};
+	uint8_t rx[2] = {0, 0};
+
+	if (citrus9_pkg(west, tx, 2, rx)) {
+		printf("CITRUS TOUCH: mode9 %s status=%02x %02x\n", tag, rx[0],
+		    rx[1]);
+	} else {
+		printf("CITRUS TOUCH: mode9 %s status: failed\n", tag);
+	}
+}
+
+/* Read package, raw: no idle gate, no CRC check, prints every byte. */
+static void
+citrus9_read_raw(vm_offset_t west, const char *tag, uint8_t cmd, unsigned cmdlen,
+    unsigned dlen, bool fw_running)
+{
+	uint8_t tx[16] = {0}, rx[16] = {0};
+	unsigned n = 0, i;
+
+	if (cmdlen == 0 || cmdlen > 4 || dlen == 0 || dlen > 8) {
+		return;
+	}
+	tx[n++] = CITRUS7_CMD;
+	tx[n++] = (uint8_t)(CITRUS7_READ | (cmdlen + (fw_running ? 2u : 0u)));
+	for (i = 0; i < cmdlen; i++) {
+		tx[n++] = (i == 0) ? cmd : 0;
+	}
+	if (fw_running) {
+		tx[n++] = (uint8_t)(dlen >> 8);
+		tx[n++] = (uint8_t)(dlen & 0xffu);
+	}
+	if (!citrus9_pkg(west, tx, n, rx)) {
+		return;
+	}
+	memset(tx, 0, sizeof(tx));
+	memset(rx, 0, sizeof(rx));
+	n = dlen + 3u;
+	tx[0] = CITRUS7_DATA;
+	if (!citrus9_pkg(west, tx, n, rx)) {
+		return;
+	}
+	printf("CITRUS TOUCH: mode9 %s raw:", tag);
+	for (i = 0; i < n; i++) {
+		printf(" %02x", rx[i]);
 	}
+	printf("\n");
+}
+
+/* Vendor fts_ecc_cal_host(): 16-bit-word CRC with poly 0x8408. */
+static uint16_t
+citrus9_ecc_host(const uint8_t *data, unsigned len)
+{
+	uint16_t ecc = 0;
+	unsigned i;
+	int j;
+
+	for (i = 0; i + 1u < len; i += 2) {
+		ecc ^= (uint16_t)(((uint16_t)data[i] << 8) | data[i + 1]);
+		for (j = 0; j < 16; j++) {
+			ecc = (ecc & 1u) ? (uint16_t)((ecc >> 1) ^ 0x8408u)
+					 : (uint16_t)(ecc >> 1);
+		}
+	}
+	return ecc;
+}
+
+/* Vendor fts_ecc_cal_tp(): 0xCC range, poll 0xCE == eccok, read 0xCD. */
+static bool
+citrus9_ecc_tp(vm_offset_t west, uint32_t addr, uint32_t len, uint16_t *out)
+{
+	uint8_t arg[6], v = 0xff, val[2] = {0, 0};
+	unsigned i;
+
+	arg[0] = (uint8_t)(addr >> 16);
+	arg[1] = (uint8_t)(addr >> 8);
+	arg[2] = (uint8_t)addr;
+	arg[3] = (uint8_t)(len >> 16);
+	arg[4] = (uint8_t)(len >> 8);
+	arg[5] = (uint8_t)len;
+	if (!citrus9_write(west, 0xcc, arg, sizeof(arg), false)) {
+		printf("CITRUS TOUCH: mode9 ecc command failed\n");
+		return false;
+	}
+	delay(2000);
+	for (i = 0; i < 100; i++) {
+		if (!citrus9_read(west, 0xce, &v, 1, false)) {
+			printf("CITRUS TOUCH: mode9 ecc finish read failed\n");
+			return false;
+		}
+		if (v == 0x00) {
+			break;
+		}
+		touch_wait(1);
+	}
+	if (i >= 100) {
+		printf("CITRUS TOUCH: mode9 ecc finish timeout value=%#x\n", v);
+		return false;
+	}
+	if (!citrus9_read(west, 0xcd, val, 2, false)) {
+		printf("CITRUS TOUCH: mode9 ecc value read failed\n");
+		return false;
+	}
+	*out = (uint16_t)(((uint16_t)val[0] << 8) | val[1]);
+	return true;
+}
+
+static bool
+citrus9_download(vm_offset_t west)
+{
+	uint32_t addr = 0;
+	unsigned packets = 0;
+
+	while (addr < citrus_ft8719_fw_len) {
+		uint8_t pkt[5u + CITRUS9_CHUNK];
+		unsigned n = citrus_ft8719_fw_len - addr;
+
+		if (n > CITRUS9_CHUNK) {
+			n = CITRUS9_CHUNK;
+		}
+		pkt[0] = (uint8_t)(addr >> 16);
+		pkt[1] = (uint8_t)(addr >> 8);
+		pkt[2] = (uint8_t)addr;
+		pkt[3] = (uint8_t)(n >> 8);
+		pkt[4] = (uint8_t)(n & 0xffu);
+		memcpy(pkt + 5, citrus_ft8719_fw + addr, n);
+		if (!citrus9_write(west, CITRUS7_ROM_WRITE, pkt, n + 5u, false)) {
+			printf("CITRUS TOUCH: mode9 fw write failed at %#x\n", addr);
+			return false;
+		}
+		addr += n;
+		if ((++packets & 0x7fu) == 0) {
+			printf("CITRUS TOUCH: mode9 fw %u/%u\n", addr,
+			    citrus_ft8719_fw_len);
+			touch_wait(0);
+		}
+	}
+	return true;
+}
+
+static bool
+citrus_touch_bitbang_bringup(void)
+{
+	vm_offset_t west, south;
+	uint8_t status = 0xff, id[2] = {0, 0};
+	uint8_t chip = 0, fwver = 0;
+	bool ok;
+
+	west = ml_io_map(CITRUS_WEST_PA, 0x80000);
+	south = ml_io_map(CITRUS_SOUTH_PA, 0x80000);
+	if (!west || !south) {
+		printf("CITRUS TOUCH: mode9 mapping failed\n");
+		return false;
+	}
+	citrus8_bb_set(west, CITRUS9_MOSI, true, false);
+	citrus8_bb_set(west, CITRUS8_BB_CLK, true, false);
+	citrus8_bb_set(west, CITRUS8_BB_CS, true, true);
+	citrus8_bb_set(west, CITRUS9_MISO, false, false);
+	citrus7_reset(south, 20);
+	printf("CITRUS TOUCH: mode9 start mosi=7 miso=6 cs=80 clk=71 irq93=%#x\n",
+	    touch_rd(west, CITRUS_GPIO_IO(CITRUS_PIN_IRQ)) & 1u);
+	if (!citrus9_idle(west, false, &status)) {
+		printf("CITRUS TOUCH: mode9 chip never idle (status=%#x)\n", status);
