+/*
+ * Mode 10: after the application is running, poll INT (GPIO93, active low) and
+ * read one report per assertion, then publish the contacts to iOS through
+ * sweet_hid_touch() (native panel coordinates, 1080x2340; SweetHID clamps and
+ * maps them to the presented display). Report layout from focaltech_core.h
+ * with our rep[k] == vendor buf[k+1]: header rep[0] (0x9x), point count low
+ * nibble of rep[1], then 6-byte points: X_H/event, X_L, Y_H/id, Y_L, press,
+ * area.
+ */
+#define CITRUS10_REPORT_LEN 63u /* FTS_TOUCH_DATA_LEN */
+
+static void
+citrus_touch_report_loop(void)
+{
+	vm_offset_t west;
+	static uint8_t rep[80];
+	bool down[10] = {false};
+	int lx[10] = {0}, ly[10] = {0};
+	unsigned cycle, i, reports = 0, shown = 0;
+
+	west = ml_io_map(CITRUS_WEST_PA, 0x80000);
+	if (!west) {
+		printf("CITRUS TOUCH: mode10 mapping failed\n");
+		return;
+	}
+	printf("CITRUS TOUCH: mode10 reporting; touch the screen any time\n");
+	for (cycle = 0; ; cycle++) {
+		bool irq_low = (touch_rd(west, CITRUS_GPIO_IO(CITRUS_PIN_IRQ)) &
+		    1u) == 0;
+
+		/* The IC's INT can be a short pulse, so also sample the report
+		 * register every ~8 ms; a frame without the 0x9x header is
+		 * ignored and never injected. */
+		if (irq_low || (cycle % 100u) == 0u) {
+			bool crcok = citrus10_report(west, rep,
+			    CITRUS10_REPORT_LEN);
+			bool seen[10] = {false};
+			unsigned points = rep[1] & 0x0fu;
+
+			reports++;
+			if (shown < 4) {
+				printf("CITRUS TOUCH: mode10 raw crc=%d %02x %02x %02x %02x %02x %02x %02x %02x %02x\n",
+				    crcok, rep[0], rep[1], rep[2], rep[3], rep[4],
+				    rep[5], rep[6], rep[7], rep[8]);
+				shown++;
+			}
+			if ((rep[0] & 0xf0u) == 0x90u && points <= 10u) {
+				for (i = 0; i < points; i++) {
+					unsigned b = i * 6u;
+					unsigned ev = rep[2 + b] >> 6;
+					unsigned id = rep[4 + b] >> 4;
+					int x = ((rep[2 + b] & 0x0fu) << 8) |
+					    rep[3 + b];
+					int y = ((rep[4 + b] & 0x0fu) << 8) |
+					    rep[5 + b];
+
+					if (id >= 10u) {
+						continue;
+					}
+					if (ev == 0u || ev == 2u) {
+						seen[id] = true;
+						lx[id] = x;
+						ly[id] = y;
+						if (!down[id]) {
+							down[id] = true;
+							printf("CITRUS TOUCH: mode10 down id=%u %d,%d\n",
+							    id, x, y);
+						}
+						sweet_hid_touch((int)id, 1, x, y);
+					} else if (down[id]) {
+						down[id] = false;
+						printf("CITRUS TOUCH: mode10 up id=%u %d,%d\n",
+						    id, lx[id], ly[id]);
+						sweet_hid_touch((int)id, 0, lx[id],
+						    ly[id]);
+					}
+				}
+				for (i = 0; i < 10; i++) {
+					if (down[i] && !seen[i]) {
+						down[i] = false;
+						printf("CITRUS TOUCH: mode10 up id=%u %d,%d (absent)\n",
+						    i, lx[i], ly[i]);
+						sweet_hid_touch((int)i, 0, lx[i],
+						    ly[i]);
+					}
+				}
+			} else if (shown < 12) {
+				printf("CITRUS TOUCH: mode10 idle frame hdr=%02x n=%u crc=%d\n",
+				    rep[0], points, crcok);
+				shown++;
+			}
+		}
+		if ((cycle % 30000u) == 29999u) {
+			printf("CITRUS TOUCH: mode10 alive irq=%u frames=%u\n",
+			    irq_low ? 0u : 1u, reports);
+		}
+		touch_wait(2);
+	}
+	printf("CITRUS TOUCH: mode10 loop done frames=%u\n", reports);
+}
