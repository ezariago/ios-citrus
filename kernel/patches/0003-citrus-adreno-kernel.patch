+/* boot-arg gpu_identity (default 1): the SMMU passes addresses through (TopazGpuW G1), GPU VA = PA */
+static uint32_t gpu_identity = 1;
+static uint32_t citrus_smmu_39 = 0;
+
+/* All kernel buffers are bounded contiguous allocations from managed RAM.
+ * Allocation failure is fatal to bring-up; no raw physical fallback. */
+static bool
+kbuf_alloc(struct kbuf *b, uint64_t size)
+{
+    if (size == 0 || size > (16ull << 20)) { return false; }
+    size = (size + PAGE_SIZE - 1) & ~(uint64_t)(PAGE_SIZE - 1);
+    b->md = IOBufferMemoryDescriptor::inTaskWithPhysicalMask(kernel_task,
+        kIODirectionInOut | kIOMemoryPhysicallyContiguous | kIOMapWriteCombineCache,
+        size, 0x00000000ffffc000ull);
+    if (b->md == NULL) { return false; }
+    IOByteCount length = 0;
+    b->pa = b->md->getPhysicalSegment(0, &length, kIOMemoryMapperNone);
+    b->va = (uint8_t *)b->md->getBytesNoCopy();
+    if (b->va == NULL || b->pa < 0x80000000ull ||
+        b->pa >= 0xf0000000ull || size > 0xf0000000ull - b->pa || length < size) {
+        OSSafeReleaseNULL(b->md);
+        b->va = NULL;
+        return false;
+    }
+    b->size = size;
+    bzero(b->va, size);
+    return true;
+}
+
+__unused static bool
+kbuf_alloc_high(struct kbuf *b, uint64_t size)
+{
+	size = (size + PAGE_SIZE - 1) & ~(uint64_t)(PAGE_SIZE - 1);
+	/* no cache mode: IOBMD makes such buffers contiguous, from the lower DDR bank */
+	b->md = IOBufferMemoryDescriptor::inTaskWithOptions(kernel_task, kIODirectionInOut, size, PAGE_SIZE);
+	if (b->md == NULL) {
+		return false;
+	}
+	b->va = (uint8_t *)b->md->getBytesNoCopy();
+	b->pa = kbuf_pa(b, 0);
+	b->size = size;
+	bzero(b->va, size);
+	sweet_dcache_clean((vm_offset_t)b->va, (unsigned)size);
+	return true;
+}
