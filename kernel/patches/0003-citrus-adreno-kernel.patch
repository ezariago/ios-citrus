+/*
+ * CoreAnimation alternates its default surface with surfaces it allocates.
+ * The boot framebuffer has uncached, 4320-byte rows: Redwood cannot import it
+ * (rows must be 64-byte aligned), so every other GL frame needs an expensive
+ * CPU readback. Give that default target the same owned RAM layout as the
+ * other render targets. Never allocate from the disabled raw physical pool.
+ */
+SweetSurface *
+sweet_surface_create_render_target(uint32_t width, uint32_t height, uint32_t pixelFormat)
+{
+	uint64_t row = ((uint64_t)width * 4 + 63) & ~63ull;
+	uint64_t size = round_page_64(row * ((uint64_t)height + 64));
+	if (width == 0 || height == 0 || width > SWEET_SURFACE_MAX_DIM ||
+	    height > SWEET_SURFACE_MAX_DIM || size > (64ull << 20)) {
+		return NULL;
+	}
+	SweetSurface *s = sweet_surface_alloc();
+	if (s == NULL) {
+		return NULL;
+	}
+	s->width = width;
+	s->height = height;
+	s->bytesPerRow = (uint32_t)row;
+	s->bytesPerElement = 4;
+	s->elementWidth = s->elementHeight = 1;
+	s->pixelFormat = pixelFormat;
+	s->allocSize = (uint32_t)size;
+	IOBufferMemoryDescriptor *mem = IOBufferMemoryDescriptor::inTaskWithPhysicalMask(kernel_task,
+	    kIODirectionInOut | kIOMemoryKernelUserShared | kIOMemoryPhysicallyContiguous,
+	    size, 0x00000000fffff000ull);
+	IOByteCount contiguous = 0;
+	uint64_t pa = mem != NULL ? mem->getPhysicalSegment(0, &contiguous, kIOMemoryMapperNone) : 0;
+	if (mem == NULL || pa < 0x80000000ull || pa >= 0xf0000000ull ||
+	    size > 0xf0000000ull - pa || contiguous < size) {
+		OSSafeReleaseNULL(mem);
+		s->release();
+		return NULL;
+	}
+	s->memory = mem;
+	s->scanoutPhys = pa;
+	s->mapCache = kIOMapDefaultCache;
+	OSAddAtomic64(s->allocSize, (volatile SInt64 *)&sweet_surface_wired);
+	bzero(mem->getBytesNoCopy(), (size_t)size);
+	if (!sweet_surface_publish(s)) {
+		s->release();
+		return NULL;
+	}
