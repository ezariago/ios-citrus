+/* Citrus PM6125 LPG. A channel is used only after checking its AP owner,
+ * subtype and the bootloader's 9-bit clock configuration. All transactions
+ * have bounded waits. This channel is separate from the key observer APIDs. */
+static volatile uint32_t *citrus_bl_obs, *citrus_bl_rw;
+static uint8_t citrus_bl_enable, citrus_bl_msb;
+static bool citrus_bl_ready, citrus_bl_selected;
+
+static bool
+citrus_bl_xfer(volatile uint32_t *ch, bool write, uint8_t reg, uint8_t *value)
+{
+    if (write) ch[4] = *value;
+    __asm__ volatile("dmb oshst" ::: "memory");
+    ch[0] = (write ? 0u : (1u << 27)) | ((uint32_t)reg << 4);
+    __asm__ volatile("dsb osh" ::: "memory");
+    uint32_t status = 0;
+    for (unsigned n = 0; n < 1000; n++) {
+        status = ch[2];
+        if (status & 1) break;
+        IODelay(1);
+    }
+    if (!(status & 1) || (status & 0xe)) {
+        IOLog("CITRUS BL: %s reg=%#x failed status=%#x\n", write ? "write" : "read", reg, status);
+        return false;
+    }
+    if (!write) *value = ch[6] & 0xff;
+    return true;
+}
