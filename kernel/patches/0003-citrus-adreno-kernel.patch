+static bool
+rcg_set(uint32_t cmd, uint32_t src, uint32_t div)
+{
+	wr(gpucc, cmd + 4, (src << 8) | (2 * div - 1));
+	rmw(gpucc, cmd, 0, RCG_UPDATE);
+	return poll(gpucc, cmd, RCG_UPDATE, 0, 500);
+}
+
+/*
+ * PLL0 at 1900 MHz, the stock 950 MHz source. 1900/19.2 = 98 + 23/24, so
+ * L=98 and the 32-bit alpha field is round(23/24 * 2^32) = 0xf5555555. The
+ * default alpha register pair stores only its top 32 bits: 0x0c gets the top
+ * eight and 0x08 the remaining 24 bits (the same encoding as the stock 0x80
+ * alpha_hi / 0 alpha for the 1200 MHz default). Aux2 is /1 and the GFX3D RCG
+ * divides by two, giving 950 MHz.
+ *
+ * The PLL is still parked because gpucc_gx_gfx3d is enabled later. Its MODE
+ * register was read as zero by clockprobe1, so there is no live output to
+ * disturb while L/alpha/config are rewritten.
+ */
+static bool
+pll0_set_1900(void)
+{
+	const uint32_t l = 98, alpha_hi = 0xf5, alpha_lo = 0x55555500;
+
+	/* Output off, then bypass and reset, before changing the multiplier. */
+	uint32_t mode = rd(gpucc, PLL0_MODE);
+	mode &= ~(1u | PLL_BYPASSNL | PLL_RESET_N | PLL_UPDATE_BYPASS);
+	wr(gpucc, PLL0_MODE, mode);
+	IODelay(2);
+
+	wr(gpucc, PLL0_L, l);
+	wr(gpucc, PLL0_ALPHA, alpha_lo);
+	wr(gpucc, PLL0_ALPHA_HI, alpha_hi);
+	wr(gpucc, PLL0_CONFIG_CTL, 0x4001055b);     /* stock gpu_cc_pll0_config */
+	wr(gpucc, PLL0_TEST_CTL_U, 0x1);
+
+	uint32_t ctl = rd(gpucc, PLL0_USER_CTL);
+	ctl &= ~((0x3u << 20) | (0xfu << 8));       /* VCO range 0, aux2 /1 */
+	ctl |= PLL_ALPHA_EN | 0x7u;                 /* main, aux and aux2 outputs */
+	wr(gpucc, PLL0_USER_CTL, ctl);
+
+	rmw(gpucc, PLL0_MODE, 0, PLL_BYPASSNL);
+	IODelay(5);
+	rmw(gpucc, PLL0_MODE, 0, PLL_RESET_N);
+	if (!poll(gpucc, PLL0_MODE, PLL_LOCK, PLL_LOCK, 1000)) {
+		IOLog("CitrusGPU: PLL0 1900 did not lock (mode=%#x L=%u alpha=%#x/%#x)\n",
+		    rd(gpucc, PLL0_MODE), rd(gpucc, PLL0_L), rd(gpucc, PLL0_ALPHA_HI),
+		    rd(gpucc, PLL0_ALPHA));
+		return false;
+	}
+	rmw(gpucc, PLL0_MODE, 0, 1u);               /* PLL_OUTCTRL */
+	IODelay(10);
+
+	uint32_t locked = rd(gpucc, PLL0_MODE), read_l = rd(gpucc, PLL0_L);
+	uint32_t read_hi = rd(gpucc, PLL0_ALPHA_HI), read_lo = rd(gpucc, PLL0_ALPHA);
+	if ((locked & PLL_LOCK) != PLL_LOCK ||
+	    read_l != l || read_hi != alpha_hi || read_lo != alpha_lo) {
+		IOLog("CitrusGPU: PLL0 1900 readback mismatch mode=%#x L=%u alpha=%#x/%#x\n",
+		    locked, read_l, read_hi, read_lo);
+		return false;
+	}
+	IOLog("CitrusGPU: PLL0 locked at 1900 MHz (mode=%#x L=%u alpha=%#x/%#x)\n",
+	    locked, read_l, read_hi, read_lo);
+	return true;
+}
+
+/* The GFX3D RCG's parent 5 (gcc_gpu_gpll0_clk_src) is the 600 MHz GPLL0 on
+ * Bengal: the stock GMU entry F(200 MHz, GPLL0, 3) fixes that rate. Dividing
+ * by two therefore gives the 300 MHz bring-up clock and by one the lowest
+ * stock rate above it. 600 MHz is VDD_LOW_L1 in gpucc-bengal.c, below the
+ * CX level the boot CPUs already demand, and needs no GPU PLL programming.
+ * 950 MHz is the fused-bin stock maximum and uses PLL0 AUX2 /2; it is allowed
+ * only on a boot whose Gold cluster really reached its top state, because that
+ * is the boot's only confirmed source of the CX/MX TURBO_L1 class. There is no
+ * independent RPM rail vote here. */
+static bool
+gfx_set_mhz(uint32_t mhz)
+{
+	if (mhz == 950) {
+		if (!pll0_set_1900()) { return false; }
+		if (!rcg_set(0x101c, SRC_PLL0_AUX2, 2)) { return false; }
+		IOLog("CitrusGPU: gfx3d 950 MHz (PLL0 1900/2, cfg=%#x, PLL mode=%#x)\n",
+		    rd(gpucc, 0x1020), rd(gpucc, PLL0_MODE));
+		return true;
+	}
+	if (mhz != 300 && mhz != 600) { return false; }
+	if (!rcg_set(0x101c, SRC_GPLL0, 600u / mhz)) { return false; }
+	IOLog("CitrusGPU: gfx3d %u MHz (GPLL0/%u, cfg=%#x)\n", mhz, 600u / mhz, rd(gpucc, 0x1020));
+	return true;
+}
+
+static bool
+gdsc_on(uint32_t gdscr, uint32_t bcr, uint32_t clamp, uint32_t status)
+{
+	if (bcr != 0) {
+		rmw(gpucc, bcr, 0, 1);
+		IODelay(1);
+		rmw(gpucc, bcr, 1, 0);
+	}
+	if (clamp != 0) {
+		rmw(gpucc, clamp, 1, 0);
+	}
+	rmw(gpucc, gdscr, GDSC_COLLAPSE, 0);
+	IODelay(1);
+	return poll(gpucc, status, GDSC_PWR_ON, GDSC_PWR_ON, 500);
+}
+
+static void
+power_cycle_if_on(void)
+{
+	if ((rd(gpucc, 0x100c) & GDSC_PWR_ON) == 0 && (rd(gpucc, 0x1540) & GDSC_PWR_ON) == 0) {
+		return;
+	}
+	IOLog("TopazGPU: already powered (GX %08x CX %08x): power cycling\n", rd(gpucc, 0x100c), rd(gpucc, 0x1540));
+	if (rd(gpucc, 0x100c) & GDSC_PWR_ON) {
+		wr(gpu, 4 * 0x808, 0);                  /* CP_SQE_CNTL: stop */
+	}
+	rmw(gpucc, 0x1054, CBCR_EN, 0);
+	rmw(gpucc, 0x100c, 0, GDSC_COLLAPSE);
+	rmw(gpucc, 0x1508, 0, 1);
+	poll(gpucc, 0x100c, GDSC_PWR_ON, 0, 1000);
+	rmw(gpucc, 0x1098, CBCR_EN, 0);
+	rmw(gpucc, 0x106c, 0, GDSC_COLLAPSE);
+	IODelay(1000);
+}
+
+static bool
+power_up(void)
+{
+	power_cycle_if_on();
+	rmw(gcc, 0x79004, 0, 1u << 15);                 /* GPLL0 to the GPU CC */
+    if (!branch_on(gcc, 0x71154, "gcc_bimc_gpu_axi")) { return false; }
+    /* Request fabric clocks before the GDSCs, but check halt status after
+     * the destination domains are up. An enabled request can be gated while
+     * the GPU is collapsed (observed MEMNOC=0x80004221 on Citrus hw1). */
+    rmw(gcc, 0x3600c, 0, CBCR_EN);
+    rmw(gcc, 0x36018, 0, CBCR_EN);
+    IOLog("CitrusGPU: power votes MEM=%08x SNOC=%08x CX=%08x CXSTAT=%08x GX=%08x\n",
+        rd(gcc, 0x3600c), rd(gcc, 0x36018), rd(gpucc, 0x106c), rd(gpucc, 0x1540), rd(gpucc, 0x100c));
+	if (!gdsc_on(0x106c, 0, 0, 0x1540)) {
+		IOLog("TopazGPU: CX GDSC: no PWR_ON gdscr=%08x status=%08x\n", rd(gpucc, 0x106c), rd(gpucc, 0x1540));
+		return false;
+	}
+	if (!branch_on(gpucc, 0x109c, "gpucc_cxo") || !branch_on(gpucc, 0x1078, "gpucc_ahb")) {
+		return false;
+	}
+	if (!rcg_set(0x1120, SRC_GPLL0, 3)) { return false; }                  /* gmu 200 MHz */
+	rmw(gpucc, 0x1098, 0xFF0, 0xFF0);
+    if (!branch_on(gpucc, 0x1098, "gpucc_cx_gmu") ||
+        !branch_on(gpucc, 0x5000, "gpucc_hlos1_vote_gpu_smmu")) { return false; }
+	if (!gdsc_on(0x100c, 0x1008, 0x1508, 0x100c)) {
+		IOLog("TopazGPU: GX GDSC: no PWR_ON gdscr=%08x CX=%08x\n", rd(gpucc, 0x100c), rd(gpucc, 0x1540));
+		return false;
+	}
+    IOLog("CitrusGPU: power domains on CX=%08x GX=%08x\n", rd(gpucc, 0x1540), rd(gpucc, 0x100c));
+    if (!branch_on(gcc, 0x3600c, "gcc_gpu_memnoc_gfx after power") ||
+        !branch_on(gcc, 0x36018, "gcc_gpu_snoc_dvm_gfx after power")) { return false; }
+    /* Bengal gfx parent 5 is GPLL0 at 300/600 MHz; 950 MHz additionally
+     * programs PLL0. A PLL failure must not cost the boot its display path. */
+    if (!gfx_set_mhz(core_mhz)) {
+        if (core_mhz != 950) { return false; }
+        IOLog("CitrusGPU: PLL0 950 setup failed; falling back to GPLL0/2 300 MHz\n");
+        core_mhz = 300;
+        if (!gfx_set_mhz(300)) { return false; }
+    }
+
+	rmw(gpucc, 0x1054, 0, (1u << 14) | (1u << 13));
+	if (!branch_on(gpucc, 0x1054, "gpucc_gx_gfx3d")) {
+		return false;
+	}
+	return branch_on(gpucc, 0x1060, "gpucc_gx_cxo");
+}
+
+/* ---------------------------------------------------------------- TrustZone: the zap shader */
+
+static uint64_t
+smc(uint64_t a[8])
+{
+	register uint64_t x0 __asm__("x0") = a[0], x1 __asm__("x1") = a[1], x2 __asm__("x2") = a[2],
+	    x3 __asm__("x3") = a[3], x4 __asm__("x4") = a[4], x5 __asm__("x5") = a[5], x6 __asm__("x6") = a[6],
+	    x7 __asm__("x7") = a[7];
+	__asm__ volatile ("smc #0"
+            : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3), "+r"(x4), "+r"(x5), "+r"(x6), "+r"(x7)
+            :
+            : "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15", "x16", "x17", "memory");
+	a[0] = x0; a[1] = x1; a[2] = x2; a[3] = x3; a[4] = x4; a[5] = x5; a[6] = x6; a[7] = x7;
+	return x0;
+}
+
+static uint64_t
+scm(uint32_t fn, uint64_t arginfo, uint64_t a, uint64_t b, uint64_t c, uint64_t *res1)
+{
+	uint64_t args[8] = { fn, arginfo, a, b, c, 0, 0, 0 };
+	smc(args);
+	for (int n = 0; args[0] == 1 && n < 100000; n++) {     /* interrupted: resume with the session in x6 */
+		uint64_t session = args[6];
+		uint64_t again[8] = { 1, arginfo, a, b, c, 0, session, 0 };
+		memcpy(args, again, sizeof(args));
+		smc(args);
+	}
+	if (res1 != NULL) {
+		*res1 = args[1];
+	}
+	return args[0];
+}
+
+static bool
+zap_load(void)
+{
+	void *mdt = NULL, *seg = NULL;
+	size_t mdt_size = 0, seg_size = 0;
+	struct kbuf meta = {};
+	bool ok = false;
+
+	IOLog("TopazGPU: zap: embedded firmware (%zu + %zu bytes)\n", topaz_fw_zap_mdt_size, topaz_fw_zap_b02_size);
+	mdt = (void *)topaz_fw_zap_mdt;
+	mdt_size = topaz_fw_zap_mdt_size;
+	seg = (void *)topaz_fw_zap_b02;
+	seg_size = topaz_fw_zap_b02_size;
+	{
+		const uint8_t *m = (const uint8_t *)mdt;
+		uint32_t phoff = *(const uint32_t *)(m + 28), phnum = *(const uint16_t *)(m + 44);
+		uint32_t min_a = 0xffffffff, max_a = 0, seg_paddr = 0;
+		uint64_t st, res = 0;
+
+		for (uint32_t i = 0; i < phnum && phoff + 32 * (i + 1) <= mdt_size; i++) {
+			const uint8_t *ph = m + phoff + 32 * i;
+			uint32_t paddr = *(const uint32_t *)(ph + 12), memsz = *(const uint32_t *)(ph + 20);
+			uint32_t flags = *(const uint32_t *)(ph + 24);
+			if (*(const uint32_t *)ph == 1 && memsz != 0 && ((flags >> 24) & 7) != 2) {
+				min_a = paddr < min_a ? paddr : min_a;
+				uint32_t end = (paddr + memsz + 0xfff) & ~0xfffu;
+				max_a = end > max_a ? end : max_a;
+				seg_paddr = paddr;
+			}
+		}
+		if (max_a <= min_a || max_a - min_a > ZAP_REGION_SIZE) {
+			IOLog("TopazGPU: zap layout unexpected\n");
+			goto out;
+		}
+		if (mdt_size > PAGE_SIZE || !kbuf_alloc(&meta, mdt_size)) {
+			IOLog("TopazGPU: zap metadata of %zu bytes does not fit one page\n", mdt_size);
+			goto out;
+		}
+		IOLog("TopazGPU: zap: metadata at %#llx\n", meta.pa);
+		memcpy(meta.va, mdt, mdt_size);
+		sweet_dcache_clean((vm_offset_t)meta.va, (unsigned)mdt_size);
+		__asm__ volatile ("dsb sy" ::: "memory");
+		scm(SCM_FN(SCM_SVC_PIL, PIL_SHUTDOWN), 1, GPU_PAS_ID, 0, 0, &res);
+		st = scm(SCM_FN(SCM_SVC_PIL, PIL_INIT_IMAGE), 2 | (SCM_ARG_RW << 6), GPU_PAS_ID, meta.pa, 0, &res);
+		if (st != 0 || res != 0) {
+			IOLog("TopazGPU: zap init_image: %llx/%llx\n", st, res);
+			goto out;
+		}
+		st = scm(SCM_FN(SCM_SVC_PIL, PIL_MEM_SETUP), 3, GPU_PAS_ID, ZAP_REGION, max_a - min_a, &res);
+		if (st != 0 || res != 0) {
+			IOLog("TopazGPU: zap mem_setup: %llx/%llx\n", st, res);
+			goto out;
+		}
+		IOLog("TopazGPU: zap: init_image and mem_setup ok, copying the segment\n");
+		volatile uint8_t *dst = (volatile uint8_t *)ml_io_map(ZAP_REGION, ZAP_REGION_SIZE);
+		if (dst == NULL) {
+			goto out;
+		}
+		for (uint32_t i = 0; i < ZAP_REGION_SIZE; i += 4) {
+			*(volatile uint32_t *)(dst + i) = 0;
+		}
+		uint32_t at = seg_paddr - min_a, n = (uint32_t)(seg_size < ZAP_REGION_SIZE - at ? seg_size : ZAP_REGION_SIZE - at);
+		for (uint32_t i = 0; i < n; i++) {
+			dst[at + i] = ((const uint8_t *)seg)[i];
+		}
+		__asm__ volatile ("dsb sy" ::: "memory");
+		st = scm(SCM_FN(SCM_SVC_PIL, PIL_AUTH_RESET), 1, GPU_PAS_ID, 0, 0, &res);
+		IOLog("TopazGPU: zap auth_and_reset: %llx/%llx\n", st, res);
+		ok = st == 0 && res == 0;
+	}
+out:
+	OSSafeReleaseNULL(meta.md);
+	return ok;
+}
+
+/* ---------------------------------------------------------------- SMMU stage-1 tables (4 KB granule) */
+
+#define PTE_VALID       (1ull << 0)
+#define PTE_TABLE       (1ull << 1)
+#define PTE_AP_UNPRIV   (1ull << 6)
+#define PTE_AP_RO       (1ull << 7)
+#define PTE_SH_OUTER    (2ull << 8)
+#define PTE_AF          (1ull << 10)
+#define PTE_PAGE        (PTE_VALID | PTE_TABLE | PTE_AP_UNPRIV | PTE_SH_OUTER | PTE_AF)    /* AttrIndx 0 */
+
+struct table { uint64_t *va; uint64_t pa; };
+static struct table l1, l2[4];
+static struct table *l3[2048];          /* one per 2 MB of GPU VA */
+static struct kbuf table_chunk;         /* tables are carved from 16 KB pages */
+static uint32_t table_chunk_used = 4;
+static bool tables_dirty;
+
+static bool
+table_alloc(struct table *t)
+{
+	if (table_chunk_used == PAGE_SIZE / 4096) {
+		struct kbuf b = {};
+		if (!kbuf_alloc(&b, PAGE_SIZE)) {
+			return false;
+		}
+		table_chunk = b;                        /* (never freed: tables live as long as the GPU) */
+		table_chunk_used = 0;
+	}
+	t->va = (uint64_t *)(table_chunk.va + 4096 * table_chunk_used);
+	t->pa = table_chunk.pa + 4096 * table_chunk_used;
+	table_chunk_used++;
+	return true;
+}
+
+static uint64_t *
+l3_for(uint64_t va, bool create)
+{
+	uint32_t i1 = (uint32_t)(va >> 30), i2 = (uint32_t)((va >> 21) & 511), i3 = (uint32_t)(va >> 21);
+
+	if (i1 >= 4) {
+		return NULL;
+	}
+	if (l2[i1].va == NULL) {
+		if (!create || !table_alloc(&l2[i1])) {
+			return NULL;
+		}
+		l1.va[i1] = l2[i1].pa | PTE_VALID | PTE_TABLE;
+		sweet_dcache_clean((vm_offset_t)&l1.va[i1], 8);
+	}
+	if (l3[i3] == NULL) {
+		struct table *t = (struct table *)IOMalloc(sizeof(*t));
+		if (!create || t == NULL || !table_alloc(t)) {
+			if (t != NULL) {
+				IOFree(t, sizeof(*t));
+			}
+			return NULL;
+		}
+		l3[i3] = t;
+		l2[i1].va[i2] = t->pa | PTE_VALID | PTE_TABLE;
+		sweet_dcache_clean((vm_offset_t)&l2[i1].va[i2], 8);
+	}
+	return l3[i3]->va;
+}
+
+static void
+tlb_flush(void)
+{
+	__asm__ volatile ("dsb sy" ::: "memory");
+	wr(smmu, smmu_cb0 + 0x618, 0);                  /* CB_TLBIALL */
+	wr(smmu, smmu_cb0 + 0x7F0, 0);                  /* CB_TLBSYNC */
+	poll(smmu, smmu_cb0 + 0x7F4, 1, 0, 1000);
+}
+
+static bool
+mmu_map(uint64_t va, uint64_t pa, bool ro)
+{
+	uint64_t *t = l3_for(va, true);
+	if (t == NULL || (pa >> 36) != 0) {
+		return false;
+	}
+	t[(va >> 12) & 511] = pa | PTE_PAGE | (ro ? PTE_AP_RO : 0);
+	sweet_dcache_clean((vm_offset_t)&t[(va >> 12) & 511], 8);
+	tables_dirty = true;
+	return true;
+}
+
+static uint32_t citrus_smmu_diag = 0;      /* citrussmmudiag: register readback, ATOS, fault dump */
+static uint32_t citrus_smmu_reset = 0;     /* citrussmmureset: MMU-500 ACR/global reset before CB setup */
+
+static void
+smmu_fault(const char *tag)
+{
+	IOLog("TopazGPU: [%s] SMMU gfsr %08x CB0 FSR %08x FAR %08x%08x FSYNR0 %08x\n", tag, rd(smmu, 0x48),
+	    rd(smmu, smmu_cb0 + 0x58), rd(smmu, smmu_cb0 + 0x64), rd(smmu, smmu_cb0 + 0x60), rd(smmu, smmu_cb0 + 0x68));
+}
+
+/*
+ * The vendor driver puts the context banks at half the mapped window
+ * (arm-smmu.c: smmu->cb_base = base + resource_size(res) / 2), NOT at the
+ * IDR1.NUMPAGENDXB-derived offset.  Validate that relationship and the GR1
+ * page, and fail closed if the reported page size cannot fit the window.
+ */
+static bool
+citrus_smmu_layout(uint32_t idr1, uint32_t size, uint32_t *page_out, uint32_t *cb_out)
+{
+	uint32_t page = (idr1 & (1u << 31)) ? 0x10000u : 0x1000u;
+	uint32_t cbbase = size / 2;
+	if ((size & 1u) != 0 || page >= size || cbbase < page || cbbase + 0x900 > size || page + 0x900 > size) {
+		return false;
+	}
+	*page_out = page;
+	*cb_out = cbbase;
+	return true;
+}
+
+static uint32_t
+smmu_cb_stride(uint32_t idr1)
+{
+	return (idr1 & (1u << 31)) ? 0x10000u : 0x1000u;
+}
+
+/* Log every context bank the mapped window can hold; the faulting one is not
+ * necessarily CB0, and S2CR/SMR show which stream maps where. */
+static void
+smmu_dump_contexts(const char *tag)
+{
+	uint32_t idr1 = rd(smmu, 0x24);
+	uint32_t stride = smmu_cb_stride(idr1);
+	unsigned banks = (SMMU_SIZE - smmu_cb0) / stride;
+
+	if (banks > 8) {
+		banks = 8;
+	}
+	IOLog("CitrusGPU: SMMU %s idr1=%08x stride=%#x banks=%u sACR=%08x sCR0=%08x GFSR=%08x\n",
+	    tag, idr1, stride, banks, rd(smmu, 0x10), rd(smmu, 0x0), rd(smmu, 0x48));
+	for (unsigned cb = 0; cb < banks; cb++) {
+		uint32_t base = smmu_cb0 + cb * stride;
+		uint64_t ttbr0 = (uint64_t)rd(smmu, base + 0x20) | ((uint64_t)rd(smmu, base + 0x24) << 32);
+		uint64_t far = (uint64_t)rd(smmu, base + 0x60) | ((uint64_t)rd(smmu, base + 0x64) << 32);
+		IOLog("CitrusGPU: SMMU cb%u SCTLR=%08x TTBR0=%#llx TCR=%08x FSR=%08x FAR=%#llx FSYNR0=%08x\n",
+		    cb, rd(smmu, base + 0x0), ttbr0, rd(smmu, base + 0x30), rd(smmu, base + 0x58), far,
+		    rd(smmu, base + 0x68));
+	}
+	for (unsigned i = 0; i < 4; i++) {
+		IOLog("CitrusGPU: SMMU smr%u=%08x s2cr%u=%08x\n", i, rd(smmu, 0x800 + 4 * i), i, rd(smmu, 0xC00 + 4 * i));
+	}
+}
+
+/* Ask the SMMU's own walker to translate an IOVA (CB_ATS1PR).  This separates
+ * a bad table from a bad stream mapping or a CP-side problem. */
+static void
+smmu_atos(const char *tag, uint64_t va)
+{
+	uint64_t par;
+
+	wr(smmu, smmu_cb0 + 0x800, (uint32_t)va);
+	wr(smmu, smmu_cb0 + 0x804, (uint32_t)(va >> 32));
+	bool idle = poll(smmu, smmu_cb0 + 0x8F0, 1, 0, 100);
+	par = (uint64_t)rd(smmu, smmu_cb0 + 0x50) | ((uint64_t)rd(smmu, smmu_cb0 + 0x54) << 32);
+	IOLog("CitrusGPU: SMMU ATOS %s va=%#llx atsr=%08x par=%#llx %s\n", tag, va, rd(smmu, smmu_cb0 + 0x8F0),
+	    par, !idle ? "TIMEOUT" : (par & 1) ? "FAULT" : "PASS");
+	if (par & 1) {
+		smmu_dump_contexts("atos");
+	}
+	wr(smmu, smmu_cb0 + 0x58, 0xFFFFFFFF);           /* clear any fault the probe recorded */
+}
+
+static bool
+smmu_setup(void)
+{
+	IOLog("TopazGPU: smmu: tables\n");
+	uint32_t idr0 = rd(smmu, 0x20);
+	uint32_t idr1 = rd(smmu, 0x24);
+	uint32_t idr2 = rd(smmu, 0x28);
+	uint32_t acr = rd(smmu, 0x10);
+	uint32_t scr0 = rd(smmu, 0x0);
+	uint32_t page, cbbase;
+
+	if (!gpu_identity) {
+		if (!citrus_smmu_layout(idr1, SMMU_SIZE, &page, &cbbase) || cbbase != smmu_cb0 || page != smmu_gr1) {
+			IOLog("CitrusGPU: SMMU layout idr0=%08x idr1=%08x idr2=%08x page=%#x cb0=%#x mapped=%#x: unsupported\n",
+			    idr0, idr1, idr2, page, cbbase, SMMU_SIZE);
+			return false;
+		}
+		IOLog("CitrusGPU: SMMU layout idr0=%08x idr1=%08x idr2=%08x page=%#x cb0=%#x sACR=%08x sCR0=%08x GFSR=%08x\n",
+		    idr0, idr1, idr2, page, cbbase, acr, scr0, rd(smmu, 0x48));
+	}
+	if (l1.va == NULL && !table_alloc(&l1)) {
+		return false;
+	}
+	if (citrus_smmu_reset && !gpu_identity) {
+		/* MMU-500: clear ACR.CACHE_LOCK before changing SMR/S2CR, enable the
+		 * unmatched-stream TLB, then do the global TLB invalidate Linux does. */
+		wr(smmu, 0x10, (acr & ~(1u << 26)) | (1u << 8));
+		wr(smmu, 0x6C, 0xFFFFFFFF);                     /* TLBIALLH */
+		wr(smmu, 0x68, 0xFFFFFFFF);                     /* TLBIALLNSNH */
+		wr(smmu, 0x70, 0);                              /* sTLBGSYNC */
+		poll(smmu, 0x74, 1, 0, 1000);                   /* sTLBGSTATUS */
+		scr0 |= (1u << 1) | (1u << 2) | (1u << 4) | (1u << 5);   /* GFRE GFIE GCFGFRE GCFGFIE */
+		scr0 |= (1u << 10) | (1u << 11) | (1u << 12);            /* USFCFG VMIDPNE PTM */
+		scr0 &= ~((1u << 0) | (1u << 13));                        /* CLIENTPD, FB */
+		wr(smmu, 0x0, scr0);
+		IOLog("CitrusGPU: SMMU reset sACR %08x -> %08x, sCR0 %08x -> %08x\n", acr, rd(smmu, 0x10),
+		    scr0, rd(smmu, 0x0));
+		wr(smmu, smmu_cb0 + 0x004, 0x70000000);          /* CB ACTLR: QCOM ISH/OSH/NSH */
+	}
+	wr(smmu, smmu_cb0 + 0x000, 0);                  /* SCTLR off while programming */
+	wr(smmu, smmu_cb0 + 0x058, 0xFFFFFFFF);         /* FSR clear */
+	wr(smmu, smmu_gr1 + 0x800, 1);                    /* CBA2R0: AArch64 descriptors */
+	wr(smmu, smmu_gr1, 0x0001f000);                   /* CBAR0: S1 translate, S2 bypass */
+	wr(smmu, smmu_cb0 + 0x020, (uint32_t)l1.pa);
+	wr(smmu, smmu_cb0 + 0x024, (uint32_t)(l1.pa >> 32));
+	wr(smmu, smmu_cb0 + 0x030, (citrus_smmu_39 ? 25u : 32u) | (1u << 23)); /* 39-bit test or 32-bit VA, 4 KB */
+	wr(smmu, smmu_cb0 + 0x010, 1);                  /* TCR2: PASize 36 bits */
+	wr(smmu, smmu_cb0 + 0x038, 0x44);               /* MAIR0: attr0 = Normal non-cacheable */
+	wr(smmu, smmu_cb0 + 0x03C, 0);
+	/* S1_ASIDPNE keeps stage-1 ASIDs private to this context, as Linux does. */
+	wr(smmu, smmu_cb0 + 0x000, gpu_identity ? 0xE0 : (0x67 | (citrus_smmu_reset ? (1u << 12) : 0)));
+	wr(smmu, 0xC00, 0);                             /* S2CR0 -> CB0 */
+	wr(smmu, 0x800, (1u << 31) | (1u << 16));       /* SMR0: SID 0 mask 1 */
+	smmu_on = true;
+	tlb_flush();
+	IOLog("TopazGPU: SMMU TTBR0 %08x%08x SCTLR %08x TCR %08x TCR2 %08x IDR0 %08x IDR2 %08x sCR0 %08x%s\n",
+	    rd(smmu, smmu_cb0 + 0x24), rd(smmu, smmu_cb0 + 0x20), rd(smmu, smmu_cb0 + 0x0), rd(smmu, smmu_cb0 + 0x30),
+	    rd(smmu, smmu_cb0 + 0x10), rd(smmu, 0x20), rd(smmu, 0x28), rd(smmu, 0x0), gpu_identity ? " (identity)" : "");
+	if (citrus_smmu_diag && !gpu_identity) {
+		smmu_dump_contexts("setup");
+	}
+	return true;
+}
+
+static bool
+kbuf_map(struct kbuf *b)
+{
+	if (gpu_identity) {
+		b->iova = b->pa;                        /* pool memory is contiguous */
+		return true;
+	}
+	b->iova = kernel_va_next;
+	kernel_va_next += b->size + 4096;               /* guard page */
+	for (uint64_t off = 0; off < b->size; off += 4096) {
+		if (!mmu_map(b->iova + off, kbuf_pa(b, off), false)) {
+			return false;
+		}
+	}
+	return true;
+}
+
+/* ---------------------------------------------------------------- GPU VA allocator (from darwin-redwood) */
+
+static struct { uint64_t start, size; } va_free[1024];
+static unsigned va_free_count;
+
+extern "C" bool redwood_gpu_identity(void);
+bool
+redwood_gpu_identity(void)
+{
+	return gpu_identity != 0;
+}
+
+uint64_t
+redwood_gpu_address(uint64_t size)
+{
+	size = (size + 0xffff) & ~0xffffull;
+	for (unsigned i = 0; i < va_free_count; i++) {
+		if (va_free[i].size >= size) {
+			uint64_t address = va_free[i].start;
+			va_free[i].start += size;
+			va_free[i].size -= size;
+			if (va_free[i].size == 0) {
+				memmove(&va_free[i], &va_free[i + 1], (--va_free_count - i) * sizeof(va_free[0]));
+			}
+			return address;
+		}
+	}
+	return 0;
+}
+
+void
+redwood_gpu_address_free(uint64_t address, uint64_t size)
+{
+	unsigned at;
+
+	if (gpu_identity) {
+		pool_give_back(address, size);  /* GPU address = physical: the buffer's pool memory */
+		return;
+	}
+	size = (size + 0xffff) & ~0xffffull;
+	for (at = 0; at < va_free_count && va_free[at].start < address; at++) {
+	}
+	if (at > 0 && va_free[at - 1].start + va_free[at - 1].size == address) {
+		va_free[at - 1].size += size;
+		if (at < va_free_count && address + size == va_free[at].start) {
+			va_free[at - 1].size += va_free[at].size;
+			memmove(&va_free[at], &va_free[at + 1], (--va_free_count - at) * sizeof(va_free[0]));
+		}
+	} else if (at < va_free_count && address + size == va_free[at].start) {
+		va_free[at].start = address;
+		va_free[at].size += size;
+	} else if (va_free_count < sizeof(va_free) / sizeof(va_free[0])) {
+		memmove(&va_free[at + 1], &va_free[at], (va_free_count++ - at) * sizeof(va_free[0]));
+		va_free[at].start = address;
+		va_free[at].size = size;
+	}
+}
+
+/* ---------------------------------------------------------------- CP */
+
+static uint32_t
+par(uint32_t v)
+{
+	return (0x9669 >> (0xF & (v ^ (v >> 4) ^ (v >> 8) ^ (v >> 12) ^ (v >> 16) ^ (v >> 20) ^ (v >> 24) ^ (v >> 28)))) & 1;
+}
+
+static uint32_t
+pkt7(uint32_t op, uint32_t cnt)
+{
+	return 0x70000000u | cnt | (par(cnt) << 15) | ((op & 0x7F) << 16) | (par(op) << 23);
+}
+
+static void
+emit(uint32_t v)
+{
+	((volatile uint32_t *)ring.va)[wptr % RB_DWORDS] = v;
+	wptr++;
+}
+
+static void
+kick(void)
+{
+	sweet_dcache_clean((vm_offset_t)ring.va, RB_BYTES);
+	gpu_wr(0x807, wptr % RB_DWORDS);                /* CP_RB_WPTR */
+}
+
+static uint32_t
+ring_free(void)
+{
+	uint32_t r = gpu_rd(0x806), w = wptr % RB_DWORDS;
+	return (r + RB_DWORDS - w - 1) % RB_DWORDS;
+}
+
+static bool
+ring_idle(uint32_t ms)
+{
+	for (uint32_t i = 0; i < ms * 100; i++) {
+		if (gpu_rd(0x806) == wptr % RB_DWORDS) {
+			return true;
+		}
+		IODelay(10);
+	}
+	IOLog("TopazGPU: ring stuck: rptr %u wptr %u RBBM_STATUS %08x CP_HW_FAULT %08x\n", gpu_rd(0x806),
+	    wptr % RB_DWORDS, gpu_rd(0x210), gpu_rd(0x821));
+	smmu_fault("ring");
+	if (citrus_smmu_diag) {
+		smmu_dump_contexts("ring");
+	}
+    if (!gpu_identity && l1.va != NULL) {
+        uint64_t va = sqe.iova;
+        unsigned i1 = (unsigned)(va >> 30), i2 = (unsigned)((va >> 21) & 511), i3 = (unsigned)(va >> 21);
+        if (i1 < 4 && i3 < 2048) {
+            IOLog("CitrusGPU: SMMU walk va=%#llx root=%#llx l1[%u]=%#llx l2[%u]=%#llx l3[%u]=%#llx\n",
+                va, l1.pa, i1, l1.va[i1], i2, l2[i1].va ? l2[i1].va[i2] : 0,
+                (unsigned)((va >> 12) & 511), l3[i3] ? l3[i3]->va[(va >> 12) & 511] : 0);
+        }
+    }
+	return false;
+}
+
+static const uint32_t a612_hwcg[][2] = {        /* Linux a6xx_catalog.c a612_hwcg (a610 uses it) */
+	{ 0x000B0, 0x22222222 }, { 0x000B4, 0x02222220 }, { 0x000B8, 0x00000081 }, { 0x000BC, 0x0000f3cf },
+	{ 0x000C0, 0x22222222 }, { 0x000C4, 0x22222222 }, { 0x000C8, 0x22222222 }, { 0x000CC, 0x00022222 },
+	{ 0x000D0, 0x11111111 }, { 0x000D4, 0x11111111 }, { 0x000D8, 0x11111111 }, { 0x000DC, 0x00011111 },
+	{ 0x000E0, 0x77777777 }, { 0x000E4, 0x77777777 }, { 0x000E8, 0x77777777 }, { 0x000EC, 0x00077777 },
+	{ 0x000F0, 0x22222222 }, { 0x000F4, 0x01202222 }, { 0x000F8, 0x00002220 }, { 0x00100, 0x00040f00 },
+	{ 0x00104, 0x05522022 }, { 0x00105, 0x00005555 }, { 0x00106, 0x00000011 }, { 0x00107, 0x00445044 },
+	{ 0x00108, 0x04222222 }, { 0x00111, 0x00002222 }, { 0x00114, 0x02222222 }, { 0x00117, 0x00000002 },
+	{ 0x0011B, 0x00002222 }, { 0x00109, 0x00004000 }, { 0x00112, 0x00002222 }, { 0x00115, 0x00000200 },
+	{ 0x0011C, 0x00000000 }, { 0x0010A, 0x00000000 }, { 0x00113, 0x00000000 }, { 0x00116, 0x04104004 },
+	{ 0x0011D, 0x00000000 }, { 0x0010B, 0x22222222 }, { 0x00110, 0x00000004 }, { 0x0010F, 0x00000002 },
+	{ 0x00533, 0x00000182 }, { 0x00044, 0x00000000 }, { 0x00042, 0x00000000 }, { 0x00118, 0x00000222 },
+	{ 0x00119, 0x00000111 }, { 0x0011A, 0x00000555 },
+};
+
+static void
+hw_init_regs(void)
+{
+	static const uint32_t addr_mode[] = { 0x842, 0xC01, 0x8601, 0x8e05, 0x9e01, 0xbe05, 0xa601, 0x9601, 0xE00,
+		                              0xae01, 0xb601, 0xF810 };
+
+	gpu_wr(0x3c45, 0);
+	(void)gpu_rd(0x3c45);
+	gpu_wr(0x16, 0);
+	(void)gpu_rd(0x16);
+	gpu_wr(0xF803, 0);
+	gpu_wr64(0xF800, 0);
+	gpu_wr(0xF802, 0);
+	for (unsigned i = 0; i < sizeof(addr_mode) / sizeof(addr_mode[0]); i++) {
+		gpu_wr(addr_mode[i], 1);
+	}
+	for (unsigned i = 0; i < sizeof(a612_hwcg) / sizeof(a612_hwcg[0]); i++) {
+		gpu_wr(a612_hwcg[i][0], a612_hwcg[i][1]);
+	}
+	gpu_wr(0xAE, 0xaaa8aa82);                       /* RBBM_CLOCK_CNTL: a610 clock_cntl_on */
+	for (unsigned i = 0; i < 4; i++) {
+		gpu_wr(0x3c03 + i, 0x00071620);
+	}
+	gpu_wr(0x11, 3);
+	gpu_wr64(0xE05, 0x1fffffffff000ull + 0xfc0);
+	gpu_wr64(0xE09, 0x1fffffffff000ull);
+	gpu_wr64(0xE07, 0x1fffffffff000ull);
+	gpu_wr64(0xE0B, GMEM_BASE);
+	gpu_wr64(0xE0D, GMEM_BASE + GMEM_SIZE - 1);
+	gpu_wr(0xE18, 0x804);
+	gpu_wr(0xE17, 4);
+	gpu_wr(0x8c2, 0x00800060);
+	gpu_wr(0x8c1, 0x40201b16);
+	gpu_wr(0x8C3, 48);
+	gpu_wr(0x9e00, 0x00080000);
+	gpu_wr(0x98d, 1);
+	gpu_wr(0x1f, (1u << 30) | 0x3ffff);
+	gpu_wr(0xe19, 0x81);
+	gpu_wr(0x500, 1);                               /* RBBM_PERFCTR_CNTL */
+	gpu_wr(0x90E, 47);                              /* CP_MEM_POOL_DBG_ADDR */
+	gpu_wr(0x50B, 0xffffffff);                      /* RBBM_PERFCTR_GPU_BUSY_MASKED */
+	gpu_wr(0x8D0, 0);                               /* CP_PERFCTR_CP_SEL0 */
+	gpu_wr(0x8e08, 0xb);                            /* RB_NC_MODE_CNTL */
+	gpu_wr(0xb604, 0xb);                            /* TPL1_NC_MODE_CNTL */
+	gpu_wr(0xae02, 0xb);                            /* SP_NC_MODE_CNTL */
+	gpu_wr(0xE01, (1u << 23) | (1u << 21));                        /* UCHE_MODE_CNTL */
+	gpu_wr(0x534, 0);                               /* RBBM_NC_MODE_CNTL */
+}
+
+static bool
+cp_start(void)
+{
+	void *fw = NULL;
+	size_t fw_size = 0;
+
+	fw = (void *)topaz_fw_sqe_fw;
+	fw_size = topaz_fw_sqe_fw_size;
+	IOLog("TopazGPU: cp: SQE %zu bytes, allocating ring\n", fw_size);
+	if ((sqe.md == NULL && (!kbuf_alloc(&sqe, fw_size - 4) || !kbuf_map(&sqe))) ||
+	    (ring.md == NULL && (!kbuf_alloc(&ring, RB_BYTES) || !kbuf_map(&ring))) ||
+	    (mem.md == NULL && (!kbuf_alloc(&mem, PAGE_SIZE) || !kbuf_map(&mem)))) {
+		IOLog("TopazGPU: CP buffers failed\n");
+		return false;
+	}
+	memcpy(sqe.va, (const uint8_t *)fw + 4, fw_size - 4);
+	sweet_dcache_clean((vm_offset_t)sqe.va, (unsigned)(fw_size - 4));
+	IOLog("TopazGPU: cp: SQE at GPU %#llx, ring %#llx\n", sqe.iova, ring.iova);
+	tlb_flush();
+	if (citrus_smmu_diag && !gpu_identity) {
+		smmu_atos("sqe", sqe.iova);
+		smmu_atos("ring", ring.iova);
+	}
+	hw_init_regs();
+	gpu_wr64(0x830, sqe.iova);                      /* CP_SQE_INSTR_BASE */
+	gpu_wr64(0x800, ring.iova);                     /* CP_RB_BASE */
+	gpu_wr(0x802, 12 | (2 << 8) | (1u << 27));      /* CP_RB_CNTL */
+	wptr = 0;
+	gpu_wr(0x807, 0);
+	__asm__ volatile ("dsb sy" ::: "memory");
+	gpu_wr(0x808, 1);                               /* CP_SQE_CNTL */
+
+	emit(pkt7(CP_ME_INIT, 8));
+	emit(0x2f);
+	emit(3);
+	emit(0x20000000);
+	emit(0);
+	emit(0);
+	emit(0);
+	emit(0);
+	emit(0);
+	kick();
+	if (!ring_idle(100)) {
+		return false;
+	}
+	emit(pkt7(CP_SET_SECURE_MODE, 1));
+	emit(0);
+	kick();
+	if (!ring_idle(100)) {
+		return false;
+	}
+	IOLog("TopazGPU: CP up (ME_INIT, SET_SECURE_MODE 0), core %u MHz\n", core_mhz);
+	return true;
+}
+
+static bool
+hw_start(void)
+{
+    uint64_t supported = 0;
+    uint64_t rc = scm(SCM_FN(SCM_SVC_PIL, 7), 1, GPU_PAS_ID, 0, 0, &supported);
+    if (rc != 0) {
+        IOLog("CitrusGPU: PAS13 unavailable rc=%llx result=%llx\n", rc, supported);
+        return false;
+    }
+	gcc = (volatile uint8_t *)ml_io_map(GCC_BASE, GCC_SIZE);
+	gpucc = (volatile uint8_t *)ml_io_map(GPUCC_BASE, GPUCC_SIZE);
+	gpu = (volatile uint8_t *)ml_io_map(GPU_BASE, GPU_SIZE);
+	smmu = (volatile uint8_t *)ml_io_map(SMMU_BASE, SMMU_SIZE);
+	if (gcc == NULL || gpucc == NULL || gpu == NULL || smmu == NULL) {
+		IOLog("TopazGPU: map failed\n");
+		return false;
+	}
+    /* Citrus hw2 authenticated firmware and completed 16 IB/fence tests
+     * while PAS_IS_SUPPORTED returned zero. Treat that deprecated query as
+     * advisory, matching the vendor subsys-pil-tz init/auth sequence. */
+    IOLog("CitrusGPU: PAS13 query=%llu; using verified vendor init/auth path\n", supported);
+	va_free_count = 0;
+	redwood_gpu_address_free(VA_USER_START, VA_KERNEL - VA_USER_START);
+	if (!power_up()) {
+		return false;
+	}
+	IOLog("TopazGPU: powered: RBBM_STATUS %08x\n", gpu_rd(0x210));
+	return zap_load() && smmu_setup() && cp_start();
+}
+
+/* ---------------------------------------------------------------- the interface RedwoodGPU.cpp uses */
+
+bool
+redwood_gpu_ready(void)
+{
+	return ready;
+}
+
+bool
+redwood_gpu_parameter(uint32_t which, uint64_t *value)
+{
+	switch (which) {
+	case 0x01: *value = 610; return true;                   /* GPU_ID */
+	case 0x02: *value = GMEM_SIZE; return true;             /* GMEM_SIZE */
+	case 0x03: *value = 0x06010000; return true;            /* CHIP_ID */
+	case 0x04: *value = core_mhz * 1000000ull; return true; /* MAX_FREQ */
+	case 0x05:                                              /* TIMESTAMP: CP always-on counter */
+		*value = ready ? ((uint64_t)gpu_rd(0x981) << 32 | gpu_rd(0x980)) : 0;
+		return true;
+	case 0x06: *value = GMEM_BASE; return true;             /* GMEM_BASE */
+	case 0x07: *value = 1; return true;                     /* PRIORITIES */
+	case 0x08: case 0x09: case 0x0a: case 0x11:             /* PP_PGTABLE FAULTS SUSPENDS RAYTRACING */
+		*value = 0;
+		return true;
+	case 0x10: *value = 14; return true;                    /* HIGHEST_BANK_BIT (a6xx_calc_ubwc_config a610) */
+	case 0x12: *value = 7; return true;                     /* UBWC_SWIZZLE */
+	case 0x13: *value = 0; return true;                     /* MACROTILE_MODE */
+	default:
+		return false;                                   /* VA_START/VA_SIZE: addresses are ours to give */
+	}
+}
+
+bool
+redwood_gpu_map(uint64_t address, uint64_t phys, bool read_only)
+{
+	if (gpu_identity) {
+		return true;
+	}
+	return mmu_map(address, phys, read_only);
+}
+
+void
+redwood_gpu_mapped(void)
+{
+	if (tables_dirty) {
+		tables_dirty = false;
+		tlb_flush();
+	}
+}
+
+void
+redwood_gpu_unmap(uint64_t address, uint64_t size)
+{
+	if (gpu_identity) {
+		return;
+	}
+	for (uint64_t off = 0; off < size; off += 4096) {
+		uint64_t *t = l3_for(address + off, false);
+		if (t != NULL) {
+			t[((address + off) >> 12) & 511] = 0;
+			sweet_dcache_clean((vm_offset_t)&t[((address + off) >> 12) & 511], 8);
+		}
+	}
+	tlb_flush();
+}
+
+void
+redwood_gpu_to_memory(void *start, uint64_t size)
+{
+	if (start != NULL && size != 0) {
+		sweet_dcache_flush((vm_offset_t)start, (unsigned)size);    /* clean + invalidate */
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+bool
+redwood_gpu_done(uint32_t fence)
+{
+	if (!ready || mem.va == NULL) {
+		return false;
+	}
+	sweet_dcache_flush((vm_offset_t)mem.va, 64);
+	return (int32_t)(*(volatile uint32_t *)mem.va - fence) >= 0;
+}
+
+uint32_t
+redwood_gpu_last(void)
+{
+	return seqno;
+}
+
+void
+redwood_gpu_worked(uint64_t *microseconds, uint32_t *submissions, uint32_t by[7])
+{
+	*microseconds = 0;
+	*submissions = 0;
+	bzero(by, 7 * sizeof(uint32_t));
+}
+
+/* IBs then CACHE_FLUSH_TS writing the submission's number to mem+0 (TopazGpuW HwSubmit). 0: ring full. */
+uint32_t
+redwood_gpu_submit(const uint64_t *addresses, const uint32_t *words, uint32_t count)
+{
+	if (count > (RB_DWORDS - 6) / 4 ||
+        (count != 0 && (addresses == NULL || words == NULL))) { return 0; }
+    uint32_t need = 4 * count + 5;
+
+	if (!ready) {
+		return 0;
+	}
+	IOLockLock(hw_lock);
+	for (int spin = 0; ring_free() < need && spin < 20000; spin++) {
+		IODelay(100);
+	}
+	if (ring_free() < need) {
+		IOLockUnlock(hw_lock);
+		return 0;
+	}
+	for (uint32_t i = 0; i < count; i++) {
+		emit(pkt7(CP_INDIRECT_BUFFER, 3));
+		emit((uint32_t)addresses[i]);
+		emit((uint32_t)(addresses[i] >> 32));
+		emit(words[i]);
+	}
+	if (++seqno == 0) {
+		seqno = 1;
+	}
+	uint32_t fence = seqno;
+	emit(pkt7(CP_EVENT_WRITE, 4));
+	emit(CACHE_FLUSH_TS);
+	emit((uint32_t)mem.iova);
+	emit((uint32_t)(mem.iova >> 32));
+	emit(fence);
+	kick();
+	IOLockUnlock(hw_lock);
+	return fence;
+}
+
+void
+redwood_gpu_report(const char *why)
+{
+	uint64_t ib1 = gpu_rd(0x928) | ((uint64_t)gpu_rd(0x929) << 32);
+	IOLog("TopazGPU: %s: fence %u done %u rptr %u wptr %u RBBM_STATUS %08x CP_HW_FAULT %08x IB1 %llx rem %u\n", why,
+	    seqno, mem.va ? *(volatile uint32_t *)mem.va : 0, gpu_rd(0x806), wptr % RB_DWORDS, gpu_rd(0x210),
+	    gpu_rd(0x821), ib1, gpu_rd(0x92A));
+	smmu_fault(why);
+}
+
+void
+redwood_gpu_stop(void)
+{
+	if (ready) {
+		gpu_wr(0x808, 0);
+	}
+	ready = false;
+}
+
+void
+redwood_tl(const char *format, ...)
+{
+	char line[192];
+	va_list args;
+	va_start(args, format);
+	int n = vsnprintf(line, sizeof(line), format, args);
+	va_end(args);
+	if (n > 0) { sweet_log_append(line, n < (int)sizeof(line) ? n : (int)sizeof(line) - 1); }
+}
+
+/* A real IB must write a known word, then complete its submission fence.
+ * Keep the buffer alive after a timeout: the GPU may still own it. The IB and
+ * result buffers are reused, so a clock fallback can retest without allocating
+ * or remapping a second buffer the SMMU already knows. */
+static struct kbuf selftest_ib;
+static bool
+citrus_gpu_selftest(void)
+{
+    if (selftest_ib.md == NULL &&
+        (!kbuf_alloc(&selftest_ib, PAGE_SIZE) || !kbuf_map(&selftest_ib))) { return false; }
+    redwood_gpu_mapped(); /* Flush new IB PTEs when gpu_identity=0. */
+    for (uint32_t i = 1; i <= 16; i++) {
+        uint32_t want = 0x610c0000u | i;
+        uint32_t *ib = (uint32_t *)selftest_ib.va;
+        volatile uint32_t *result = (volatile uint32_t *)(mem.va + 64);
+        *result = 0;
+        ib[0] = pkt7(0x3d, 3); /* CP_MEM_WRITE */
+        ib[1] = (uint32_t)(mem.iova + 64);
+        ib[2] = (uint32_t)((mem.iova + 64) >> 32);
+        ib[3] = want;
+        sweet_dcache_clean((vm_offset_t)mem.va, 128);
+        sweet_dcache_clean((vm_offset_t)ib, 16);
+        uint64_t address = selftest_ib.iova;
+        uint32_t words = 4;
+        uint32_t fence = redwood_gpu_submit(&address, &words, 1);
+        if (fence == 0) { return false; }
+        bool done = false;
+        for (unsigned ms = 0; ms < 250; ms++) {
+            if (redwood_gpu_done(fence)) { done = true; break; }
+            IOSleep(1);
+        }
+        sweet_dcache_flush((vm_offset_t)result, 64);
+        if (!done || *result != want) {
+            IOLog("CitrusGPU: selftest %u FAIL fence=%u done=%u got=%08x want=%08x\n",
+                i, fence, done, *result, want);
+            return false;
+        }
+    }
+    IOLog("CitrusGPU: selftest PASS 16 IB writes and fences\n");
+    return true;
+}
+
+/* Translation diagnostic: adjacent GPU virtual pages backed by two separately
+ * owned physical allocations, deliberately ordered so the physical range is
+ * not contiguous. All resources remain wired if the GPU times out. */
+static struct kbuf citrus_smmu_page[2];
+static uint64_t citrus_smmu_va;
+static bool
+citrus_smmu_scatter_test(void)
+{
+    if (gpu_identity) {
+        IOLog("CitrusGPU: scatter test requires gpu_identity=0\n");
+        return false;
+    }
+    for (unsigned i = 0; i < 2; i++) {
+        if (!kbuf_alloc(&citrus_smmu_page[i], PAGE_SIZE)) {
+            IOLog("CitrusGPU: scatter test page allocation failed\n");
+            return false;
+        }
+    }
+    unsigned first = 0, second = 1;
+    if (citrus_smmu_page[1].pa == citrus_smmu_page[0].pa + PAGE_SIZE) {
+        first = 1; second = 0;
+    }
+    uint64_t pa0 = citrus_smmu_page[first].pa, pa1 = citrus_smmu_page[second].pa;
+    if (pa0 == pa1 || pa1 == pa0 + PAGE_SIZE) {
+        IOLog("CitrusGPU: scatter test could not make a discontiguous range\n");
+        return false;
+    }
+    citrus_smmu_va = redwood_gpu_address(2 * PAGE_SIZE);
+    if (!citrus_smmu_va) { return false; }
+    for (unsigned page = 0; page < 2; page++) {
+        uint64_t pa = page == 0 ? pa0 : pa1;
+        for (unsigned off = 0; off < PAGE_SIZE; off += 4096) {
+            if (!redwood_gpu_map(citrus_smmu_va + page * PAGE_SIZE + off, pa + off, false)) {
+                redwood_gpu_unmap(citrus_smmu_va, 2 * PAGE_SIZE);
+                redwood_gpu_address_free(citrus_smmu_va, 2 * PAGE_SIZE);
+                citrus_smmu_va = 0;
+                IOLog("CitrusGPU: scatter test mapping failed\n");
+                return false;
+            }
+        }
+    }
+    redwood_gpu_mapped();
+    volatile uint32_t *out0 = (volatile uint32_t *)citrus_smmu_page[first].va;
+    volatile uint32_t *out1 = (volatile uint32_t *)citrus_smmu_page[second].va;
+    *out0 = *out1 = 0;
+    sweet_dcache_clean((vm_offset_t)out0, 64);
+    sweet_dcache_clean((vm_offset_t)out1, 64);
+    uint32_t *ib = (uint32_t *)selftest_ib.va;
+    for (unsigned i = 0; i < 2; i++) {
+        uint64_t address = citrus_smmu_va + i * PAGE_SIZE;
+        ib[i * 4] = pkt7(0x3d, 3);
+        ib[i * 4 + 1] = (uint32_t)address;
+        ib[i * 4 + 2] = (uint32_t)(address >> 32);
+        ib[i * 4 + 3] = 0x610a1000u + i;
+    }
+    sweet_dcache_clean((vm_offset_t)ib, 32);
+    uint64_t ib_address = selftest_ib.iova;
+    uint32_t words = 8, fence = redwood_gpu_submit(&ib_address, &words, 1);
+    bool done = false;
+    for (unsigned ms = 0; fence && ms < 250; ms++) {
+        if (redwood_gpu_done(fence)) { done = true; break; }
+        IOSleep(1);
+    }
+    sweet_dcache_flush((vm_offset_t)out0, 64);
+    sweet_dcache_flush((vm_offset_t)out1, 64);
+    bool pass = done && *out0 == 0x610a1000u && *out1 == 0x610a1001u;
+    IOLog("CitrusGPU: SMMU scatter %s va=%#llx phys=%#llx,%#llx fence=%u done=%u data=%08x,%08x\n",
+        pass ? "PASS" : "FAIL", citrus_smmu_va, pa0, pa1, fence, done, *out0, *out1);
+    return pass;
+}
+
+/* ---------------------------------------------------------------- start */
+
+static void
+topaz_adreno_thread(__unused void *param, __unused wait_result_t wr_)
+{
+	for (int i = 0; i < 600 && !topaz_root_mounted(); i++) {
+		IOSleep(100);
+	}
+	IOSleep(500);
+	if (!topaz_root_mounted()) {
+		IOLog("TopazGPU: no root filesystem: not started\n");
+		return;
+	}
+    if (probe_only) {
+        /* Map/read GPUCC only: no clock writes, PAS auth, SMMU or CP. */
+        gpucc = (volatile uint8_t *)ml_io_map(GPUCC_BASE, GPUCC_SIZE);
+        if (gpucc == NULL) { IOLog("CitrusGPU: probe map failed\n"); return; }
+        IOLog("CitrusGPU: probe GX=%08x CX=%08x GFX=%08x SMMUCLK=%08x\n",
+            rd(gpucc, 0x100c), rd(gpucc, 0x1540), rd(gpucc, 0x1054), rd(gpucc, 0x5000));
+        uint64_t support = 0;
+        uint64_t rc = scm(SCM_FN(SCM_SVC_PIL, 7), 1, GPU_PAS_ID, 0, 0, &support);
+        IOLog("CitrusGPU: probe PAS13 supported rc=%llx result=%llx; no GPU writes\n", rc, support);
+        return;
+    }
+    if (topaz_fw_zap_mdt_size < 52 || topaz_fw_zap_b02_size == 0 || topaz_fw_sqe_fw_size <= 4) {
+        IOLog("CitrusGPU: device firmware missing; hardware start refused\n");
+        return;
+    }
+    IOLockLock(hw_lock);
+	bool ok = hw_start();
+	IOLockUnlock(hw_lock);
+	if (!ok) {
+		failed = true;
+		IOLog("TopazGPU: THE GPU IS NOT STARTED\n");
+		return;
+	}
+    ready = true;
+    if (!citrus_gpu_selftest()) {
+        bool recovered = false;
+        if (core_mhz != 300) {
+            IOLog("CitrusGPU: selftest failed at %u MHz; reverting to 300 MHz\n", core_mhz);
+            if (gfx_set_mhz(300)) {
+                core_mhz = 300;
+                recovered = citrus_gpu_selftest();
+            }
+        }
+        if (!recovered) {
+            redwood_gpu_report("selftest failed");
+            redwood_gpu_stop();
+            failed = true;
+            return;
+        }
+    }
+    uint32_t scatter_test = 0;
+    (void)PE_parse_boot_argn("citrussmmutest", &scatter_test, sizeof(scatter_test));
+    if (scatter_test && !citrus_smmu_scatter_test()) {
+        redwood_gpu_report("scatter test failed");
+        redwood_gpu_stop();
+        failed = true;
+        return;
+    }
+    RedwoodGPUStart();
+	IOLog("TopazGPU: Adreno 610 ready, RedwoodGPU published\n");
+}
+
+void
+topaz_adreno_init(void)
+{
+	uint32_t on = 0, mhz = 0;
+	thread_t thread;
+
+	(void)PE_parse_boot_argn("gpu", &on, sizeof(on));
+    (void)PE_parse_boot_argn("citrusgpuprobe", &probe_only, sizeof(probe_only));
+    if ((on == 0 && probe_only == 0) || hw_lock != NULL) {
+		return;
+	}
+	(void)PE_parse_boot_argn("gpu_identity", &gpu_identity, sizeof(gpu_identity));
+    (void)PE_parse_boot_argn("citrussmmu39", &citrus_smmu_39, sizeof(citrus_smmu_39));
+    (void)PE_parse_boot_argn("citrussmmudiag", &citrus_smmu_diag, sizeof(citrus_smmu_diag));
+    (void)PE_parse_boot_argn("citrussmmureset", &citrus_smmu_reset, sizeof(citrus_smmu_reset));
+
+    /* GPLL0 is 600 MHz on Bengal. 300 MHz is the conservative bring-up rate;
+     * 600 MHz is the lowest stock rate above it and still needs only
+     * VDD_LOW_L1, below what the boot CPU already asks of CX. 950 MHz is the
+     * fused-bin stock maximum: it programs PLL0 at 1900 MHz and is accepted
+     * only when the Gold cluster was actually raised to its top LUT state
+     * (sweetcpufreq=1), because that OSM state is this boot's only confirmed
+     * source of the CX/MX TURBO_L1 class. There is no independent RPM vote. */
+    int cpu_state = 0;
+    if (PE_parse_boot_argn("gpu_mhz", &mhz, sizeof(mhz))) {
+        if (mhz != 300 && mhz != 600 && mhz != 950) {
+            IOLog("CitrusGPU: gpu_mhz=%u unsupported; use 300, 600 or 950\n", mhz);
+            return;
+        }
+        core_mhz = mhz;
+    }
+
+	/* Report the Gold cluster's advertised range and live perf state on every
+	 * boot; raise it only with sweetcpufreq=1. SweetBattery used to own this
+	 * call but its start() returns before it, so it never ran. The return is
+	 * 1 only when the top state is confirmed after the request. */
+	cpu_state = sweet_cpufreq_max();
+    if (core_mhz == 950 && cpu_state != 1) {
+        IOLog("CitrusGPU: 950 MHz needs a confirmed Gold top state (sweetcpufreq=1); using 600 MHz\n");
+        core_mhz = 600;
+    }
+    IOLog("CitrusGPU: requested gfx3d %u MHz (%s)\n", core_mhz,
+        core_mhz == 950 ? "PLL0 1900/2" : core_mhz == 600 ? "GPLL0/1" : "GPLL0/2");
+
+	if (on != 0) {
+        uint32_t requested_mb = 64;
+        if (PE_parse_boot_argn("gpupoolmb", &requested_mb, sizeof(requested_mb))) {
+            if (requested_mb == 64 || requested_mb == 128) {
+                gpu_pool_requested_mb = requested_mb;
+            } else {
+                IOLog("CitrusGPU: invalid gpupoolmb=%u; using 64 MB\n", requested_mb);
+            }
+        }
+        uint32_t large_arena = 1;
+        if (PE_parse_boot_argn("gpulargearena", &large_arena, sizeof(large_arena))) {
+            gpu_pool_large_arena = large_arena != 0;
+        }
+        IOLog("CitrusGPU: requested GPU pool %u MB, large arena %u\n", gpu_pool_requested_mb, gpu_pool_large_arena);
+		gpu_pool_reserve();
+	}
+	hw_lock = IOLockAlloc();
+    if (hw_lock == NULL) { return; }
+	if (kernel_thread_start(topaz_adreno_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+        IOLockFree(hw_lock);
+        hw_lock = NULL;
+    }
+}
