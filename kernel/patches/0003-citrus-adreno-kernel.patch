+static bool
+poll(volatile uint8_t *b, uint32_t o, uint32_t mask, uint32_t want, uint32_t us)
+{
+	for (uint32_t i = 0; i <= us; i++) {
+		if ((rd(b, o) & mask) == want) {
+			return true;
+		}
+		IODelay(1);
+	}
+	return false;
