+/*
+ * topaz: firmware files for drivers, read from the root filesystem once it
+ * is mounted (the GPU's zap shader and SQE microcode, from the phone's own
+ * /vendor/firmware, installed under /usr/share/firmware/topaz).
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <sys/vnode.h>
+#include <sys/vnode_internal.h>
+#include <sys/kauth.h>
+#include <sys/proc.h>
+#include <sys/uio.h>
+#include <kern/kalloc.h>
+
+int topaz_fw_read(const char *path, void **data, size_t *size);
+void topaz_fw_free(void *data, size_t size);
+int topaz_root_mounted(void);
+
+int
+topaz_root_mounted(void)
+{
+	return rootvnode != NULLVP;
+}
+
+int
+topaz_fw_read(const char *path, void **data, size_t *size)
+{
+	vfs_context_t ctx = vfs_context_kernel();
+	vnode_t vp = NULLVP;
+	off_t len = 0;
+	int resid = 0, err;
+	void *buf;
+
+	*data = NULL;
+	*size = 0;
+	if (rootvnode == NULLVP) {
+		return ENOENT;
+	}
+	err = vnode_open(path, FREAD, 0, 0, &vp, ctx);
+	if (err) {
+		return err;
+	}
+	err = vnode_size(vp, &len, ctx);
+	if (!err && (len <= 0 || len > (16 << 20))) {
+		err = EFBIG;
+	}
+	if (!err) {
+		buf = kalloc_data((vm_size_t)len, Z_WAITOK | Z_ZERO);
+		if (buf == NULL) {
+			err = ENOMEM;
+		} else {
+			err = vn_rdwr(UIO_READ, vp, (caddr_t)buf, (int)len, 0, UIO_SYSSPACE, IO_NODELOCKED,
+			    vfs_context_ucred(ctx), &resid, vfs_context_proc(ctx));
+			if (!err && resid != 0) {
+				err = EIO;
+			}
+			if (err) {
+				kfree_data(buf, (vm_size_t)len);
+			} else {
+				*data = buf;
+				*size = (size_t)len;
+			}
+		}
+	}
+	vnode_close(vp, FREAD, ctx);
+	return err;
+}
+
+void
+topaz_fw_free(void *data, size_t size)
+{
+	if (data != NULL) {
+		kfree_data(data, size);
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
