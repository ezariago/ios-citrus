+static bool
+branch_on(volatile uint8_t *b, uint32_t o, const char *name)
+{
+	rmw(b, o, 0, CBCR_EN);
+	bool ok = poll(b, o, CBCR_OFF, 0, 200);
+	if (!ok) {
+		IOLog("TopazGPU: %s stays off (%08x)\n", name, rd(b, o));
+	}
+	return ok;
+}
