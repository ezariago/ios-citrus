+/*
+ * Citrus: all GPU memory must be owned by XNU. The Topaz fixed pool
+ * (0x90000000..0xd0000000) overlaps our kernel RAM and is forbidden. Instead,
+ * reserve one contiguous XNU-owned block below 4 GiB early (before the page
+ * allocator fragments) and serve RedwoodGPU's large GEM buffers from it.
+ * The small-buffer path still uses its own bounded descriptors; this pool is
+ * the fallback that CoreAnimation needs for ~10 MB command/scratch buffers.
+ */
+#define GPU_POOL_MAX_BLOCKS     256
+#define GPU_POOL_MIN_RESERVE    (16ull << 20)
+#define GPU_POOL_WANT_RESERVE   (64ull << 20)
+
+struct gpu_pool_block {
+    uint64_t base;              /* physical */
+    uint64_t size;
+    bool     used;
+    unsigned arena;
+};
+
+static IOBufferMemoryDescriptor *gpu_pool_md;
+static IOBufferMemoryDescriptor *gpu_pool_md2;
+static uint8_t *gpu_pool_va2;
+static uint64_t gpu_pool_pa2, gpu_pool_size2;
+static uint8_t                  *gpu_pool_va;
+static uint64_t                  gpu_pool_pa;
+static uint64_t                  gpu_pool_total;
+static struct gpu_pool_block     gpu_pool_blocks[GPU_POOL_MAX_BLOCKS];
+static unsigned                  gpu_pool_count;
+static IOLock                   *gpu_pool_lock;
+static bool                      gpu_pool_tried;
+static uint32_t                  gpu_pool_requested_mb = 64;
+/* Keep large buffers out of the small-allocation arena so that 8-10 MB holes
+ * do not fragment the blocks a 10 MB blur/screen surface needs. */
+static uint32_t                  gpu_pool_large_arena = 1;
+#define GPU_POOL_LARGE_MIN (8ull << 20)
+
+static bool
+gpu_pool_reserve(void)
+{
+    const uint64_t want[] = { 64ull << 20, 32ull << 20, 16ull << 20 };
+
+    if (gpu_pool_md != NULL) { return true; }
+    if (gpu_pool_lock == NULL) { gpu_pool_lock = IOLockAlloc(); }
+    if (gpu_pool_lock == NULL) { return false; }
+    IOLockLock(gpu_pool_lock);
+    if (gpu_pool_md == NULL && !gpu_pool_tried) {
+        gpu_pool_tried = true;
+        for (unsigned i = 0; i < sizeof(want) / sizeof(want[0]) && gpu_pool_md == NULL; i++) {
+            IOBufferMemoryDescriptor *md = IOBufferMemoryDescriptor::inTaskWithPhysicalMask(kernel_task,
+                kIODirectionInOut | kIOMemoryKernelUserShared | kIOMemoryPhysicallyContiguous |
+                kIOMapWriteCombineCache, (vm_size_t) want[i], 0x00000000FFFFC000ull);
+            IOByteCount length = 0;
+            addr64_t pa = md != NULL ? md->getPhysicalSegment(0, &length, kIOMemoryMapperNone) : 0;
+            if (md == NULL || pa < 0x80000000ull || pa + want[i] > 0xf0000000ull || length < want[i]) {
+                OSSafeReleaseNULL(md);
+                continue;
+            }
+            gpu_pool_md = md;
+            gpu_pool_pa = pa;
+            gpu_pool_total = want[i];
+            gpu_pool_va = (uint8_t *) md->getBytesNoCopy();
+            gpu_pool_blocks[0].base = pa;
+            gpu_pool_blocks[0].size = want[i];
+            gpu_pool_blocks[0].used = false;
+            gpu_pool_blocks[0].arena = 0;
+            gpu_pool_count = 1;
+            IOLog("CitrusGPU: reserved %llu MB of contiguous GPU pool at %#llx\n",
+                gpu_pool_total >> 20, gpu_pool_pa);
+        }
+        /* Optional second independently owned region: never merge its blocks
+         * with the first, even if the physical ranges happen to be adjacent. */
+        if (gpu_pool_md != NULL && gpu_pool_requested_mb == 128) {
+            for (unsigned i = 0; i < sizeof(want) / sizeof(want[0]); i++) {
+                IOBufferMemoryDescriptor *md = IOBufferMemoryDescriptor::inTaskWithPhysicalMask(kernel_task,
+                    kIODirectionInOut | kIOMemoryKernelUserShared | kIOMemoryPhysicallyContiguous |
+                    kIOMapWriteCombineCache, (vm_size_t)want[i], 0x00000000FFFFC000ull);
+                IOByteCount length = 0;
+                addr64_t pa = md != NULL ? md->getPhysicalSegment(0, &length, kIOMemoryMapperNone) : 0;
+                if (md == NULL || pa < 0x80000000ull || pa + want[i] > 0xf0000000ull || length < want[i]) {
+                    OSSafeReleaseNULL(md);
+                    continue;
+                }
+                gpu_pool_md2 = md;
+                gpu_pool_pa2 = pa;
+                gpu_pool_size2 = want[i];
+                gpu_pool_va2 = (uint8_t *)md->getBytesNoCopy();
+                gpu_pool_blocks[1].base = pa;
+                gpu_pool_blocks[1].size = want[i];
+                gpu_pool_blocks[1].used = false;
+                gpu_pool_blocks[1].arena = 1;
+                gpu_pool_count = 2;
+                IOLog("CitrusGPU: reserved second %llu MB GPU pool at %#llx (total %llu MB)\n",
+                    want[i] >> 20, pa, (gpu_pool_total + want[i]) >> 20);
+                break;
+            }
+            if (gpu_pool_md2 == NULL) { IOLog("CitrusGPU: second GPU pool unavailable\n"); }
+        }
+        if (gpu_pool_md == NULL) {
+            IOLog("CitrusGPU: no contiguous GPU pool of at least %llu MB is available\n",
+                GPU_POOL_MIN_RESERVE >> 20);
+        }
+    }
+    IOLockUnlock(gpu_pool_lock);
+    return gpu_pool_md != NULL;
+}
+
+static uint64_t
+gpu_pool_alloc(uint64_t size, void **va)
+{
+    uint64_t rounded = (size + 0x3fff) & ~0x3fffull;
+    uint64_t address = 0;
+
+    if (va != NULL) { *va = NULL; }
+    if (size == 0) { return 0; }
+    if (!gpu_pool_reserve()) { return 0; }
+    IOLockLock(gpu_pool_lock);
+    unsigned first = 0, second = 0, passes = 1;
+    if (gpu_pool_large_arena && gpu_pool_count > 1) {
+        first = rounded >= GPU_POOL_LARGE_MIN ? 0u : 1u;
+        second = 1u - first;
+        passes = 2;
+    }
+    for (unsigned pass = 0; pass < passes && address == 0; pass++) {
+        unsigned arena = pass == 0 ? first : second;
+        for (unsigned i = 0; i < gpu_pool_count; i++) {
+            struct gpu_pool_block *b = &gpu_pool_blocks[i];
+            if (passes == 2 && b->arena != arena) { continue; }
+            if (b->used || b->size < rounded) { continue; }
+            if (b->size - rounded >= 0x4000 && gpu_pool_count < GPU_POOL_MAX_BLOCKS) {
+                memmove(&gpu_pool_blocks[i + 2], &gpu_pool_blocks[i + 1],
+                    (gpu_pool_count - i - 1) * sizeof(gpu_pool_blocks[0]));
+                gpu_pool_count++;
+                gpu_pool_blocks[i + 1].base = b->base + rounded;
+                gpu_pool_blocks[i + 1].size = b->size - rounded;
+                gpu_pool_blocks[i + 1].used = false;
+                gpu_pool_blocks[i + 1].arena = b->arena;
+                b->size = rounded;
+            }
+            b->used = true;
+            address = b->base;
+            if (va != NULL) { *va = b->arena == 0 ? gpu_pool_va + (address - gpu_pool_pa) : gpu_pool_va2 + (address - gpu_pool_pa2); }
+            break;
+        }
+    }
+    IOLockUnlock(gpu_pool_lock);
+    return address;
+}
+
+/* Snapshot under the allocator lock; rate-limit logging without holding it. */
+extern "C" bool
+citrus_gpu_pool_sample(uint64_t now_ns, bool failed, uint64_t *free_bytes,
+    uint64_t *largest, unsigned *blocks, uint64_t *attempts, uint64_t *failures)
+{
+    static uint64_t last_ns, n_attempts, n_failures;
+    if (gpu_pool_lock == NULL) { return false; }
+    IOLockLock(gpu_pool_lock);
+    n_attempts++;
+    if (failed) { n_failures++; }
+    if (last_ns != 0 && now_ns - last_ns < 5000000000ull) {
+        IOLockUnlock(gpu_pool_lock);
+        return false;
+    }
+    last_ns = now_ns ? now_ns : 1;
+    *free_bytes = *largest = 0;
+    *blocks = gpu_pool_count;
+    for (unsigned i = 0; i < gpu_pool_count; i++) {
+        if (!gpu_pool_blocks[i].used) {
+            uint64_t size = gpu_pool_blocks[i].size;
+            *free_bytes += size;
+            if (size > *largest) { *largest = size; }
+        }
+    }
+    *attempts = n_attempts;
+    *failures = n_failures;
+    IOLockUnlock(gpu_pool_lock);
+    return true;
+}
+
+static void
+gpu_pool_give_back(uint64_t address, uint64_t size)
+{
+    if (gpu_pool_md == NULL) { return; }
+    IOLockLock(gpu_pool_lock);
+    for (unsigned i = 0; i < gpu_pool_count; i++) {
+        struct gpu_pool_block *b = &gpu_pool_blocks[i];
+        if (b->base != address || !b->used) { continue; }
+        b->used = false;
+        /* merge with the next block, then with the previous one */
+        if (i + 1 < gpu_pool_count && !gpu_pool_blocks[i + 1].used && b->arena == gpu_pool_blocks[i + 1].arena &&
+            b->base + b->size == gpu_pool_blocks[i + 1].base) {
+            b->size += gpu_pool_blocks[i + 1].size;
+            memmove(&gpu_pool_blocks[i + 1], &gpu_pool_blocks[i + 2],
+                (gpu_pool_count - i - 2) * sizeof(gpu_pool_blocks[0]));
+            gpu_pool_count--;
+        }
+        if (i > 0 && !gpu_pool_blocks[i - 1].used && b->arena == gpu_pool_blocks[i - 1].arena &&
+            gpu_pool_blocks[i - 1].base + gpu_pool_blocks[i - 1].size == b->base) {
+            gpu_pool_blocks[i - 1].size += b->size;
+            memmove(&gpu_pool_blocks[i], &gpu_pool_blocks[i + 1],
+                (gpu_pool_count - i - 1) * sizeof(gpu_pool_blocks[0]));
+            gpu_pool_count--;
+        }
+        break;
+    }
+    IOLockUnlock(gpu_pool_lock);
+}
