+static void
+citrus_backlight_probe(void)
+{
+    uint32_t probe = 0, control = 0, restore = 0;
+    (void)PE_parse_boot_argn("citrusblprobe", &probe, sizeof(probe));
+    (void)PE_parse_boot_argn("citrusbl", &control, sizeof(control));
+    (void)PE_parse_boot_argn("citrusblrestore", &restore, sizeof(restore));
+    if (!probe && !control && !restore) return;
+    citrus_bl_selected = control != 0;
+    volatile uint32_t *core = (volatile uint32_t *)ml_io_map(0x01c40000, 0x4000);
+    volatile uint32_t *cfg = (volatile uint32_t *)ml_io_map(0x01c08000, 0x4000);
+    volatile uint32_t *obs = (volatile uint32_t *)ml_io_map(0x03e00000, 0x10000);
+    if (!core || !cfg || !obs) { IOLog("CITRUS BL: map failed\n"); return; }
+    uint32_t ver = core[0], count = core[1] & 0x7ff;
+    if (ver < 0x50000000 || ver >= 0x60000000 || !count || count > 512) {
+        IOLog("CITRUS BL: unsupported arb=%#x count=%u\n", ver, count); return;
+    }
+    int apid = -1, owner = -1;
+    for (uint32_t i = 0; i < count; i++) {
+        uint32_t map = core[(0x900 + 4*i)/4];
+        if (map && ((map >> 8) & 0xfff) == 0x1b3) {
+            int o = cfg[(0x2000 + 0x700 + 4*i)/4] & 7;
+            IOLog("CITRUS BL: PPID 1b3 apid=%u owner=%d map=%#x\n", i, o, map);
+            if (apid < 0 || o == 0) { apid = i; owner = o; }
+        }
+    }
+    if (apid < 0) { IOLog("CITRUS BL: no LPG mapping\n"); return; }
+    volatile uint32_t *ch = obs + (0x80 * apid)/4;
+    const uint8_t regs[] = {0x04,0x05,0x41,0x42,0x43,0x44,0x45,0x46,0x47};
+    uint8_t values[sizeof(regs)] = {};
+    bool valid = true;
+    for (unsigned r = 0; r < sizeof(regs); r++) {
+        bool ok = citrus_bl_xfer(ch, false, regs[r], &values[r]);
+        valid &= ok;
+        IOLog("CITRUS BL: reg=%#x value=%#x ok=%d\n", regs[r], values[r], ok);
+    }
+    /* subtype PWM, 9-bit, 19.2 MHz / 4, output enabled; preserve period. */
+    if ((!control && !restore) || !valid || owner != 0 || values[1] != 0x0b ||
+        values[2] != 0x07 || values[3] != 0x02 || !(values[7] & 0x80)) {
+        IOLog("CITRUS BL: control unavailable or disabled\n"); return;
+    }
+    citrus_bl_rw = (volatile uint32_t *)ml_io_map(0x01e00000u + 0x10000u * apid, 0x4000);
+    if (!citrus_bl_rw) return;
+    citrus_bl_obs = ch;
+    if (restore) {
+        uint8_t enable = values[7] & ~0x04u;
+        bool ok = citrus_bl_xfer(citrus_bl_rw, true, 0x46, &enable);
+        IOLog("CITRUS BL: inherited source restore %s\n", ok ? "done" : "FAILED");
+        return;
+    }
+    citrus_bl_enable = values[7];
+    citrus_bl_msb = values[6];
+    citrus_bl_ready = true;
+    IOLog("CITRUS BL: PWM control ready (apid=%d)\n", apid);
+}
+
+/* Called with fBlLock, never from interrupt context. Restore the inherited
+ * source if a transaction fails; a boot with citrusbl=0 performs no writes. */
+static bool
+citrus_bl_level(uint32_t level)
+{
+    if (!citrus_bl_ready) return false;
+    uint32_t duty = (level * 511u + 1023u) / 2047u;
+    if (duty < 1) duty = 1;
+    if (duty > 511) duty = 511;
+    uint8_t hi = (citrus_bl_msb & ~1u) | (duty >> 8);
+    uint8_t lo = duty & 0xff, sync = 1;
+    uint8_t enable = (citrus_bl_enable | 0x84u) & ~0x02u;
+    bool ok = citrus_bl_xfer(citrus_bl_rw, true, 0x45, &hi) &&
+              citrus_bl_xfer(citrus_bl_rw, true, 0x44, &lo) &&
+              citrus_bl_xfer(citrus_bl_rw, true, 0x47, &sync) &&
+              citrus_bl_xfer(citrus_bl_rw, true, 0x46, &enable);
+    uint8_t actual = 0;
+    ok = ok && citrus_bl_xfer(citrus_bl_obs, false, 0x44, &actual) && actual == lo;
+    ok = ok && citrus_bl_xfer(citrus_bl_obs, false, 0x45, &actual) && actual == hi;
+    ok = ok && citrus_bl_xfer(citrus_bl_obs, false, 0x46, &actual) && actual == enable;
+    if (!ok) {
+        uint8_t restore = citrus_bl_enable;
+        (void)citrus_bl_xfer(citrus_bl_rw, true, 0x46, &restore);
+        citrus_bl_ready = false;
+    }
+    IOLog("CITRUS BL: duty=%u %s\n", duty, ok ? "applied" : "FAILED");
+    return ok;
+}
