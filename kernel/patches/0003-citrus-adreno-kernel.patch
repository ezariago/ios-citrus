+extern "C" IOMemoryDescriptor *topaz_gpu_pool_md(uint64_t address, uint64_t size);
+IOMemoryDescriptor *
+topaz_gpu_pool_md(uint64_t address, uint64_t size)
+{
+    uint64_t offset = 0;
+    IOBufferMemoryDescriptor *parent = NULL;
+    bool found = false;
+
+    if (gpu_pool_md == NULL || size == 0) { return NULL; }
+    IOLockLock(gpu_pool_lock);
+    for (unsigned i = 0; i < gpu_pool_count; i++) {
+        struct gpu_pool_block *b = &gpu_pool_blocks[i];
+        if (address >= b->base && address < b->base + b->size && size <= b->base + b->size - address) {
+            parent = b->arena == 0 ? gpu_pool_md : gpu_pool_md2;
+            offset = address - (b->arena == 0 ? gpu_pool_pa : gpu_pool_pa2);
+            found = b->used && parent != NULL;
+            break;
+        }
+    }
+    IOLockUnlock(gpu_pool_lock);
+    return found ? IOSubMemoryDescriptor::withSubRange(parent, offset, size, kIODirectionInOut) : NULL;
+}
+
+static void pool_give_back(uint64_t address, uint64_t size) { gpu_pool_give_back(address, size); }
+
+extern "C" void topaz_gpu_pool_free(uint64_t address, uint64_t size);
+void topaz_gpu_pool_free(uint64_t address, uint64_t size) { gpu_pool_give_back(address, size); }
