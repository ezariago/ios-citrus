<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>com.citrus.gpu-triangle</string>
    <key>ProgramArguments</key><array><string>/citrus/bin/citrus-triangle</string></array>
    <key>RunAtLoad</key><true/>
    <key>KeepAlive</key><false/>
    <!-- No StandardOutPath/StandardErrorPath: launchd refuses /dev/console
         (EACCES) and the triangle opens the console itself. -->
</dict>
</plist>
